<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_survey_home"
    app:startDestination="@id/crsHomeIntentFragment">

    <fragment
        android:id="@+id/surveySurveyListFragment"
        tools:layout="@layout/layout_survey_home"
        android:name="com.olam.digital.crs.fragment.SurveySurveyListFragment"
        android:label="SurveySurveyListFragment" >

        <argument
        android:name="farmerId"
        app:argType="string" />
        <action
            android:id="@+id/action_surveySurveyListFragment_to_crsConsentFragment"
            app:destination="@id/crsConsentFragment" />
        <action
            android:id="@+id/action_surveySurveyListFragment_to_surveyFragment"
            app:destination="@id/surveyFragment" />

    </fragment>
    <fragment
        android:id="@+id/surveyFragment"
        tools:layout="@layout/fragment_survey_crs"
        android:name="com.olam.digital.crs.fragment.SurveyFragment"
        android:label="SurveyFragment" >
        <action
            android:id="@+id/action_surveyFragment_to_crsSuccessFragment"
            app:destination="@id/crsSuccessFragment" />
    </fragment>

    <fragment
        android:id="@+id/surveyHomeFragment"
        tools:layout="@layout/layout_survey_home"
        android:name="com.olam.digital.crs.fragment.SurveyHomeFragment"
        android:label="SurveyHomeFragment" >
        <action
            android:id="@+id/action_surveyHomeFragment_to_surveySurveyListFragment"
            app:destination="@id/surveySurveyListFragment" />
        <action
            android:id="@+id/action_surveyHomeFragment_to_crsCommunityRegisterFragment"
            app:destination="@id/crsCommunityRegisterFragment" />
    </fragment>
    <fragment
        android:id="@+id/crsConsentFragment"
        tools:layout="@layout/layout_crs_consents"
        android:name="com.olam.digital.crs.fragment.CrsConsentFragment"
        android:label="CrsConsentFragment" >
        <action
            android:id="@+id/action_crsConsentFragment_to_surveyFragment"
            app:destination="@id/surveyFragment" />
    </fragment>
    <fragment
        android:id="@+id/crsSuccessFragment"
        tools:layout="@layout/layout_survey_submit_success"
        android:name="com.olam.digital.crs.fragment.CrsSuccessFragment"
        android:label="CrsSuccessFragment" />
    <fragment
        android:id="@+id/crsCommunityRegisterFragment"
        tools:layout="@layout/layout_fragment_add_community_survey"
        android:name="com.olam.digital.crs.fragment.CrsCommunityRegisterFragment"
        android:label="CrsCommunityRegisterFragment" />
    <fragment
        android:id="@+id/crsHomeIntentFragment"
        tools:layout="@layout/layout_fragment_home_crs_select"
        android:name="com.olam.digital.crs.fragment.CrsHomeIntentFragment"
        android:label="CrsHomeIntentFragment" >
        <action
            android:id="@+id/action_crsHomeIntentFragment_to_crsProfileFragment"
            app:destination="@id/crsProfileFragment" />
        <action
            android:id="@+id/action_crsHomeIntentFragment_to_surveyHomeFragment"
            app:destination="@id/surveyHomeFragment" />
    </fragment>
    <fragment
        android:id="@+id/crsProfileFragment"
        tools:layout="@layout/layout_fragment_crs_profile"
        android:name="com.olam.digital.crs.fragment.CrsProfileFragment"
        android:label="CrsProfileFragment" >
        <action
            android:id="@+id/action_crsProfileFragment_to_surveyHomeFragment"
            app:destination="@id/surveyHomeFragment" />
    </fragment>
</navigation>