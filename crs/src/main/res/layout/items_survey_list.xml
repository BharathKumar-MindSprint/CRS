<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:background="@drawable/rounded_corners_for_shapes"
        android:layout_margin="@dimen/margin_4"
        android:layout_height="wrap_content">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_8"
            tools:text="Farm Assessment Survey 2024"
            android:id="@+id/txtSurveyName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/regular_large_tv"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_4"
            tools:text="General farm assessment and practices evaluation"
            android:id="@+id/txtSurveyDesc"
            android:textColor="#4A5565"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtSurveyName"
            style="@style/regular_medium_tv"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_4"
            tools:text="25 questions"
            android:textColor="#6A7282"
            android:layout_marginBottom="@dimen/margin_8"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/txtNoOfQuestions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtSurveyDesc"
            style="@style/regular_small_tv"
            />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/ic_vector_right_orange"
            android:layout_marginTop="@dimen/margin_4"
            android:layout_marginEnd="@dimen/margin_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/colorGray" />



        <RelativeLayout
            app:layout_constraintLeft_toRightOf="@+id/txtNoOfQuestions"
           app:layout_constraintTop_toBottomOf="@+id/txtSurveyDesc"
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/margin_4"
            android:id="@+id/layDisplayStatus"
            android:background="@drawable/bg_fill_green_color"
            android:layout_marginStart="@dimen/margin_4"
            android:layout_height="wrap_content"
            >


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="active"
                android:textColor="#016630"
                android:layout_marginStart="@dimen/margin_2"
                android:layout_marginEnd="@dimen/margin_2"
                android:layout_centerInParent="true"
                android:id="@+id/txtActiveState"
                style="@style/regular_small_tv"
                />



        </RelativeLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>