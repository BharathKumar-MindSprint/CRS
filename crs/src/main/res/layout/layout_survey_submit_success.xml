<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="showShimmer"
            type="boolean" />

        <variable
            name="regSucess"
            type="boolean" />

    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorWhitey"
        android:orientation="vertical">


        <LinearLayout
            android:layout_centerInParent="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility='@{showShimmer?View.VISIBLE:View.GONE,default=visible}'
            tools:visibility="gone">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_checked_register_sucess" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="@dimen/width_200"
                        android:layout_height="@dimen/header_16"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="@dimen/margin_16"
                        android:layout_marginTop="@dimen/margin_4"
                        android:layout_marginEnd="@dimen/margin_16"
                        android:background="@color/shimmerColor"
                        android:textSize="12sp"
                        android:textStyle="italic" />


                    <TextView
                        android:layout_width="@dimen/width_200"
                        android:layout_height="@dimen/height_8"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="@dimen/margin_16"
                        android:layout_marginTop="@dimen/margin_4"
                        android:layout_marginEnd="@dimen/margin_16"
                        android:background="@color/shimmerColor"
                        android:textSize="12sp"
                        android:textStyle="italic" />

                    <TextView
                        android:layout_width="@dimen/height_120"
                        android:layout_height="@dimen/height_8"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="@dimen/margin_16"
                        android:layout_marginTop="@dimen/margin_8"
                        android:layout_marginEnd="@dimen/margin_16"
                        android:background="@color/shimmerColor"
                        android:textSize="12sp"
                        android:textStyle="italic" />

                    <TextView
                        android:layout_width="@dimen/width_164"
                        android:layout_height="@dimen/height_16"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="@dimen/margin_16"
                        android:layout_marginTop="@dimen/height_42"
                        android:layout_marginEnd="@dimen/margin_16"
                        android:background="@color/shimmerColor"
                        android:textSize="12sp"
                        android:textStyle="italic" />

                    <TextView
                        android:layout_width="@dimen/width_200"
                        android:layout_height="@dimen/height_36"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="@dimen/margin_16"
                        android:layout_marginTop="@dimen/height_20"
                        android:layout_marginEnd="@dimen/margin_16"
                        android:background="@color/shimmerColor"
                        android:textSize="12sp"
                        android:textStyle="italic" />


                    <TextView
                        android:layout_width="@dimen/width_250"
                        android:layout_height="@dimen/height_24dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="@dimen/margin_16"
                        android:layout_marginTop="@dimen/height_94"
                        android:layout_marginEnd="@dimen/margin_16"
                        android:background="@color/shimmerColor"
                        android:textSize="12sp"
                        android:textStyle="italic" />


                    <TextView
                        android:layout_width="@dimen/width_325"
                        android:layout_height="@dimen/height_16"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="@dimen/margin_16"
                        android:layout_marginTop="@dimen/margin_4"
                        android:layout_marginEnd="@dimen/margin_16"
                        android:background="@color/shimmerColor"
                        android:textSize="12sp"
                        android:textStyle="italic" />


                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_centerInParent="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility='@{!showShimmer?View.VISIBLE:View.GONE,default=gone}'
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility='@{regSucess?View.VISIBLE:View.GONE,default=gone}'>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/margin_40"
                    android:src="@drawable/ic_succes_icon" />


                <TextView
                    style="@style/semibold_dark_gray_XX_large_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/margin_8"
                    android:text="@string/survey_submitted_successfully" />

                <TextView
                    android:id="@+id/txtFamerName"
                    style="@style/regular_medium_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:lineSpacingExtra="4sp"
                    android:textAlignment="center"
                    tools:text="Thank you for completing the survey. Your \n response has been recorded" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_8"
                android:orientation="vertical"
                android:visibility='@{!regSucess?View.VISIBLE:View.GONE,default=visible}'>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/ic_alert_vector" />


                <TextView
                    style="@style/semibold_dark_gray_XX_large_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/reg_failed" />

                <TextView
                    style="@style/regular_medium_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:lineSpacingExtra="4sp"
                    android:text="@string/reg_failed_desc"
                    android:textAlignment="center" />

            </LinearLayout>


            <androidx.cardview.widget.CardView
                android:id="@+id/lay_full_screen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_16"
                app:cardCornerRadius="@dimen/margin_4"
                app:cardElevation=".1in">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtFarmerNameExpand"
                        style="@style/regular_large_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_16"
                        android:layout_marginTop="@dimen/margin_12"
                        android:text="Submission Details"
                        android:textColor="#101828" />


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/margin_16">

                        <!-- Left label -->
                        <TextView
                            android:id="@+id/tvLabelSurveyName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/survey_name"
                            style="@style/regular_lite_gray_small_tv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/tvSurveyId" />

                        <!-- Right value -->
                        <TextView
                            android:id="@+id/tvSurveyId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="SRV001"
                            style="@style/regular_medium_tv"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBaseline_toBaselineOf="@+id/tvLabelSurveyName" />

                        <!-- Next row -->
                        <TextView
                            android:id="@+id/tvLabelFarmerId"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_6"
                            android:text="@string/farmer_id"
                            style="@style/regular_lite_gray_small_tv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvLabelSurveyName"
                            app:layout_constraintEnd_toStartOf="@+id/tvFarmerId" />

                        <TextView
                            android:id="@+id/tvFarmerId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="F001"
                            android:layout_marginTop="@dimen/margin_6"
                            style="@style/regular_medium_tv"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBaseline_toBaselineOf="@+id/tvLabelFarmerId" />

                        <!-- Submitted row -->
                        <TextView
                            android:id="@+id/tvLabelSubmitted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_6"
                            android:text="@string/submitted"
                            style="@style/regular_lite_gray_small_tv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvLabelFarmerId"
                            app:layout_constraintEnd_toStartOf="@+id/tvSubmittedDate" />

                        <TextView
                            android:id="@+id/tvSubmittedDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="12/10/2025, 2:31:03 PM"
                            style="@style/regular_medium_tv"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBaseline_toBaselineOf="@+id/tvLabelSubmitted" />

                        <!-- Status row -->
                        <TextView
                            android:id="@+id/tvLabelStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/status"
                            style="@style/regular_lite_gray_small_tv"
                            android:layout_marginTop="@dimen/margin_6"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvLabelSubmitted"
                            app:layout_constraintEnd_toStartOf="@+id/layStatus" />

                        <!-- Status badge -->
                        <RelativeLayout
                            android:id="@+id/layStatus"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="@dimen/margin_6"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_fill_green_color"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBaseline_toBaselineOf="@+id/tvLabelStatus">

                            <TextView
                                android:id="@+id/tvStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/completed"
                                android:textColor="#016630"
                                android:padding="@dimen/margin_4"
                                style="@style/regular_small_tv" />

                        </RelativeLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>


                </LinearLayout>


            </androidx.cardview.widget.CardView>


            <RelativeLayout
                android:id="@+id/laybacktohome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_28"
                android:layout_marginEnd="@dimen/margin_16"
                android:background="@drawable/ic_drawable_blue_edge">


                <TextView
                    style="@style/regular_medium_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="@dimen/margin_6"
                    android:layout_marginTop="@dimen/margin_12"
                    android:layout_marginEnd="@dimen/margin_6"
                    android:layout_marginBottom="@dimen/margin_6"
                    android:lineSpacingExtra="5sp"
                    android:text="@string/your_survey_data_has_been_securely_stored_and_will_be_used_for_agricultural_research_and_development_purposes"
                    android:textColor="#193CB8" />


            </RelativeLayout>


        </LinearLayout>

        <RelativeLayout
            android:id="@+id/layFilter"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_40"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_8"
            android:layout_marginEnd="@dimen/margin_16"
            android:layout_marginBottom="@dimen/height_48"
            android:background="@drawable/rounded_primary_fully_edge">

            <TextView
                style="@style/medium_white_medium_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/back_to_home" />


        </RelativeLayout>
    </RelativeLayout>
</layout>