<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="@dimen/margin_4"
        android:layout_marginStart="@dimen/margin_16"
        android:layout_marginEnd="@dimen/margin_16"
        android:background="@drawable/editext_cursor_round_sharp_edge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvTitle"
            android:textStyle="bold"
            android:textSize="16sp"
            style="@style/medium_dark_gray_medium_tv"
            tools:text="1) Lorem ipsum dolor sit amet, consectetur adipiscing elit?"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvHelp"
            android:textColor="#666666"
            style="@style/regular_small_tv"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnUpload"
                android:text="@string/upload_photo"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@color/white"
                android:drawablePadding="@dimen/padding_8"
                android:drawableTint="@color/white"
                android:drawableStart="@drawable/ic_edit_sign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnClearPhoto"
                android:text="@string/clear"
                android:layout_marginStart="12dp"
                android:visibility="gone"
                android:textColor="@color/white"
                android:backgroundTint="@color/colorLightRed"
                tools:visibility="visible"
                android:drawablePadding="@dimen/padding_8"
                android:drawableTint="@color/white"
                android:drawableStart="@drawable/ic_delete_red_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/margin_6"
            android:layout_marginBottom="@dimen/margin_6"
            android:layout_height="@dimen/width_05"
            android:background="@color/gray_view_bg"
            />


        <ImageView
            android:id="@+id/ivPreview"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_120"
            tools:visibility="visible"
            android:contentDescription="@string/photo_preview"
            android:background="#EEEEEE"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvError"
            android:textColor="#D32F2F"
            style="@style/regular_small_tv"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</layout>