<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".fragment.SurveyHomeFragment">

    <data>

        <import type="android.view.View" />

        <import type="com.olam.digital.crs.model.ShowRecycler"/>

        <variable
            name="showQuickAdd"
            type="boolean" />


        <variable
            name="action"
            type="com.olam.digital.crs.model.ShowRecycler" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/mTopView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_16"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_back_ios" />

            <LinearLayout
                android:id="@+id/layOne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/margin_6"
                android:layout_marginTop="@dimen/margin_16"
                android:layout_toEndOf="@+id/imgBack"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTop"
                    style="@style/medium_dark_gray_large_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/selectresponents"
                    android:textColor="@android:color/white" />


                <TextView
                    style="@style/medium_white_medium_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_2"
                    android:text="@string/choose_farmer_for_survey" />

            </LinearLayout>


            <RelativeLayout
                android:id="@+id/laylast"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_36"
                android:layout_below="@id/layOne"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_12"
                android:layout_marginEnd="@dimen/margin_12"
                android:background="@drawable/drawable_white_bg"
                android:visibility="@{showQuickAdd ? View.VISIBLE : View.GONE}">

                <TextView
                    style="@style/medium_black_medium_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:drawableStart="@drawable/ic_add_user_icon"
                    android:drawablePadding="@dimen/padding_5"
                    android:text="Quick Add Respondent"
                    android:textColor="@color/colorPrimary" />

            </RelativeLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/laylast"
                android:layout_marginTop="@dimen/margin_12" />

        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8">


            <EditText
                android:id="@+id/edtSearch"
                style="@style/edittext2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_36"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginEnd="@dimen/margin_16"
                android:drawableStart="@drawable/ic_search_icon"
                android:drawablePadding="@dimen/padding_5"
                android:hint="@string/search_survey"
                android:padding="@dimen/padding_4" />

        </RelativeLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/margin_8"
            android:background="@color/colorgraydisable" />


        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility='@{(action==ShowRecycler.SHOW_SHIMMER)?View.VISIBLE:View.GONE,default=visible}'
            app:layout_constraintTop_toBottomOf="@id/mainLay"
            app:layout_constraintBottom_toTopOf="@id/mBottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:shimmer_auto_start="true">
            <include layout="@layout/shimmer_layout_for_survey"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                />

        </com.facebook.shimmer.ShimmerFrameLayout>




        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mRecylerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_marginEnd="@dimen/margin_16"
            android:clipToPadding="false"
            android:fitsSystemWindows="true"
            android:paddingBottom="@dimen/bottom_nav_padding"
            android:visibility='@{(action==ShowRecycler.SHOW_FIRST_RECYLCERVIEW)?View.VISIBLE:View.GONE,default=gone}'
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="12"
            tools:listitem="@layout/items_survey_list"
            tools:visibility="gone" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            android:visibility='@{!(action==ShowRecycler.SHOW_SECOND_RECYLCERVIEW)?View.VISIBLE:View.GONE,default=gone}'
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    style="@style/regular_large_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_16"
                    android:layout_marginTop="@dimen/margin_12"
                    android:drawablePadding="@dimen/padding_5"
                    android:text="@string/newly_registered"
                    app:drawableStartCompat="@drawable/ic_new_registered_crs" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mNewRegisteredRecylerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_16"
                    android:layout_marginTop="@dimen/margin_4"
                    android:layout_marginEnd="@dimen/margin_16"
                    android:clipToPadding="false"
                    android:fitsSystemWindows="true"
                    android:paddingBottom="@dimen/bottom_nav_padding"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/items_survey_list" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_16"
                    android:layout_marginTop="@dimen/margin_8"
                    android:layout_marginEnd="@dimen/margin_16">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_centerInParent="true"
                        android:background="@color/colorgraydisable" />

                    <TextView
                        style="@style/regular_large_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_marginStart="@dimen/margin_4"
                        android:layout_marginEnd="@dimen/margin_4"
                        android:background="@color/white"
                        android:text="@string/existing_users" />
                </RelativeLayout>


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mExitingRecylerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_16"
                    android:layout_marginTop="@dimen/margin_4"
                    android:layout_marginEnd="@dimen/margin_16"
                    android:clipToPadding="false"
                    android:fitsSystemWindows="true"
                    android:paddingBottom="@dimen/bottom_nav_padding"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="6"
                    tools:listitem="@layout/items_survey_list" />


            </LinearLayout>

        </androidx.core.widget.NestedScrollView>


    </LinearLayout>
</layout>