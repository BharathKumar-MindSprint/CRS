<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/layFilter"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimary">

                <ImageView
                    android:id="@+id/imgBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="@dimen/margin_16"
                    android:layout_marginTop="@dimen/margin_16"
                    android:src="@drawable/ic_back_ios" />

                <LinearLayout
                    android:id="@+id/layOne"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_6"
                    android:layout_marginTop="@dimen/margin_16"
                    android:layout_toEndOf="@+id/imgBack"
                    android:orientation="vertical">

                    <TextView
                        style="@style/regular_large_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/revoke_survey"
                        android:textColor="@android:color/white" />


                    <TextView
                        style="@style/regular_white_medium_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_2"
                        android:layout_marginBottom="@dimen/margin_12"
                        android:text="@string/withdraw_survey_participation" />

                </LinearLayout>

            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/laybacktohome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_12"
                android:layout_marginEnd="@dimen/margin_16"
                android:background="@drawable/ic_vector_yellow_edge">


                <TextView
                    style="@style/regular_medium_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="@dimen/margin_6"
                    android:layout_marginTop="@dimen/margin_12"
                    android:layout_marginEnd="@dimen/margin_6"
                    android:layout_marginBottom="@dimen/margin_6"
                    android:drawableStart="@drawable/ic_alet_vector"
                    android:drawablePadding="@dimen/padding_4"
                    android:lineSpacingExtra="5sp"
                    android:text="@string/revoking_consent_will_remove_all_survey_data_associated_with_this_submission_nthis_action_cannot_be_undone"
                    android:textColor="#973C00" />


            </RelativeLayout>




            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:background="@drawable/editext_cursor_round_sharp_edge"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginEnd="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_12"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_12"
                    android:layout_marginEnd="@dimen/margin_12"
                    android:layout_marginTop="@dimen/margin_18"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/medium_black_medium_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/_1_select_user" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4"
                    android:layout_marginStart="@dimen/margin_12"
                    android:layout_marginEnd="@dimen/margin_12"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:background="@color/disableGray"
                    android:weightSum="2">

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:background="@drawable/editext_cursor_round_sharp_edge">

                        <EditText
                            android:id="@+id/etProduct"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/height_36"
                            android:layout_marginEnd="@dimen/margin_2"
                            android:layout_marginTop="@dimen/margin_2"
                            android:layout_marginStart="@dimen/margin_8"
                            android:layout_marginBottom="@dimen/margin_2"
                            android:drawableEnd="@drawable/spinner_draw"
                            android:background="@null"
                            android:drawableTint="#717182"
                            android:clickable="false"
                            android:drawablePadding="@dimen/padding_6"
                            android:focusable="false"
                            android:hint="@string/choose_a_user"
                            android:importantForAutofill="no"
                            android:inputType="none"
                            android:padding="1dp"
                            android:singleLine="true"
                            android:textSize="@dimen/txt_size_14" />


                    </RelativeLayout>


                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_12"
                    android:layout_marginEnd="@dimen/margin_12"
                    android:layout_marginTop="@dimen/margin_18"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/medium_black_medium_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/_2_select_survey" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4"
                    android:layout_marginStart="@dimen/margin_12"
                    android:layout_marginEnd="@dimen/margin_12"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:background="@color/disableGray"
                    android:weightSum="2">

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:background="@drawable/editext_cursor_round_sharp_edge">

                        <EditText
                            android:id="@+id/etChooseSurvey"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/height_36"
                            android:layout_marginEnd="@dimen/margin_2"
                            android:layout_marginTop="@dimen/margin_2"
                            android:layout_marginStart="@dimen/margin_8"
                            android:layout_marginBottom="@dimen/margin_2"
                            android:drawableEnd="@drawable/spinner_draw"
                            android:background="@null"
                            android:drawableTint="#717182"
                            android:clickable="false"
                            android:drawablePadding="@dimen/padding_6"
                            android:focusable="false"
                            android:hint="@string/choose_a_user"
                            android:importantForAutofill="no"
                            android:inputType="none"
                            android:padding="1dp"
                            android:singleLine="true"
                            android:textSize="@dimen/txt_size_14" />


                    </RelativeLayout>


                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_12"
                    android:layout_marginEnd="@dimen/margin_12"
                    android:layout_marginTop="@dimen/margin_18"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/medium_black_medium_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/_3_list_to_select" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4"
                    android:layout_marginStart="@dimen/margin_12"
                    android:layout_marginEnd="@dimen/margin_12"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:background="@color/disableGray"
                    android:weightSum="2">

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:background="@drawable/editext_cursor_round_sharp_edge">

                        <EditText
                            android:id="@+id/etFilterList"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/height_36"
                            android:layout_marginEnd="@dimen/margin_2"
                            android:layout_marginTop="@dimen/margin_2"
                            android:layout_marginStart="@dimen/margin_8"
                            android:layout_marginBottom="@dimen/margin_2"
                            android:drawableEnd="@drawable/spinner_draw"
                            android:background="@null"
                            android:drawableTint="#717182"
                            android:clickable="false"
                            android:drawablePadding="@dimen/padding_6"
                            android:focusable="false"
                            android:hint="@string/choose_from_filtered_list"
                            android:importantForAutofill="no"
                            android:inputType="none"
                            android:padding="1dp"
                            android:singleLine="true"
                            android:textSize="@dimen/txt_size_14" />


                    </RelativeLayout>


                </LinearLayout>



                <TextView
                    style="@style/regular_lite_gray_small_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="@dimen/margin_8"
                    android:layout_marginStart="@dimen/margin_12"
                    android:text="@string/records_found"
                    tools:text="3 records found" />

            </LinearLayout>


        </LinearLayout>

        <RelativeLayout
            android:id="@+id/layFilter"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_40"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_8"
            android:layout_marginEnd="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_16"
            android:background="@drawable/rounded_primary_fully_edge">

            <TextView
                style="@style/medium_white_medium_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Back to Home" />


        </RelativeLayout>
    </RelativeLayout>
</layout>