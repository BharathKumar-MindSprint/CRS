<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="@dimen/margin_4"
        android:layout_marginStart="@dimen/margin_16"
        android:layout_marginEnd="@dimen/margin_16"
        android:background="@drawable/editext_cursor_round_sharp_edge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/medium_dark_gray_medium_tv"
            android:textStyle="bold"
            android:lineSpacingExtra="@dimen/_6sdp"
            tools:text="1)Lorem ipsum dolor sit amet, consectetur adipiscing elit?"
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvHelp"
            android:textColor="#666666"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnCaptureLocation"
                android:text="@string/capture_location"
                android:textColor="@color/white"
                android:backgroundTint="@color/colorPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnClearLocation"
                android:text="@string/clear"
                android:layout_marginStart="12dp"
                tools:visibility="visible"
                android:backgroundTint="@color/colorLightRed"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/width_05"
            android:background="@color/gray_view_bg"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="@dimen/margin_6"
            />

        <TextView
            android:id="@+id/tvLocationStatus"
            android:text="@string/no_location_captured"
            android:textColor="#333333"
            android:layout_marginTop="8dp"
            android:drawablePadding="@dimen/padding_5"
            android:drawableTint="@color/black"
            android:drawableStart="@drawable/ic_marker_location"
            style="@style/regular_medium_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvError"
            android:textColor="#D32F2F"
            style="@style/regular_small_tv"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</layout>
