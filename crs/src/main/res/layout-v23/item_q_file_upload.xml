<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_4"
        android:layout_marginStart="@dimen/margin_16"
        android:layout_marginEnd="@dimen/margin_16"
        android:background="@drawable/editext_cursor_round_sharp_edge"
        android:padding="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Question Title -->
            <TextView
                android:layout_height="wrap_content"
                android:id="@+id/txtQuestion"
                android:layout_width="0dp"
                android:textColor="#222"
                android:textSize="16sp"
                android:lineSpacingExtra="6sp"
                android:textStyle="bold"
                style="@style/medium_dark_gray_medium_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="1) Lorem ipsum dolor sit amet, consectetur adipiscing elit?" />

            <!-- Optional Description -->
            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/supported_formats_jpg_png_pdf_max_5mb"
                android:textColor="#6C757D"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtQuestion" />

            <!-- Upload Button -->
            <Button
                android:id="@+id/btnUpload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:drawableTint="@color/white"
                android:drawableStart="@drawable/ic_edit_sign"
                android:text="@string/choose_file"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/colorPrimary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtDescription" />

            <!-- File Preview Container -->
            <LinearLayout
                android:id="@+id/layFilePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/editext_cursor_round_sharp_edge"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:padding="12dp"
                tools:visibility="visible"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnUpload">

                <!-- Icon -->
                <ImageView
                    android:id="@+id/imgFileType"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_file_plus" />

                <!-- File Name -->
                <TextView
                    android:id="@+id/txtFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    tools:text="Filename_document.pdf"
                    style="@style/medium_dark_small_tv"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/uploaded_document_pdf"
                    android:textColor="#333"
                    android:textStyle="bold"
                    app:layout_constraintWidth_default="wrap" />

                <!-- Remove Button -->
                <ImageView
                    android:id="@+id/imgRemove"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_delete_red_icon" />
            </LinearLayout>

            <!-- Error Text -->
            <TextView
                android:id="@+id/txtError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/invalid_file_format"
                android:textColor="@color/red"
                android:textSize="12sp"
                tools:visibility="visible"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layFilePreview" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</layout>