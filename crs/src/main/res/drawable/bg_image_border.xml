<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Light background so the image looks elevated -->
    <solid android:color="#F8F8F8"/>

    <!-- Border around the image -->
    <stroke
        android:width="1dp"
        android:color="#D0D0D0" />

    <!-- Rounded corners -->
    <corners android:radius="8dp"/>

    <!-- Padding (optional, remove if image must fill entire border) -->
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />

</shape>