<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ofis_page_background"
    tools:context="com.olam.digital.ofis.SettingsActivity"
    tools:ignore="Overdraw">

    <LinearLayout
        android:id="@+id/middleSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:orientation="vertical"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pageTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/Enumerator_ID"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_large_text" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/margin_10"
            android:orientation="vertical">

            <EditText
                android:id="@+id/enumeratorID"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/edittext_bg_dark"
                android:padding="@dimen/margin_10"
                android:hint="@string/Enumerator_ID"
                android:inputType="number"
                android:textColor="@color/ofis_base_font_dark"
                android:textColorHint="@color/icon_grey_palette_2"
                android:textSize="@dimen/ofis_input_field_text" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/middleSection">

        <LinearLayout
            android:id="@+id/bottomSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin">

            <Button
                android:id="@+id/buttonSave"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ofis_large_pad"
                android:background="@color/ofis_action_button_background"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:text="@string/ofis_first_run_save_update"
                android:textColor="@color/ofis_base_font_white" />

            <Button
                android:id="@+id/buttonAssistance"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_primary_outlines"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:text="@string/ofis_request_help"
                android:textColor="@color/btnColorPrimary" />

            <Button
                android:id="@+id/buttonPrivacyConsent"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ofis_large_pad"
                android:layout_marginTop="@dimen/margin_10"
                android:background="@color/btnColorThird"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:text="@string/view_privacy_consent"
                android:textColor="@color/ofis_base_font_white" />

            <Button
                android:visibility="gone"
                android:id="@+id/buttonDeactivate"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:background="@color/ofis_btn_danger"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_marginTop="15dp"
                android:text="@string/deactivate_license_setting"
                android:textColor="@color/ofis_base_font_white" />

            <Button
                android:id="@+id/buttonActivate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/ofis_action_button_background"
                android:padding="15dp"
                android:visibility="gone"
                android:layout_margin="@dimen/margin_10"
                android:text="Activate License"
                android:textColor="@color/ofis_base_font_white" />

            <TextView
                android:visibility="gone"
                android:id="@+id/licenseStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/ofis_large_text"
                android:gravity="right"
                android:textColor="@color/gray"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="@dimen/ofis_consent_statement_subrow_left_margin"
                android:text="Biometric License: Active (OR) Deactive"/>

        </LinearLayout>

    </ScrollView>
    <!-- updated -->
    <LinearLayout
        android:id="@+id/helpRequestHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/ofis_input_field_bottom_margin"
        android:background="@drawable/background_popup"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:paddingLeft="@dimen/ofis_bottom_section_padding_vertical"
            android:paddingTop="10dp"
            android:weightSum="10">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start|top"
                android:layout_weight="9"
                android:text="@string/ofis_request_help"
                android:textSize="@dimen/ofis_med_text"
                android:textColor="@color/ofis_base_font_dark"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/helpCloseButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|top"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/ofis_switch_text_no"
                android:scaleType="fitStart"
                app:srcCompat="@drawable/ic_close_info"
                tools:ignore="VectorDrawableCompat" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:paddingLeft="@dimen/ofis_bottom_section_padding_horizontal"
                android:paddingRight="@dimen/ofis_bottom_section_padding_horizontal"
                android:paddingTop="10dp">

                <EditText
                    android:id="@+id/UserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                    android:hint="@string/Your_Name"
                    android:background="@drawable/edittext_bg_light"
                    android:padding="@dimen/margin_10"
                    android:inputType="textCapWords"
                    android:textColor="@color/ofis_text_field"
                    android:textColorHint="@color/icon_grey_palette_2"
                    android:textSize="@dimen/ofis_input_field_text" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <!--<android.support.v7.widget.AppCompatSpinner
                        android:id="@+id/spinner_country"
                        android:layout_toRightOf="@+id/icon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="4"
                        android:textColor="@color/ofis_base_font_dark"
                        android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"

                        style="@style/AppTheme"
                          >
                    </android.support.v7.widget.AppCompatSpinner>
-->                    <Spinner
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/spinner_country"
                    android:hint="@string/Country"
                    android:layout_weight="4"
                    android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                    android:textColor="@color/ofis_base_font_dark"
                    android:background="@drawable/spinner_bg_light" />

                    <EditText
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="6"
                        android:id="@+id/UserPhoneNo"
                        android:textColor="@color/ofis_text_field"
                        android:background="@drawable/edittext_bg_light"
                        android:padding="@dimen/margin_10"
                        android:textColorHint="@color/icon_grey_palette_2"
                        android:digits="0123456789"
                        android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                        android:hint="@string/Your_phone_number"
                        android:layout_marginLeft="@dimen/ofis_small_pad"
                        android:textSize="@dimen/ofis_input_field_text"
                        android:inputType="phone"/>

                </LinearLayout>

                <EditText
                    android:id="@+id/FaultDescription"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ofis_multiline_help_height"
                    android:layout_gravity="start"
                    android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                    android:background="@drawable/edittext_bg_light"
                    android:padding="@dimen/margin_10"
                    android:hint="@string/problem_description"
                    android:inputType="textMultiLine"
                    android:textColor="@color/ofis_text_field"
                    android:textColorHint="@color/icon_grey_palette_2"
                    android:textSize="@dimen/ofis_input_field_text" />

                <Button
                    android:id="@+id/buttonAssistanceSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginLeft="10dp"
                    android:layout_marginStart="10dp"
                    android:background="@color/ofis_action_button_background"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:text="@string/send_button"
                    android:textColor="@color/ofis_base_font_white" />
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</RelativeLayout>
