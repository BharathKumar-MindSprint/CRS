<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/Attendee_layout"
        android:orientation="horizontal"
        android:weightSum="1"
        android:paddingLeft="@dimen/margin_10"
        android:paddingRight="@dimen/margin_10"
        android:layout_marginTop="@dimen/margin_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lblAttendee"
            android:layout_width="match_parent"
            android:layout_weight="0.1"
            android:text="Attendee"
            android:textStyle="bold"
            android:layout_gravity="center_vertical|center_horizontal"
            android:textColor="@color/black_attendee"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/btndeleteAttendee"
            android:layout_width="match_parent"
            android:layout_weight="0.9"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete_item"
            android:layout_gravity="center_vertical|center_horizontal"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/traineeNameContainer"
        android:orientation="vertical"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_marginRight="@dimen/margin_10"
        android:layout_marginTop="@dimen/margin_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lblTraineeName"
            android:layout_width="match_parent"
            android:text="@string/attendee_name1"
            android:textStyle="bold"
            android:textColor="@color/ofis_base_font_dark"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/etTraineeName"
            android:layout_width="match_parent"
            android:hint="@string/attendee_name_hint"
            android:inputType="textCapWords"
            android:textSize="13sp"
            android:paddingLeft="4dp"
            android:layout_marginTop="5dp"
            android:textColor="@color/text_label_attendee"
            android:textColorHint="@color/icon_grey_palette_2"
            android:background="@drawable/edittext_bg_light"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/traineeRelationshipContainer"
        android:orientation="vertical"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_marginRight="@dimen/margin_10"
        android:layout_marginTop="@dimen/margin_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lblTraineeRelationship"
            android:layout_width="match_parent"
            android:text="@string/attendee_relationship1"
            android:textStyle="bold"
            android:textColor="@color/ofis_base_font_dark"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/spinnerRelationship"
            android:layout_width="match_parent"
            android:layout_marginTop="5dp"
            android:entries="@array/Trainee_relationships"
            android:textColor="@color/text_label_attendee"
            android:layout_height="wrap_content"/>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/traineeContainer"
        android:orientation="vertical"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_marginRight="@dimen/margin_10"
        android:layout_marginTop="@dimen/margin_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lblTraineeAge"
            android:layout_width="match_parent"
            android:text="@string/attendee_age"
            android:textStyle="bold"
            android:textColor="@color/ofis_base_font_dark"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/etTraineeAge"
            android:layout_width="match_parent"
            android:textSize="13sp"
            android:hint="@string/attendee_hint_age"
            android:paddingLeft="4dp"
            android:layout_marginTop="5dp"
            android:inputType="number"
            android:textColorHint="@color/icon_grey_palette_2"
            android:background="@drawable/edittext_bg_light"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/traineeGenderContainer"
        android:orientation="vertical"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_marginRight="@dimen/margin_10"
        android:layout_marginTop="@dimen/margin_10"
        android:layout_marginBottom="@dimen/margin_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lblTraineeGender"
            android:layout_width="match_parent"
            android:text="@string/attendee_sex1"
            android:textStyle="bold"
            android:textColor="@color/ofis_base_font_dark"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/spinnerGender"
            android:layout_width="match_parent"
            android:entries="@array/genders"
            android:layout_marginTop="5dp"
            android:textColor="@color/text_label_attendee"
            android:layout_height="wrap_content"/>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/traineeSignatureContainer"
        android:orientation="horizontal"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_marginRight="@dimen/margin_10"
        android:layout_marginTop="@dimen/margin_10"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/margin_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/signatureRelationAttendee"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center">
            <TextView
                android:layout_height="match_parent"
                android:layout_width="wrap_content"
                android:text="@string/Signature"
                android:textSize="@dimen/ofis_med_text"
                android:gravity="bottom"
                android:textColor="@color/ofis_base_font_dark" />

            <ImageButton
                android:layout_width="35dp"
                android:layout_height="30dp"
                android:layout_marginEnd="20dp"
                android:visibility="visible"
                android:background="@drawable/signature_icon" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/left_border"
            android:visibility="visible"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:id="@+id/attendeeRelationSignatureLayout"
            android:gravity="center">
            <ImageButton
                android:background="@android:color/transparent"
                android:layout_width="70dp"
                android:layout_height="40dp"
                android:id="@+id/attendeeRelationSignatureDisplay"
                android:layout_marginStart="20dp"
                android:contentDescription="@string/Add_Signature"
                app:srcCompat="@drawable/empty_signature"
                android:scaleType="fitCenter"
                tools:ignore="NestedWeights" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:background="@color/background_attendee"
        android:layout_height="16dp"/>

</LinearLayout>


