<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ofis_page_background"
        tools:context="com.olam.digital.ofis.RegisterAdditionalTrainee"
        android:focusableInTouchMode="true"
        tools:ignore="Overdraw">


        <!-- bottom section -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/btnSaveAttendees"
            android:background="@color/background_attendee"
            android:layout_below="@+id/topSection">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/scrollView"
                tools:ignore="UselessParent">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/bottomSectionContainer"
                    android:background="@color/background_attendee"
                    android:paddingLeft="@dimen/activity_horizontal_margin"
                    android:paddingRight="@dimen/activity_horizontal_margin"
                    android:paddingBottom="40dp"
                    android:paddingTop="@dimen/activity_vertical_margin">
                </LinearLayout>

            </ScrollView>
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveAttendees"
            android:text="@string/Save"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:textColor="@color/white"
            android:layout_margin="@dimen/activity_horizontal_margin"
            android:background="@color/btnColorPrimary"
            android:layout_height="wrap_content"/>

        <!-- top section -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/topSection"
            android:background="@color/ofis_farmer_screen_actions_background"
            android:baselineAligned="false"
            android:paddingBottom="0dp"
            android:layout_margin="0dp"
            android:weightSum="10">

            <!-- module and submodule title -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="8"
                android:paddingLeft="@dimen/activity_horizontal_margin"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:paddingRight="@dimen/activity_horizontal_margin"
                android:paddingBottom="@dimen/activity_vertical_margin">

                <TextView
                    android:id="@+id/tvFarmerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="5dp"
                    android:paddingRight="0dp"
                    android:text="Name"
                    android:textColor="@color/ofis_base_font_white"
                    android:textSize="@dimen/ofis_large_text" />
                <TextView
                    android:id="@+id/addAttendeeDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_attendee"
                    android:textColor="@color/ofis_base_font_white"
                    android:layout_marginTop="@dimen/mapview_magrin"
                    android:paddingRight="0dp"
                    android:paddingLeft="5dp"
                    android:textSize="@dimen/ofis_small_text"
                    tools:ignore="RtlHardcoded" />


            </LinearLayout>
            <!-- end module and submodule title -->
            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:paddingTop="25dp"
                android:paddingLeft="0dp"
                android:paddingRight="10dp">

                <ImageButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnAddAttendee"
                    android:src="@drawable/ic_add_active"
                    android:scaleType="center"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/Save"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentRight="true"
                    />

            </RelativeLayout>

        </LinearLayout>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>