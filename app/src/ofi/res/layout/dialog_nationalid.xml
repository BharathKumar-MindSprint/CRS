<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:weightSum="1"
    android:gravity="center"
    android:background="@drawable/border_white_background"
    android:padding="@dimen/margin_10"
    android:layout_height="wrap_content"
    tools:context=".AddFarmerActivity">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:gravity="center"
        android:weightSum="10"
        android:background="@color/white"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_title_matchresult_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:textColor="@color/black"
            android:padding="5dp"
            android:text="National ID"
            android:layout_weight="9"
            android:textAppearance="?android:textAppearanceMedium"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="wrap_content"
            app:srcCompat="@drawable/ic_consent_close"
            android:layout_alignTop="@+id/signature_pad"
            android:id="@+id/btn_cancel_nid"
            android:padding="10dp"
            android:layout_weight="1"
            android:gravity="right|end"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@+id/ll_title"
        android:background="@drawable/border_grey_bg"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="13"
        android:layout_margin="@dimen/margin_10">



        <LinearLayout
            android:id="@+id/ll_nidview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="13"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="10.8"
                android:orientation="horizontal"
                android:gravity="center">



                <LinearLayout
                    android:id="@+id/ll_capturephoto"
                    android:layout_width="105dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <LinearLayout

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/nationalidphoto"
                            android:layout_width="74dp"
                            android:tooltipText="@string/captureid"
                            app:srcCompat="@drawable/ic_capture_id_defaulr"
                            android:layout_height="94dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="bottom|end">
                            <ImageButton
                                android:layout_width="@dimen/button_width_height"
                                android:layout_height="@dimen/button_width_height"
                                android:id="@+id/nidphotoActionButton"
                                android:contentDescription="@string/Camera"
                                app:srcCompat="@drawable/ic_actionbutton_camera"
                                android:layout_marginLeft="5dp"
                                android:adjustViewBounds="false"
                                android:background="@android:color/transparent"
                                android:scaleType="fitXY" />
                        </LinearLayout>
                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    >


                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/idtypespinner"
                        android:hint="@string/idtype"
                        android:layout_weight="1"
                        android:theme="@style/AppCompactTheme"
                        android:layout_margin="@dimen/ofis_input_field_bottom_margin" />

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:inputType="textCapWords"
                        android:id="@+id/nidnumber"
                        android:textSize="@dimen/ofis_input_field_text"
                        android:textColorHint="@color/icon_grey_palette_2"
                        android:textColor="@color/ofis_base_font_dark"
                        android:background="@drawable/edittext_bg_light"
                        android:padding="@dimen/margin_10"
                        android:hint="@string/nationalidno"
                        android:layout_margin="@dimen/ofis_input_field_bottom_margin"/>

                </LinearLayout>


            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add"
        android:id="@+id/addnid"
        android:background="@color/ofis_action_button_background"
        android:textColor="@color/ofis_base_font_white"
        android:textSize="@dimen/ofis_med_text"
        android:padding="15dp"
        android:layout_gravity="center" />

</LinearLayout>