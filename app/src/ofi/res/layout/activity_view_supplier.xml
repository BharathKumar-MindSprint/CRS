<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".agrisupplier.ui.ViewSupplierActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/ofis_farmer_screen_actions_background"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="21dp"
            android:text="@string/view_supplier"
            android:textSize="@dimen/ofis_large_text"
            android:textColor="@color/ofis_base_font_white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSupplierName"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:textSize="@dimen/ofis_input_field_text"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            android:textColor="@color/ofis_base_font_dark"
            android:background="@drawable/edittext_bg_dark"
            android:paddingLeft="@dimen/margin_10"
            android:paddingTop="5dp"
            android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="parent"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvSupplierId"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:textSize="@dimen/ofis_input_field_text"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            android:textColor="@color/ofis_base_font_dark"
            android:background="@drawable/edittext_bg_dark"
            android:paddingLeft="@dimen/margin_10"
            android:paddingTop="5dp"
            android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
            app:layout_constraintTop_toBottomOf="@id/tvSupplierName"
            app:layout_constraintStart_toStartOf="parent"
            android:maxLines="1" />

        <TextView
            android:id="@+id/viewSupplierInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/ofis_large_text"
            android:textColor="@color/ofis_base_font_white"
            android:paddingLeft="5dp"
            android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
            android:text="@string/view_supplier_information"
            android:maxLines="1"
            android:layout_marginTop="15dp"
            android:layout_marginLeft="16dp"
            app:drawableRightCompat="@drawable/ic_drop_down_collapse"
            app:layout_constraintTop_toBottomOf="@+id/tvSupplierId"
            android:drawablePadding="8dp"
            app:layout_constraintStart_toStartOf="parent" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clSupplierInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:visibility="gone"
            android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
            app:layout_constraintTop_toBottomOf="@+id/viewSupplierInfo"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvPhoneNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="@string/PhoneNumberHint"
                android:textSize="@dimen/ofis_input_field_text"
                android:textColor="@color/ofis_base_font_white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvSupplierGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginLeft="16dp"
                android:text="@string/supplier_group"
                android:textSize="@dimen/ofis_input_field_text"
                android:textColor="@color/ofis_base_font_white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPhoneNumber" />

            <TextView
                android:id="@+id/tvSupplierType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginLeft="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/supplier_type"
                android:textSize="@dimen/ofis_input_field_text"
                android:textColor="@color/ofis_base_font_white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSupplierGroup" />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTitleTaskList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/clTopLayout"
            app:layout_constraintStart_toStartOf="parent"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:background="@color/sub_task_header_bg">

            <ImageView
                android:id="@+id/ivListIcon"
                android:layout_width="20dp"
                android:layout_height="27dp"
                android:scaleType="fitStart"
                android:contentDescription="@string/ofis_cd_info_icon"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginRight="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_task_list_icon" />

            <TextView
                android:id="@+id/tvTitleTaskList"
                android:layout_width="wrap_content"
                android:layout_height="27dp"
                android:text="@string/Task_list_header"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:textColor="@color/ofis_list_header_text"
                android:textSize="@dimen/ofis_med_text"
                android:gravity="top|center_vertical"
                app:layout_constraintStart_toEndOf="@+id/ivListIcon"
                app:layout_constraintTop_toTopOf="parent"
                />



        </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clNoTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/clTitleTaskList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="fitStart"
            android:contentDescription="@string/ofis_cd_info_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:srcCompat="@drawable/no_task_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:text="@string/no_task"
            android:id="@+id/tvNoTask"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:textColor="@color/btn_secondary_background"
            android:textSize="@dimen/ofis_med_text"
            app:layout_constraintTop_toBottomOf="@+id/imageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clSupplierSurvey"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/clTitleTaskList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="visible">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSupplierSurvey"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>