<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ofis_page_background"
    tools:context="com.olam.digital.ofis.AddInfrastructureActivity"
    android:focusableInTouchMode="true"
    tools:ignore="Overdraw">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:id="@+id/topSectionBackground"
        android:background="@color/ofis_poi_screen_top_background_school"
        android:contentDescription="@string/cd_topSectionColour" />

    <!-- bottom section -->
    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/scrollView"
        android:layout_below="@+id/topSectionBackground"
        android:padding="0dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/bottomSection"
            android:background="@android:color/transparent"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:animateLayoutChanges="true">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/questionsSection"/>


            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/olamFundedWrapper"
                android:visibility="gone"
                android:paddingLeft="@dimen/ofis_large_pad"
                android:paddingRight="@dimen/ofis_large_pad"
                android:paddingBottom="@dimen/activity_vertical_margin"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:background="@drawable/border_white_background">

                <Switch
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ofis_olam_funded"
                    android:id="@+id/olamFunded"
                    android:textOff="@string/ofis_switch_text_no"
                    android:textOn="@string/ofis_switch_text_yes"
                    android:textSize="@dimen/ofis_small_text"
                    android:textStyle="bold"
                    android:switchTextAppearance="@style/SwitchText"
                    tools:ignore="RtlHardcoded" />

            </LinearLayout>

            <include
                android:visibility="gone"
                android:id="@+id/additional_components_school"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/include_additional_components_school" />
            <include
                android:visibility="gone"
                android:id="@+id/additional_components_buyingcentre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/include_additional_components_buyingcentre" />
            <include
                android:visibility="gone"
                android:id="@+id/additional_components_cleanwatersupply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/include_additional_components_cleanwatersupply" />
            <include
                android:visibility="gone"
                android:id="@+id/additional_components_healthcentre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/include_additional_components_healthcentre" />

            <!--This applicable for all SIP -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/ofis_large_pad"
                android:paddingRight="@dimen/ofis_large_pad"
                android:paddingBottom="@dimen/activity_vertical_margin"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:background="@drawable/border_white_background"
                android:layout_marginTop="@dimen/ofis_med_pad">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ofis_text_field"
                    android:textSize="@dimen/ofis_small_text"
                    android:text="@string/location"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/ofis_med_pad"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ofis_med_pad">

                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/spinner_country"
                        android:hint="@string/Country"
                        android:nextFocusDown="@+id/spinner_region"
                        android:nextFocusForward="@+id/spinner_region"
                        android:layout_weight="1"
                        android:layout_marginLeft="0dp"
                        />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                        app:srcCompat="@drawable/ic_spinner_hierarchy_arrow"
                        android:scaleType="center"
                        android:visibility="invisible"/>

                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/spinner_region"
                        android:nextFocusDown="@id/spinner_district"
                        android:layout_marginRight="0dp"
                        android:layout_weight="1" />

                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/ofis_med_pad">

                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/spinner_district"
                        android:nextFocusDown="@+id/spinner_place"
                        android:nextFocusForward="@+id/spinner_place"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/haDistrict"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                        app:srcCompat="@drawable/ic_spinner_hierarchy_arrow"
                        android:scaleType="center"
                        android:visibility="invisible"/>

                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/spinner_place"
                        android:layout_marginRight="0dp"
                        android:layout_weight="1" />



                </LinearLayout>

                <LinearLayout
                    android:visibility="gone"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/ofis_bottom_section_padding_vertical">

                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/spinner_place_remove"
                        android:nextFocusDown="@+id/spinner_place"
                        android:nextFocusForward="@+id/spinner_place"
                        android:layout_weight="1" />

                    <ImageView
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                        app:srcCompat="@drawable/ic_spinner_hierarchy_arrow"
                        android:scaleType="center"
                        />

                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="invisible"
                        android:layout_marginRight="0dp"
                        android:layout_weight="1" />



                </LinearLayout>


                <!-- Farmer group view incorporated -Starts-->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ofis_text_field"
                    android:textSize="@dimen/ofis_small_text"
                    android:text="@string/Farmer_Group_Name"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/ofis_med_pad"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/spinner_farmerGroup"
                        android:layout_weight="1"
                        android:layout_marginLeft="0dp"
                        android:layout_marginStart="0dp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusDown="@+id/spinner_section"
                        android:nextFocusForward="@+id/spinner_section"/>

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                        app:srcCompat="@drawable/ic_spinner_hierarchy_arrow"
                        android:scaleType="center"
                        android:id="@+id/haFarmerGroup"
                        android:visibility="invisible"/>

                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/spinner_section"
                        android:layout_marginRight="0dp"
                        android:layout_marginEnd="0dp"
                        android:visibility="gone"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                </LinearLayout>


                <!-- Farmer group view incorporated -Ends-->



            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/ofis_large_pad">

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Save"
                    android:id="@+id/buttonSave"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"
                    android:background="@color/ofis_action_button_background"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp" />
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

    <!-- page heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Add_Point_of_Interest"
        android:id="@+id/textView2"
        android:textColor="@color/ofis_base_font_white"
        android:textSize="@dimen/ofis_large_text"
        android:paddingRight="0dp"
        android:paddingLeft="15dp"
        android:paddingTop="10dp"
        android:maxLines="1" />

    <!-- top section -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:id="@+id/topSection"
        android:layout_marginBottom="0dp"
        android:paddingBottom="0dp"
        android:layout_below="@id/textView2"
        android:baselineAligned="false">

        <!-- white input fields -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingBottom="@dimen/activity_vertical_margin">

            <Spinner
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:id="@+id/spinner_modules"
                android:visibility="invisible"
                android:textColor="@color/ofis_base_font_white"
                />

            <!--android:entries="@array/poitypes"-->
            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/spinner_submodules"
                android:paddingRight="20dp"
                android:textColor="@color/ofis_base_font_dark"/>

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/villageSpinner"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_input_field_text"
                android:visibility="gone"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"

                />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:inputType="textCapWords"
                android:id="@+id/poiName"
                android:textColor="@color/ofis_base_font_dark"
                android:textSize="@dimen/ofis_input_field_text"
                android:maxLength="50"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                android:hint="@string/Name"
                android:textColorHint="@color/icon_grey_palette_2"
                android:padding="@dimen/margin_10"
                android:background="@drawable/edittext_bg_dark"
               android:visibility="gone" />

        </LinearLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1.8"
            android:paddingTop="10dp"
            android:paddingLeft="0dp"
            android:paddingRight="10dp">
            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:id="@+id/gpsPosition"
                android:textColor="@color/ofis_base_font_dark"
                android:textSize="@dimen/ofis_input_field_text"
                android:layout_marginTop="5dp"
                android:hint="@string/GPS_Position"
                android:textColorHint="@color/icon_grey_palette_2"
                android:background="@drawable/edittext_bg_dark"
                android:padding="@dimen/margin_10"
                android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin" />

            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/requestLocation"
                android:contentDescription="@string/record_farm_location_hint"
                app:srcCompat="@drawable/ic_actionbutton_location_searching"
                android:background="@android:color/transparent"
                android:layout_alignParentEnd="false"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:layout_marginBottom="@dimen/margin_10"
                android:padding="0dp"
                android:adjustViewBounds="false"
                android:scaleType="fitXY" />
        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
