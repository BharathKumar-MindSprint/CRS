<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ofis_page_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="25dp"
        android:paddingBottom="25dp"
        android:paddingRight="20dp"
        android:background="@color/ofis_page_background">

    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/childVisitDetailButton"
        android:layout_width="match_parent"
        android:gravity="center_vertical"
        android:layout_height="52dp"
        android:weightSum="3"
        android:background="@color/btn_primary_background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_gravity="center|left"
            android:layout_toLeftOf="@+id/view_line_visit_detail"
            android:layout_weight="3"
            android:paddingLeft="20dp"
            android:text="@string/visit_detail"
            android:textColor="@color/ofis_base_font_white"
            android:textSize="16dp"
            android:textStyle="bold" />

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:id="@+id/view_line_visit_detail"
            android:layout_marginTop="5dp"
            android:layout_toLeftOf="@+id/imgv_visit_detail"
            android:layout_marginBottom="5dp"
            android:background="@color/ofis_base_font_white"/>

        <ImageView
            android:id="@+id/imgv_visit_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="2dp"
            android:layout_marginLeft="2dp"
            android:paddingLeft="25dp"
            android:paddingRight="25dp"
            app:srcCompat="@drawable/ic_detail_view" />

    </RelativeLayout>

        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/addChildButton"
            android:layout_width="match_parent"
            android:gravity="center_vertical"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:weightSum="3"
            android:background="@drawable/btn_primary_outlines">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_child"
                android:layout_gravity="center|left"
                android:paddingLeft="20dp"
                android:textStyle="bold"
                android:textColor="@color/btnColorPrimary"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:layout_toLeftOf="@+id/view_line_register_child"
                android:textSize="16dp"
                android:layout_weight="3"/>

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:id="@+id/view_line_register_child"
                android:layout_marginTop="5dp"
                android:layout_toLeftOf="@+id/imgv_register_child"
                android:layout_marginBottom="5dp"
                android:background="@color/btnColorPrimary"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="25dp"
                android:id="@+id/imgv_register_child"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:paddingRight="25dp"
                app:srcCompat="@drawable/ic_reg_child"/>

        </RelativeLayout>
    </LinearLayout>



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/registerChildRecycleView"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_marginRight="@dimen/margin_10"
        android:layout_height="wrap_content">
    </androidx.recyclerview.widget.RecyclerView>

</LinearLayout>