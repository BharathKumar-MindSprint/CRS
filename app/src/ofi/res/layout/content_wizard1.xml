<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/consentStatementHolder"
        android:orientation="vertical"
         android:background="@drawable/border_white_cs"
        >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/ofis_large_pad"
                    android:paddingRight="@dimen/ofis_large_pad"
                    android:paddingTop="@dimen/ofis_large_pad">
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ofis_consent_statement_row_bottom_margin"
                        android:weightSum="10"
                        android:gravity="top">
                            <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="10"
                            android:textSize="@dimen/ofis_med_text"
                            android:text="@string/consent_statement_pageone1" />
                    </TableRow>
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ofis_consent_statement_row_bottom_margin"
                        android:weightSum="10"
                        android:gravity="top">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="10"
                            android:textSize="@dimen/ofis_med_text"
                            android:text="@string/consent_statement_pageone2"/>
                    </TableRow>

                </TableLayout>



            </LinearLayout>



    </LinearLayout>

</LinearLayout>