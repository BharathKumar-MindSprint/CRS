<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ofis_page_background"
    tools:context=".mvvmmodule.view.diagnosticmodule.fragment.SurveyResultsFragment">

    <RelativeLayout
        android:id="@+id/rl_survey_results"
        android:layout_below="@+id/ll_tab_layoutmain"
        android:layout_marginTop="@dimen/margin_10"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Survey Results"
            android:textStyle="bold"
            android:textSize="20dp"
            android:textColor="@color/colorPrimary"
            android:gravity="center"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/table_width60"
            android:orientation="horizontal"
            android:layout_alignParentBottom="true"
            android:background="@color/white"
            android:weightSum="2">
            <LinearLayout
                android:id="@+id/ll_servey_back_servey_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/dm_back_background"
                android:layout_margin="@dimen/margin_10"
                android:layout_weight="1">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/back"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:textColor="@color/black"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_servey_next_servey_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/dm_next_background"
                android:layout_margin="@dimen/margin_10"
                android:layout_weight="1">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/ModuleNextButton"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:textColor="@color/white"/>
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

</FrameLayout>