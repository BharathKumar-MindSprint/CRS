<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".mvvmmodule.view.diagnosticmodule.fragment.FollowUpActionPlan">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/ll_currency_layout_follow_up_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/layout_white_radius_bg"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_10"
                    android:text="@string/dm_select_currency_txt"
                    android:textColor="@color/black"
                    android:textSize="@dimen/ofis_med_text"
                    android:textStyle="bold" />


                <Spinner
                    android:id="@+id/spinner_farmerGroup"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="@dimen/margin_10"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusDown="@+id/spinner_section"
                    android:nextFocusForward="@+id/spinner_section" />
            </LinearLayout>

<!--            Complaints-->
            <LinearLayout
                android:id="@+id/ll_complaint_layout_follow_up_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_10"
                android:layout_marginTop="10dp"
                android:background="@color/white"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_currency_layout_follow_up_action">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/background_multifarm"
                    android:visibility="visible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/text_button_width_height"
                        android:layout_margin="@dimen/margin_10">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:text="Complaint"
                            android:textColor="@color/black"
                            android:textSize="@dimen/ofis_med_text"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iv_complaint_dropdown_follow_up_action"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/margin_10"
                            android:src="@drawable/ic_dropdown_new" />

                    </RelativeLayout>


                    <LinearLayout
                        android:id="@+id/ll_complaint_follow_up_action"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_10"
                            android:text="1. Does the farmer have bank account?"
                            android:textColor="@color/black"
                            android:textSize="@dimen/ofis_med_text"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_margin="@dimen/margin_10">

                            <TextView
                                android:id="@+id/resolve_follow_up"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Resolved"
                                android:textColor="@color/colorPrimary"
                                android:padding="3dp"
                                android:background="@drawable/follow_up_resolved"/>

                            <EditText
                                android:layout_width="match_parent"
                                android:layout_height="90dp"
                                android:background="@drawable/farm_code_selected_edittext"
                                android:focusable="false"
                                android:hint="Action Plan Details"
                                android:inputType="textMultiLine"
                                android:padding="@dimen/margin_10"
                                android:textColor="@color/btn_secondary_background"
                                android:textColorHint="@color/icon_grey_palette_2"
                                android:textSize="@dimen/ofis_input_field_text" />

                        </androidx.appcompat.widget.LinearLayoutCompat>





                        <RelativeLayout
                            android:id="@+id/rl_complaint_captureproof_layout_follow_up_action"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/table_width60"
                            android:layout_margin="@dimen/margin_10"
                            android:background="@drawable/dm_captureproof_bg"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_capture_complaint_txt_follow_up_action"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:text="Capture Proof"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/ofis_med_text"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="@dimen/margin_10"
                                android:layout_toRightOf="@+id/tv_capture_complaint_txt_follow_up_action"
                                android:backgroundTint="@color/colorPrimary"
                                android:src="@drawable/ic_survey" />

                        </RelativeLayout>


                        <LinearLayout
                            android:id="@+id/image_layout_action_follow_up"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                        </LinearLayout>


                        <Spinner
                            android:id="@+id/spinner_complaint_actionplan_follow_up"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_margin="@dimen/margin_10"
                            android:layout_weight="1"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusDown="@+id/spinner_section"
                            android:nextFocusForward="@+id/spinner_section" />
                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>

<!--            Non Complaints-->
            <LinearLayout
                android:id="@+id/ll_non_complaint_layout_follow_up_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_10"
                android:layout_marginTop="10dp"
                android:background="@color/white"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_complaint_layout_follow_up_action">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/background_multifarm"
                    android:visibility="visible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/text_button_width_height"
                        android:layout_margin="@dimen/margin_10">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:text="Non Complaint"
                            android:textColor="@color/black"
                            android:textSize="@dimen/ofis_med_text"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iv_non_complaint_dropdown_follow_up_action"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/margin_10"
                            android:src="@drawable/ic_dropdown_new" />

                    </RelativeLayout>


                    <LinearLayout
                        android:id="@+id/ll_non_complaint_follow_up_action"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_10"
                            android:text="1. Does the farmer have bank account?"
                            android:textColor="@color/black"
                            android:textSize="@dimen/ofis_med_text"
                            android:textStyle="bold" />



                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_margin="@dimen/margin_10">

                        <TextView
                            android:id="@+id/not_resolve_follow_up"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Not Resolved"
                            android:textColor="#f78c2a"
                            android:padding="3dp"
                            android:background="@drawable/follow_up_not_resolved"/>

                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:background="@drawable/farm_code_selected_edittext"
                            android:focusable="false"
                            android:hint="Action Plan Details"
                            android:inputType="textMultiLine"
                            android:padding="@dimen/margin_10"
                            android:textColor="@color/btn_secondary_background"
                            android:textColorHint="@color/icon_grey_palette_2"
                            android:textSize="@dimen/ofis_input_field_text" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <RelativeLayout
                            android:id="@+id/rl_non_complaint_captureproof_layout_follow_up_action"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/table_width60"
                            android:layout_margin="@dimen/margin_10"
                            android:background="@drawable/dm_captureproof_bg"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_capture_non_complaint_txt_follow_up_action"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:text="Capture Proof"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/ofis_med_text"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="@dimen/margin_10"
                                android:layout_toRightOf="@+id/tv_capture_non_complaint_txt_follow_up_action"
                                android:backgroundTint="@color/colorPrimary"
                                android:src="@drawable/ic_survey" />

                        </RelativeLayout>


                        <LinearLayout
                            android:id="@+id/image_layout_action_non_complaints_follow_up"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                        </LinearLayout>


                        <Spinner
                            android:id="@+id/spinner_non_complaint_actionplan_follow_up"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_margin="@dimen/margin_10"
                            android:layout_weight="1"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusDown="@+id/spinner_section"
                            android:nextFocusForward="@+id/spinner_section" />

                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:layout_margin="@dimen/margin_10"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/farm_code_selected_edittext"
                            android:focusable="false"
                            android:hint="Action Plan Details"
                            android:inputType="textMultiLine"
                            android:padding="@dimen/margin_10"
                            android:textColor="@color/btn_secondary_background"
                            android:textColorHint="@color/icon_grey_palette_2"
                            android:textSize="@dimen/ofis_input_field_text" />

                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>

<!--            Satisfactory-->
            <LinearLayout
                android:id="@+id/ll_satisfactory_layout_follow_up_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_10"
                android:layout_marginTop="10dp"
                android:background="@color/white"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_non_complaint_layout_follow_up_action">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/background_multifarm"
                    android:visibility="visible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/text_button_width_height"
                        android:layout_margin="@dimen/margin_10">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:text="Satisfactory"
                            android:textColor="@color/black"
                            android:textSize="@dimen/ofis_med_text"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iv_satisfactory_dropdown_follow_up_action"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/margin_10"
                            android:src="@drawable/ic_dropdown_new" />

                    </RelativeLayout>


                    <LinearLayout
                        android:id="@+id/ll_satisfactory_follow_up_action"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_10"
                            android:text="1. Does the farmer have bank account?"
                            android:textColor="@color/black"
                            android:textSize="@dimen/ofis_med_text"
                            android:textStyle="bold" />

                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:layout_margin="@dimen/margin_10"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/farm_code_selected_edittext"
                            android:focusable="false"
                            android:hint="Action Plan Details"
                            android:inputType="textMultiLine"
                            android:padding="@dimen/margin_10"
                            android:textColor="@color/btn_secondary_background"
                            android:textColorHint="@color/icon_grey_palette_2"
                            android:textSize="@dimen/ofis_input_field_text" />

                        <RelativeLayout
                            android:id="@+id/rl_satisfactory_captureproof_layout_follow_up_action"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/table_width60"
                            android:layout_margin="@dimen/margin_10"
                            android:background="@drawable/dm_captureproof_bg"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_capture_satisfactory_txt_follow_up_action"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:text="Capture Proof"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/ofis_med_text"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="@dimen/margin_10"
                                android:layout_toRightOf="@+id/tv_capture_satisfactory_txt_follow_up_action"
                                android:backgroundTint="@color/colorPrimary"
                                android:src="@drawable/ic_survey" />

                        </RelativeLayout>


                        <LinearLayout
                            android:id="@+id/image_layout_action_satisfactory_follow_up"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                        </LinearLayout>


                        <Spinner
                            android:id="@+id/spinner_satisfactory_actionplan_follow_up"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_margin="@dimen/margin_10"
                            android:layout_weight="1"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusDown="@+id/spinner_section"
                            android:nextFocusForward="@+id/spinner_section" />

                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:layout_margin="@dimen/margin_10"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/farm_code_selected_edittext"
                            android:focusable="false"
                            android:hint="Action Plan Details"
                            android:inputType="textMultiLine"
                            android:padding="@dimen/margin_10"
                            android:textColor="@color/btn_secondary_background"
                            android:textColorHint="@color/icon_grey_palette_2"
                            android:textSize="@dimen/ofis_input_field_text" />

                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>





    </ScrollView>

</FrameLayout>