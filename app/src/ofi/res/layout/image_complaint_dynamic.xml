<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/rl_complaint_fileupload_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_10">

        <ImageView
            android:id="@+id/iv_fileupload"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:backgroundTint="@color/colorPrimary"
            android:src="@drawable/ic_survey" />

        <TextView
            android:id="@+id/tv_complaint_filename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="2dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="40dp"
            android:layout_toRightOf="@+id/iv_fileupload"
            android:gravity="center_vertical"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/ofis_small_text"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_complaint_delete_file"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:padding="5dp"
            android:background="@drawable/dm_circular_bg"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_dm_cross" />

    </RelativeLayout>

</LinearLayout>