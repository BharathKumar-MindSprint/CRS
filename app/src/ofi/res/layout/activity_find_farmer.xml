<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ofis_page_background"
    tools:context="com.olam.digital.ofis.FindFarmerActivity"
    android:id="@+id/layout_find_farmer"
    tools:ignore="Overdraw">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/topSection"
        android:layout_weight="0.25"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin">

<!--        <LinearLayout-->
<!--            android:orientation="horizontal"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="match_parent">-->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Select_Farmer"
                android:id="@+id/pageTitle"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_large_text" />

<!--        </LinearLayout>-->

        <!-- business groups -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
            android:layout_marginTop="@dimen/margin_10"
            android:paddingLeft="0dp"
            android:paddingRight="0dp">

            <Spinner
                android:id="@+id/spinner_country"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginRight="10dp"
                android:layout_marginLeft="0dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/spinner_section"
                android:nextFocusForward="@+id/spinner_section" />

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/spinner_product"
                android:layout_marginRight="0dp"
                android:layout_marginEnd="0dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"/>

        </LinearLayout>


        <!-- end business groups -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:layout_alignParentEnd="true">
            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:padding="@dimen/margin_10"
                android:inputType="textCapWords"
                android:textColorHint="@color/icon_grey_palette_2"
                android:textSize="@dimen/ofis_input_field_text"
                android:id="@+id/findFarmerSearchBox"
                android:layout_weight="1"
                android:textColor="@color/ofis_base_font_dark"
                android:hint="@string/Farmer_Name"
                android:drawableRight="@drawable/ic_searchimg"
                android:drawablePadding="@dimen/margin_10"
                android:background="@drawable/edittext_bg_dark"/>
            <ImageButton
                android:id="@+id/photoSearchButton"
                android:layout_width="@dimen/standard_button_width_height"
                android:layout_height="@dimen/standard_button_width_height"
                android:adjustViewBounds="false"
                android:layout_gravity="center"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/Camera"
                android:padding="0dp"
                android:scaleType="fitXY"
                android:layout_alignParentRight="true"
                app:srcCompat="@drawable/ic_actionbutton_camera" />
        </LinearLayout>

        </RelativeLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/advanced_filters"
            android:id="@+id/advancedFilters"
            android:textColor="@color/ofis_base_font_white"
            android:layout_marginTop="@dimen/margin_10"
            android:clickable="true"
            android:onClick="expandOrCollapse"
            android:drawableRight="@drawable/ic_drop_down_collapse"
            android:textSize="@dimen/ofis_large_text" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/advancedFilterLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
                    android:layout_marginTop="@dimen/margin_10"
                    android:layout_weight="1"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp">

                    <!--<Spinner
                        android:id="@+id/spinner_region"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="-5dp"
                        android:dropDownWidth="300dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="0dp"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:focusableInTouchMode="true"/>-->

                    <com.olam.digital.ofis.MultiSpinnerSearch
                        android:id="@+id/spinner_region"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="-5dp"
                        android:dropDownWidth="300dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="0dp"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        app:hintText="@string/spinner_region_view_farmer"/>

                    <com.olam.digital.ofis.MultiSpinnerSearch
                        android:id="@+id/spinner_district"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="-5dp"
                        android:dropDownWidth="300dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="0dp"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        app:hintText="@string/spinner_district_view_farmer"/>

                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
                    android:layout_marginTop="@dimen/margin_10"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp">

                    <com.olam.digital.ofis.MultiSpinnerSearch
                        android:id="@+id/spinner_place"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="-5dp"
                        android:dropDownWidth="300dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="0dp"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        app:hintText="@string/spinner_place_view_farmer"/>

                    <com.olam.digital.ofis.MultiSpinnerSearch
                        android:id="@+id/spinner_partner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="-5dp"
                        android:dropDownWidth="300dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="0dp"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        app:hintText="@string/spinner_partner_default"/>

                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
                    android:layout_marginTop="@dimen/margin_10"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp">

                    <com.olam.digital.ofis.MultiSpinnerSearch
                        android:id="@+id/spinner_program"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="-5dp"
                        android:dropDownWidth="300dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="0dp"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        app:hintText="@string/spinner_programme_default"/>

                    <com.olam.digital.ofis.MultiSpinnerSearch
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/spinner_farmerGroup"
                        android:paddingLeft="-5dp"
                        android:dropDownWidth="300dp"
                        android:layout_marginRight="0dp"
                        android:layout_marginEnd="0dp"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        app:hintText="@string/spinner_farmergroup_view_farmer"/>

                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
                    android:layout_marginTop="@dimen/margin_10"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp">

                    <com.olam.digital.ofis.MultiSpinnerSearch
                        android:id="@+id/spinner_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="-5dp"
                        android:dropDownWidth="300dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="0dp"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        app:hintText="@string/spinner_section_view_farmer"/>

                    <com.olam.digital.ofis.MultiSpinnerSearch
                        android:id="@+id/spinner_certification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="-5dp"
                        android:dropDownWidth="300dp"
                        android:layout_marginRight="0dp"
                        android:layout_marginEnd="0dp"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        app:hintText="@string/certification_name"/>

                </LinearLayout>
            </LinearLayout>
        </ScrollView>


    </LinearLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.75"
        android:id="@+id/bottomSection">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"/>
    </LinearLayout>

</LinearLayout>
