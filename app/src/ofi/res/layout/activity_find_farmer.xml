<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ofis_page_background"
    tools:context="com.olam.digital.ofis.FindFarmerActivity"
    android:id="@+id/layout_find_farmer"
    tools:ignore="Overdraw">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/topSection"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/Select_Farmer"
                android:id="@+id/pageTitle"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_large_text"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- business groups -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
            android:layout_marginTop="@dimen/margin_10"
            android:paddingLeft="0dp"
            android:paddingRight="0dp">

            <Spinner
                android:id="@+id/spinner_farmerGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginLeft="0dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/spinner_section"
                android:nextFocusForward="@+id/spinner_section" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                android:visibility="invisible"
                app:srcCompat="@drawable/ic_spinner_hierarchy_arrow"
                android:scaleType="center" />

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/spinner_section"
                android:layout_marginRight="0dp"
                android:layout_marginEnd="0dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"/>

        </LinearLayout>
        <!-- end business groups -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:layout_alignParentEnd="true">
            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:padding="@dimen/margin_10"
                android:inputType="textCapWords"
                android:textColorHint="@color/icon_grey_palette_2"
                android:textSize="@dimen/ofis_input_field_text"
                android:id="@+id/findFarmerSearchBox"
                android:layout_weight="1"
                android:textColor="@color/ofis_base_font_dark"
                android:hint="@string/Farmer_Name"
                android:drawableRight="@drawable/ic_searchimg"
                android:drawablePadding="@dimen/margin_10"
                android:background="@drawable/edittext_bg_dark"/>
            <ImageButton
                android:id="@+id/photoSearchButton"
                android:layout_width="@dimen/standard_button_width_height"
                android:layout_height="@dimen/standard_button_width_height"
                android:adjustViewBounds="false"
                android:layout_gravity="center"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/Camera"
                android:padding="0dp"
                android:scaleType="fitXY"
                android:layout_alignParentRight="true"
                app:srcCompat="@drawable/ic_actionbutton_camera" />
        </LinearLayout>

        </RelativeLayout>

<!--        <LinearLayout-->
<!--            android:id="@+id/biometric_layout"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_gravity="right"-->
<!--            android:visibility="gone"-->
<!--            android:orientation="horizontal">-->

<!--            <TextView-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text="@string/search_by_photo"-->
<!--                android:textColor="@color/ofis_base_font_white"-->
<!--                android:textSize="@dimen/ofis_med_text"-->
<!--                android:gravity="center"-->
<!--                android:layout_marginRight="5dp"-->
<!--                android:layout_weight="1" />-->

<!--            <ImageButton-->
<!--                android:id="@+id/photoSearchButton1"-->
<!--                android:layout_width="@dimen/standard_button_width_height"-->
<!--                android:layout_height="@dimen/standard_button_width_height"-->
<!--                android:adjustViewBounds="false"-->
<!--                android:background="@android:color/transparent"-->
<!--                android:contentDescription="@string/Camera"-->
<!--                android:padding="0dp"-->
<!--                android:scaleType="fitXY"-->
<!--                app:srcCompat="@drawable/ic_actionbutton_camera" />-->

<!--        </LinearLayout>-->

    </LinearLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/bottomSection"
        android:layout_below="@+id/topSection">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"/>
    </LinearLayout>

</RelativeLayout>
