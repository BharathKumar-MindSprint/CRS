<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/list_item"
    android:paddingLeft="@dimen/ofis_med_pad"
    android:paddingRight="@dimen/ofis_med_pad"
    android:paddingTop="@dimen/ofis_list_itemseparator"
    android:paddingBottom="@dimen/ofis_list_itemseparator">


    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:id="@+id/rowlin"
        android:layout_height="wrap_content"

        android:baselineAligned="false"
        android:weightSum="8"
        tools:ignore="UselessParent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:id="@+id/itemTextContainer"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_weight="7">

            <TextView
                android:id="@+id/trainingAttendeeId"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="9"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Farmer_Name"
                        android:id="@+id/attendeeName"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/ofis_base_font_dark"
                        android:textSize="@dimen/ofis_med_text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/signatureAttendee"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="2dp"
                        android:visibility="gone"
                        android:layout_gravity="center"
                        android:background="@drawable/edit_plot_circular_button" />

                    <ImageView
                        android:id="@+id/addTrainingAttendeesIv"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="5dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/Add"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_ofis_add" />

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="23dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:id="@+id/deleteItem"
                        app:srcCompat="@drawable/ic_delete_item"
                        android:contentDescription="@string/Delete_Item"
                        android:layout_gravity="center" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/ofis_small_pad">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/criterion_attended"
                        android:textColor="@color/ofis_list_item_subtitle"
                        android:paddingLeft="@dimen/ofis_med_pad"
                        android:textSize="@dimen/ofis_small_text"
                        android:visibility="gone"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/criterion_passed"
                        android:textColor="@color/ofis_list_item_subtitle"
                        android:background="@drawable/left_border"
                        android:paddingLeft="@dimen/ofis_med_pad"
                        android:layout_marginLeft="@dimen/ofis_med_pad"
                        android:textSize="@dimen/ofis_small_text"
                        android:visibility="gone"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/ofis_small_pad">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/criterion_prescore"
                        android:textColor="@color/ofis_list_item_subtitle"
                        android:textSize="@dimen/ofis_small_text"
                        android:visibility="gone"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/criterion_postscore"
                        android:textColor="@color/ofis_list_item_subtitle"
                        android:background="@drawable/left_border"
                        android:paddingLeft="@dimen/ofis_med_pad"
                        android:layout_marginLeft="@dimen/ofis_med_pad"
                        android:textSize="@dimen/ofis_small_text"
                        android:visibility="gone"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/criterion_score"
                    android:textColor="@color/ofis_list_item_subtitle"
                    android:textSize="@dimen/ofis_small_text"
                    android:layout_marginBottom="@dimen/ofis_small_pad"
                    android:visibility="gone"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/criterion_percentage"
                    android:textColor="@color/ofis_list_item_subtitle"
                    android:textSize="@dimen/ofis_small_text"
                    android:layout_marginBottom="@dimen/ofis_small_pad"
                    android:visibility="gone"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/criterion_grade"
                    android:textColor="@color/ofis_list_item_subtitle"
                    android:textSize="@dimen/ofis_small_text"
                    android:layout_marginBottom="@dimen/ofis_small_pad"
                    android:visibility="gone"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/left_border"
            android:visibility="visible"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:id="@+id/attendeeSignatureLayout"
            android:gravity="center">
            <ImageButton
                android:background="@android:color/transparent"
                android:layout_width="70dp"
                android:layout_height="40dp"
                android:id="@+id/attendeeSignatureDisplay"
                android:layout_marginStart="5dp"
                android:contentDescription="@string/Add_Signature"
                app:srcCompat="@drawable/empty_signature"
                android:scaleType="fitCenter"
                tools:ignore="NestedWeights" />
        </LinearLayout>



    </LinearLayout>

    <TextView
        android:id="@+id/tvViewAddendees"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/view_attendees_count"
        android:textColor="@color/btnColorPrimary"
        android:textStyle="bold"
        android:layout_marginLeft="@dimen/margin_10"
        android:textSize="@dimen/ofis_small_text" />

</LinearLayout>


