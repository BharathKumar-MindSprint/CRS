<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#ECECEC" />
                    <stroke android:width="2px" android:color="#878786" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
            <item android:gravity="center" android:drawable="@drawable/ic_status_no_photo"
                android:right="@dimen/margin_10" android:top="10dp" android:bottom="10dp" android:left="10dp"/>

        </layer-list>
    </item>

</selector>