<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ofis_page_background"
    tools:context="com.olam.digital.ofis.FindFarmerActivity"
    android:id="@+id/layout_view_answers"
    tools:ignore="Overdraw">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/topSection"
        android:background="@color/ofis_farmer_screen_actions_background">

        <LinearLayout
            android:id="@+id/ll_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:weightSum="10"
            android:background="@color/dark_gray"
            android:orientation="horizontal">

              <ImageView
                android:layout_width="wrap_content"
                android:src="@drawable/ic_folder"
                android:layout_alignTop="@+id/signature_pad"
                android:id="@+id/back_btn"
                android:padding="10dp"
                android:layout_weight="1"
                android:gravity="left|end"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_title_matchresult_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:textColor="@color/ofis_farmer_screen_actions_background"
                android:padding="5dp"
                android:layout_marginLeft="10dp"
                android:text="@string/view_recent_survey_data"
                android:layout_weight="9"
                android:textAppearance="?android:textAppearanceMedium"
                android:textStyle="bold|italic" />

            <ImageView
                android:layout_width="wrap_content"
                android:src="@drawable/ic_close_info"
                android:layout_alignTop="@+id/signature_pad"
                android:id="@+id/cancel_btn"
                android:padding="10dp"
                android:layout_weight="1"
                android:gravity="right|end"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ModuleSubTitle"
            android:id="@+id/completeModuleSubModule"
            android:textColor="@color/ofis_base_font_white"
            android:layout_marginTop="@dimen/mapview_magrin"
            android:padding="10dp"
            android:textSize="@dimen/ofis_small_text"
            tools:ignore="RtlHardcoded" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topSection">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/bottomSection">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/questionsSection"/>


    </LinearLayout>
    </ScrollView>
</RelativeLayout>
