<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"> <!-- we need a top level one here so we can first linear -->

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/additional_buyingcentre"
        android:background="@android:color/transparent"
        tools:ignore="UselessParent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/ofis_large_pad"
            android:paddingRight="@dimen/ofis_large_pad"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:background="@drawable/border_white_background"
            android:layout_marginTop="@dimen/ofis_med_pad">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/ofis_small_text"
                android:textColor="@color/ofis_text_field"
                android:text="@string/ofis_select_product"
                android:textStyle="bold" />

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ofis_text_field"
                android:id="@+id/spinner_product"
                android:nextFocusDown="@+id/spinner_farmergroup"
                />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/ofis_large_pad"
            android:paddingRight="@dimen/ofis_large_pad"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:background="@drawable/border_white_background"
            android:layout_marginTop="@dimen/ofis_med_pad">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/ofis_small_text"
                android:textColor="@color/ofis_text_field"
                android:text="@string/Farmer_Group_Name"
                android:textStyle="bold" />

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ofis_text_field"
                android:id="@+id/spinner_farmergroup"
                android:nextFocusDown="@+id/spinner_country"
                />

        </LinearLayout>

    </LinearLayout>
</LinearLayout>