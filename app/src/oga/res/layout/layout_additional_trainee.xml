<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/Attendee_layout"
        android:orientation="horizontal"
        android:weightSum="1"
        android:paddingLeft="@dimen/margin_10"
        android:paddingRight="@dimen/margin_10"
        android:layout_marginTop="@dimen/margin_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lblAttendee"
            android:layout_width="match_parent"
            android:layout_weight="0.1"
            android:text="Attendee"
            android:textStyle="bold"
            android:layout_gravity="center_vertical|center_horizontal"
            android:textColor="@color/black_attendee"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/btndeleteAttendee"
            android:layout_width="match_parent"
            android:layout_weight="0.9"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete_item"
            android:layout_gravity="center_vertical|center_horizontal"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/traineeNameContainer"
        android:orientation="horizontal"
        android:weightSum="2"
        android:paddingLeft="@dimen/margin_10"
        android:paddingRight="@dimen/margin_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lblTraineeName"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:text="@string/attendee_name1"
            android:textColor="@color/text_label_attendee"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/etTraineeName"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:hint="@string/attendee_name_hint"
            android:inputType="textCapWords"
            android:textSize="13sp"
            android:paddingLeft="4dp"
            android:textColor="@color/text_label_attendee"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/traineeRelationshipContainer"
        android:orientation="horizontal"
        android:weightSum="2"
        android:paddingLeft="@dimen/margin_10"
        android:paddingRight="@dimen/margin_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lblTraineeRelationship"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:text="@string/attendee_relationship1"
            android:textColor="@color/text_label_attendee"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/spinnerRelationship"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:entries="@array/Trainee_relationships"
            android:textColor="@color/text_label_attendee"
            android:layout_height="wrap_content"/>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/traineeContainer"
        android:orientation="horizontal"
        android:weightSum="2"
        android:paddingLeft="@dimen/margin_10"
        android:paddingRight="@dimen/margin_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lblTraineeAge"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:text="@string/attendee_age"
            android:textColor="@color/text_label_attendee"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/etTraineeAge"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:textSize="13sp"
            android:hint="@string/attendee_hint_age"
            android:inputType="number"
            android:paddingLeft="4dp"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/traineeGenderContainer"
        android:orientation="horizontal"
        android:weightSum="2"
        android:paddingLeft="@dimen/margin_10"
        android:paddingRight="@dimen/margin_10"
        android:layout_marginBottom="@dimen/margin_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lblTraineeGender"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:text="@string/attendee_sex1"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/spinnerGender"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:entries="@array/genders"
            android:textColor="@color/text_label_attendee"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:background="@color/background_attendee"
        android:layout_height="16dp"/>

</LinearLayout>


