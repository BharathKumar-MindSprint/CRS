<?xml version="1.0" encoding="utf-8"?>
<TableRow xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:gravity="center_vertical"
    android:weightSum="10">

    <TextView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/entryId"
        android:visibility="gone"
        android:layout_weight="0"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/entryTitle"
        android:textSize="@dimen/ofis_small_text"
        android:textStyle="bold"
        android:layout_weight="6.5" />
    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/entryInputBox"
        android:layout_gravity="right|top"
        android:layout_weight="3.5"
        android:textColor="@color/ofis_text_field"
        android:textColorHint="@color/ofis_text_field"
        android:textSize="@dimen/ofis_input_field_text"
        android:inputType="number|numberDecimal"
        android:hint="@string/ModuleAnswerHint"
        android:maxLines="1" />

</TableRow>