    <!-- phone numbers dialog -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/phoneNumbersHolder"
        android:orientation="vertical"
        android:layout_margin="@dimen/ofis_input_field_bottom_margin"
        android:background="@drawable/border_white_background"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/ofis_med_pad"
            android:paddingRight="@dimen/ofis_med_pad"
            android:paddingTop="@dimen/ofis_med_pad"
            android:paddingBottom="@dimen/ofis_med_pad"
            android:orientation="horizontal"
            android:weightSum="10"
            android:background="@drawable/bottom_border"
            android:id="@+id/phoneNumbersDialogHeader">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ofis_text_field"
                android:textSize="@dimen/ofis_small_text"
                android:text="@string/PhoneNumbers"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:layout_weight="9"
                android:layout_gravity="start|top"/>

            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/phonenumbersCloseButton"
                app:srcCompat="@drawable/ic_cross_oga"
                android:background="@android:color/transparent"
                android:layout_weight="1"
                android:layout_gravity="end|top"
                android:contentDescription="@string/ofis_switch_text_no"
                android:scaleType="fitStart"
                tools:ignore="VectorDrawableCompat" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/ofis_med_pad"
            android:layout_below="@+id/phoneNumbersDialogHeader"
            android:layout_above="@+id/phoneNumbersDialogFooter">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/phonenumbersouter"
                    android:weightSum="12"
                    android:baselineAligned="false"
                    tools:ignore="UselessParent">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="10.8"
                        android:id="@+id/phonenumbersinner">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="12">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="5"
                                android:text="@string/main_number"
                                android:textSize="@dimen/ofis_small_text"
                                android:textAllCaps="true"
                                android:textStyle="bold"
                                />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="6.5"
                                android:text="@string/PhoneNumberHint"
                                android:textSize="@dimen/ofis_small_text"
                                android:textAllCaps="true"
                                android:textStyle="bold"
                                android:paddingLeft="@dimen/ofis_micro_pad"
                                />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:animateLayoutChanges="true"
                            android:id="@+id/phonenumbers">

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_weight="1.2"
                        android:gravity="bottom|right">

                        <ImageButton
                            android:layout_width="@dimen/small_button_width_height"
                            android:layout_height="@dimen/small_button_width_height"
                            android:id="@+id/addNumber"
                            app:srcCompat="@drawable/ic_ofis_add"
                            android:scaleType="fitXY"
                            android:background="@android:color/transparent"
                            android:layout_marginRight="@dimen/ofis_bottom_section_padding_horizontal"
                            android:layout_marginTop="-23dp"
                            android:layout_marginBottom="14dp"
                            android:contentDescription="@string/Add"
                            tools:ignore="VectorDrawableCompat" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/phoneNumbersDialogFooter"
            android:padding="@dimen/ofis_med_pad"
            android:layout_alignParentBottom="true"
            android:gravity="right">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Save"
                android:id="@+id/phonenumbersSave"
                android:background="@color/ofis_action_button_background"
                android:textColor="@color/ofis_base_font_white"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"/>

        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
