                android:id="@+id/wrapper_farmerPhoto">

                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="112dp"
                    android:paddingTop="@dimen/margin_10"
                    android:contentDescription="@string/Farmer_Photo"
                    android:id="@+id/viewFarmerFarmerPhoto"
                    app:srcCompat="@drawable/empty_farmer_icon"
                    android:layout_marginTop="@dimen/margin_10"
                    android:background="@android:color/transparent"
                    android:scaleType="fitStart"
                    android:layout_alignParentLeft="false"
                    android:layout_alignParentStart="false"
                    android:layout_alignParentBottom="true"/>

                <ImageButton
                    android:layout_width="@dimen/standard_button_width_height"
                    android:layout_height="@dimen/standard_button_width_height"
                    android:id="@+id/farmerPhotoActionButton"
                    android:contentDescription="@string/Camera"
                    app:srcCompat="@drawable/ic_actionbutton_camera"
                    android:layout_alignParentEnd="false"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentRight="true"
                    android:padding="0dp"
                    android:adjustViewBounds="false"
                    android:background="@android:color/transparent"
                    android:scaleType="fitXY"
                    tools:ignore="VectorDrawableCompat" />
            </RelativeLayout>

        </LinearLayout>
    </LinearLayout>
