<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ofis_page_background"
    tools:context="com.olam.digital.ofis.ViewFarmerActivity"
    android:id="@+id/layout_view_farmer"
    tools:ignore="Overdraw">

    <ImageView
        android:id="@+id/topSectionBackground"
        android:layout_width="match_parent"
        android:layout_height="192dp"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:contentDescription="@string/cd_topSectionColour" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="vertical"
        android:paddingTop="@dimen/margin_10"
        android:paddingBottom="@dimen/margin_10"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:layout_below="@+id/topSectionBackground"
        android:id="@+id/linear_viewInfo">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ofis_select_gender"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/genderInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/age"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/ageInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/PhoneNumberHint"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/pNumberInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spinner_partner_default"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/partnerInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spinner_programme_default"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/programInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nationalid"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/nationalIdInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spinner_region_view_farmer"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/regionInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spinner_district_view_farmer"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/districtInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spinner_subdistrict_view_farmer"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/subDistrictInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spinner_place_view_farmer"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/placeInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spinner_farmergroup_view_farmer"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/fgInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spinner_section_view_farmer"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/sectionInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS Co-ordinates"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/gpsInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Number of plots captured"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/plotInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"
                    />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/certificationInfoLayout"
            android:visibility="gone"
            android:weightSum="2">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Certifications"
                    android:textStyle="bold"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/certificationInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingLeft="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Custom error message section -->
    <LinearLayout
        android:id="@+id/layout_notification1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/topSectionBackground"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/consent_layout_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/topSectionBackground"
            android:background="@color/color_secondary_3"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="1dp"
            android:padding="@dimen/home_activity_horizontal_margin"
            android:weightSum="1">

            <ImageView
                android:id="@+id/consent_info_status_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.1"
                android:src="@drawable/ic_info_icon_oga" />

            <TextView
                android:id="@+id/consent_info_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="0.8"
                android:paddingLeft="@dimen/margin_10"
                android:paddingRight="@dimen/margin_10"
                android:text="@string/consent_info"
                android:textColor="@color/info_icon_msg_text" />

            <ImageView
                android:id="@+id/consent_info_close_btn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.1"
                android:src="@drawable/ic_cross_oga" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/topSectionBackground"
            android:background="@color/color_secondary_3"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone"
            android:padding="@dimen/home_activity_horizontal_margin"
            android:weightSum="1">

            <ImageView
                android:id="@+id/info_status_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.1"
                android:src="@drawable/ic_info_icon_oga" />

            <TextView
                android:id="@+id/info_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="0.8"
                android:paddingLeft="@dimen/margin_10"
                android:paddingRight="@dimen/margin_10"
                android:text="@string/national_id_info"
                android:textColor="@color/info_icon_msg_text" />

            <ImageView
                android:id="@+id/info_close_btn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.1"
                android:src="@drawable/ic_cross_oga" />
        </LinearLayout>

    <LinearLayout
        android:id="@+id/plot_layout_notification"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="1"
        android:background="@color/color_secondary_3"
        android:padding="@dimen/home_activity_horizontal_margin"
        android:layout_marginTop="1dp"
        android:visibility="gone"
        android:layout_below="@+id/topSectionBackground"
        android:baselineAligned="false">
        <ImageView
            android:id="@+id/plot_info_status_icon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_info_icon_oga"
            android:layout_weight="0.1"/>

        <TextView
            android:id="@+id/plot_info_text"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:paddingLeft="@dimen/margin_10"
            android:paddingRight="@dimen/margin_10"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="0.8"
            android:text="@string/plot_notification_info"
            android:textColor="@color/black" />
        <ImageView
            android:id="@+id/plot_info_close_btn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_info_icon_oga"
            android:layout_weight="0.1"/>
    </LinearLayout>
        <LinearLayout
            android:id="@+id/cert_layout_notification"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="1"
            android:background="@color/color_secondary_3"
            android:padding="@dimen/home_activity_horizontal_margin"
            android:visibility="gone"
            android:layout_below="@+id/topSectionBackground"
            android:baselineAligned="false">
            <ImageView
                android:id="@+id/cert_info_status_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_info_icon"
                android:layout_weight="0.1"/>

            <TextView
                android:id="@+id/cert_info_text"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingLeft="@dimen/margin_10"
                android:paddingRight="@dimen/margin_10"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="0.8"
                android:text="@string/please_update_the_certification_of_farmer"
                android:textColor="@color/ofis_base_font_white" />
            <ImageView
                android:id="@+id/cert_info_close_btn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_close_info"
                android:layout_weight="0.1"/>
        </LinearLayout>
    </LinearLayout>

    <!-- bottom section -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/layout_notification1"
        android:baselineAligned="false">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:id="@+id/bottomSection"
            android:layout_weight="1"
            tools:ignore="UselessParent">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingLeft="15dp"
                android:paddingRight="0dp"
                android:paddingEnd="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="27dp"
                    android:scaleType="fitStart"
                    android:contentDescription="@string/ofis_cd_info_icon"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imageView2"
                    app:srcCompat="@drawable/ic_task_list_icon"
                    tools:ignore="VectorDrawableCompat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="27dp"
                    android:text="@string/Task_list_header"
                    android:layout_gravity="top"
                    android:id="@+id/textView4"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:textColor="@color/ofis_base_font_dark"
                    android:textSize="@dimen/ofis_med_text"
                    android:gravity="top|center_vertical"/>
            </LinearLayout>

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ofis_page_background"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- top section -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:baselineAligned="false"
        android:paddingBottom="0dp"
        android:layout_margin="0dp">

        <LinearLayout
            android:id="@+id/ll_aggregated_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@color/ofis_non_compliance"
            >

            <ImageView
                android:id="@+id/iv_non_compliance"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingEnd="@dimen/ofis_med_pad"
                android:src="@drawable/non_compliance_flag" />

            <ImageView
                android:id="@+id/iv_compliance"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingEnd="@dimen/ofis_med_pad"
                android:src="@drawable/compliance_flag"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_non_compliance"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:text="@string/non_compliant"
                android:textSize="@dimen/ofis_small_text"
                />

            <TextView
                android:id="@+id/tv_compliance"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:text="@string/compliant"
                android:textSize="@dimen/ofis_small_text"
                android:visibility="gone"
                />

        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/topSection"
            android:baselineAligned="false"
            android:paddingBottom="0dp"
            android:layout_margin="0dp">

            <!-- add farmer white input fields and heading - updated -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="10dp"
                android:paddingTop="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/View_Farmer"
                    android:id="@+id/pageTitle"
                    android:textColor="@color/ofis_base_font_white"
                    android:textSize="@dimen/ofis_large_text"
                    android:paddingRight="0dp"
                    android:paddingEnd="0dp"
                    android:paddingLeft="5dp"
                    android:maxLines="1" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:textSize="@dimen/ofis_input_field_text"
                    android:layout_marginTop="6dp"
                    android:id="@+id/viewFarmerFarmerName"
                    android:textColor="@color/ofis_base_font_dark"
                    android:background="@drawable/edittext_bg_dark"
                    android:padding="@dimen/margin_10"
                    android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                    android:maxLines="1" />


                <TextView
