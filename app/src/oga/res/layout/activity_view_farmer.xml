                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/ofis_large_text"
                    android:id="@+id/viewFarmerInfo"
                    android:textColor="@color/ofis_base_font_white"
                    android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
                    android:text="@string/view_farmer_information"
                    android:drawableEnd="@drawable/ic_drop_down_collapse"
                    android:maxLines="1"
                    android:visibility="gone"/>

            </LinearLayout>
            <!-- end add farmer white input fields and heading -->
            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1.8"
                android:paddingLeft="10dp"
                android:paddingRight="@dimen/activity_horizontal_margin"
