<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:padding="@dimen/activity_horizontal_margin"
        android:orientation="vertical"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:text="@string/about_message"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tv_msg"
            android:layout_width="match_parent"
            android:text="@string/about_message"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_height="wrap_content"/>

        <!--<EditText
            android:id="@+id/et_number_plot"
            android:layout_width="match_parent"
            android:hint="@string/record_polygon_input_hint"
            android:inputType="number"
            android:textSize="14sp"
            android:background="@drawable/edittext_bg_light"
            android:padding="@dimen/margin_10"
            android:textColorHint="@color/icon_grey_palette_2"
            android:textColor="@color/ofis_base_font_dark"
            android:layout_marginTop="@dimen/margin_10"
            android:layout_height="wrap_content"/>-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_10"
                android:animateLayoutChanges="true"
                android:id="@+id/plotList">
            </LinearLayout>

            <LinearLayout
                android:id="@+id/addPlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:text="@string/add_plot"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center|left"
                    android:src="@drawable/ic_ofis_add"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_plot"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingLeft="5dp"
                    android:gravity="center|left"/>

            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/btnLayout"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/btn_no"
                android:layout_width="100dp"
                android:text="@string/cancel"
                android:textColor="@color/ofis_base_font_white"
                android:layout_toLeftOf="@+id/btn_yes"
                android:background="@drawable/btn_secondary_bg"
                android:layout_marginRight="@dimen/margin_10"
                android:layout_height="40dp"/>

            <Button
                android:id="@+id/btn_yes"
                android:layout_alignParentRight="true"
                android:layout_width="100dp"
                android:textColor="@color/ofis_base_font_white"
                android:background="@drawable/btn_primary_bg"
                android:layout_marginLeft="@dimen/margin_10"
                android:text="@string/submit"
                android:layout_height="40dp"/>


        </RelativeLayout>



    </LinearLayout>
</ScrollView>