<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ofis_page_background"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:weightSum="20"
    tools:context="com.olam.digital.ofis.recordpolygon.RecordPolygonActivity">

    <LinearLayout
        android:id="@+id/de_activation_notification"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="1"
        android:background="@color/color_secondary_3"
        android:padding="@dimen/home_activity_horizontal_margin"
        android:visibility="gone"
        android:layout_gravity="center"
        android:layout_below="@+id/linear_viewInfo"
        android:baselineAligned="false">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_info_icon"
            android:layout_weight="0.1"/>

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:paddingLeft="@dimen/margin_10"
            android:paddingRight="@dimen/margin_10"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="0.8"
            android:textSize="16sp"
            android:text="@string/deactivation_pending"
            android:textColor="@color/ofis_base_font_white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/topSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:orientation="vertical"
        android:paddingBottom="@dimen/mapview_magrin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_horizontal_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/farmer_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                    android:background="@drawable/edittext_bg_dark"
                    android:padding="@dimen/margin_10"
                    android:maxLines="1"
                    android:textColor="@color/ofis_base_font_dark"
                    android:textColorHint="@color/icon_grey_palette_2"
                    android:textSize="@dimen/ofis_input_field_text" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight=".5"
                    android:weightSum="5">

                    <Spinner
                        android:id="@+id/plot_number"
                        android:layout_width="78dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ofis_base_font_white" />

                    <TextView
                        android:id="@+id/plot_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                        android:layout_marginLeft="@dimen/ofis_input_field_bottom_margin"
                        android:background="@drawable/edittext_bg_dark"
                        android:padding="@dimen/margin_10"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/ofis_base_font_dark"
                        android:textColorHint="@color/icon_grey_palette_2"
                        android:textSize="@dimen/ofis_input_field_text" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="right|end"
                    android:orientation="horizontal">
                    <ImageButton
                        android:id="@+id/edit_plot_number"
                        android:layout_width="37dp"
                        android:layout_height="37dp"
                        android:layout_gravity="left|end"
                        android:layout_margin="10dp"
                        android:background="@drawable/edit_plot_circular_button"
                        android:onClick="showEditPlotsDialog" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/olam_farmer_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                    android:background="@drawable/edittext_bg_dark"
                    android:padding="@dimen/margin_10"
                    android:maxLines="1"
                    android:textColor="@color/ofis_base_font_dark"
                    android:textColorHint="@color/icon_grey_palette_2"
                    android:textSize="@dimen/ofis_input_field_text" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/ofis_large_pad"
                android:gravity="center">

                <EditText
                    android:id="@+id/plot_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edittext_bg_dark"
                    android:hint="@string/plot_size"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textColor="@color/ofis_base_font_dark"
                    android:textColorHint="@color/icon_grey_palette_2"
                    android:textSize="@dimen/ofis_large_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/plotPinLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="visible">

                <EditText
                    android:id="@+id/plot_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_bg_dark"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:hint="@string/click_gpx_icon_to_record_pin"
                    android:layout_weight="1"
                    android:textColor="@color/ofis_base_font_dark"
                    android:textColorHint="@color/icon_grey_palette_2"
                    android:textSize="@dimen/ofis_large_text"
                    android:editable="false"/>

                <ImageButton
                    android:id="@+id/get_latlngButton"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginLeft="15dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:textSize="@dimen/ofis_med_text"
                    android:visibility="visible"
                    android:background="@drawable/ic_gps_black"/>
            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="5dp">

            <Button
                android:id="@+id/pause_recording"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_thirdcolor"
                android:enabled="false"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_weight=".3"
                android:text="@string/pause_button_text"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_med_text" />

            <Button
                android:id="@+id/start_stop_recording"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_weight=".3"
                android:background="@drawable/selector_consold"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:text="@string/start_logging_button_text"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_med_text" />

            <!--<ImageButton
                android:id="@+id/current_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_actionbutton_location_searching" />-->

            <ImageView
                android:id="@+id/recording_status"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_weight=".3"
                app:srcCompat="@drawable/ic_recording_stopped"
                tools:ignore="VectorDrawableCompat" />

        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/view_map"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/topSection"
        android:layout_marginBottom="5dp"
        android:gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/expander"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/expander_bgrnd"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/areaInfo"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_gravity="left"
                android:layout_weight="1"
                android:paddingLeft="10dp"
                android:textColor="#FF000000"
                android:textSize="@dimen/ofis_large_text" />

            <TextView
                android:id="@+id/speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_weight="0"
                android:textColor="#FF000000"
                android:textSize="@dimen/ofis_large_text" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/mapParent"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_above="@+id/save_recording"
            android:layout_below="@+id/expander"
            android:padding="@dimen/mapview_magrin">

            <org.osmdroid.views.MapView
                android:id="@+id/map"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent" />

            <ImageButton
                android:id="@+id/buttonTrackingMode"
                android:layout_width="@dimen/tracking_mode_button_width_height"
                android:layout_height="@dimen/tracking_mode_button_width_height"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:layout_marginRight="@dimen/mapview_magrin"
                android:layout_marginTop="@dimen/mapview_magrin"
                android:background="@drawable/btn_tracking_off" />

        </RelativeLayout>

        <Button
            android:id="@+id/save_recording"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/selector"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:text="@string/save_button_text"
            android:textColor="@color/ofis_base_font_white"
            android:textSize="@dimen/ofis_med_text" />

        <LinearLayout
            android:id="@+id/ll_de_activation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="20dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:visibility="gone"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ll_flag_deactivation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:gravity="center"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/flag_deactivation_background"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/de_active_plot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:text="@string/flag_for_deactivation"
                    android:textColor="@color/ofis_base_font_white"
                    android:textSize="@dimen/ofis_med_text" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_reset_de_activated_plot"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:gravity="center"
                android:background="@drawable/flag_deactivation_background">

                <TextView
                    android:id="@+id/reset_deactivated_plot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:gravity="center"
                    android:text="@string/reset_deactivation_text"
                    android:textColor="@color/ofis_base_font_white"
                    android:textSize="@dimen/ofis_med_text" />

            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
