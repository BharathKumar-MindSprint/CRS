<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ofis_page_background"
    tools:context="com.olam.digital.ofis.FindFarmerActivity"
    android:id="@+id/layout_find_farmer"
    tools:ignore="Overdraw">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/topSection"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/select_fgsection"
                android:id="@+id/pageTitle"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_large_text"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- business groups -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
            android:layout_marginTop="@dimen/margin_10"
            android:paddingLeft="0dp"
            android:paddingRight="0dp">

            <Spinner
                android:id="@+id/spinner_farmerGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginLeft="0dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/spinner_section"
                android:nextFocusForward="@+id/spinner_section" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                android:visibility="invisible"
                app:srcCompat="@drawable/ic_spinner_hierarchy_arrow"
                android:scaleType="center" />

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/spinner_section"
                android:layout_marginRight="0dp"
                android:layout_marginEnd="0dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"/>

        </LinearLayout>
        <!-- end business groups -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right">

            <Button
                android:id="@+id/downloadData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/ofis_action_button_background"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/download"
                android:textColor="@color/ofis_base_font_white" />


        </LinearLayout>

        </RelativeLayout>



    </LinearLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/bottomSection"
        android:layout_below="@+id/topSection">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/recordCount"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:textColor="@color/black"
            android:textSize="13sp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/downloadedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"/>
    </LinearLayout>

</RelativeLayout>
