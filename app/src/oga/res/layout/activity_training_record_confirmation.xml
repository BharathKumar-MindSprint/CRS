<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    tools:context="com.olam.digital.ofis.TrainingRecordConfirmation">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:id="@+id/topSectionBackground"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:contentDescription="@string/cd_topSectionColour" />

    <!-- bottom section -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/ofis_bottom_section_padding_horizontal"
        android:layout_below="@+id/topSectionBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/ofis_med_pad"
            android:background="@drawable/border_white_background"
            android:weightSum="8"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="3.97"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_course"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/ofis_small_pad"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/courseName"
                    android:text="@string/select_course"
                    android:layout_marginBottom="@dimen/ofis_large_pad"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_training_module"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="@dimen/ofis_small_pad"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_training_module"
                    android:id="@+id/trainingModuleName" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="4.03">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="100dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:id="@+id/trainingPhoto"
                    app:srcCompat="@drawable/ic_add_new_farmer"
                    android:background="@drawable/border"
                    android:contentDescription="@string/Training_Photo"/>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/ofis_bottom_section_padding_horizontal"
            android:background="@drawable/border_white_background"
            android:weightSum="10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="@dimen/ofis_med_pad"
                android:weightSum="8"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="5"
                    android:layout_height="wrap_content"
                    android:id="@+id/transactionItemsHeader"
                    android:text="@string/TrainingAttendees"
                    android:textAllCaps="true"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="end"
                    android:id="@+id/trainingAttendeesTotal"
                    android:text="0"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:layout_weight="8"
                android:paddingBottom="@dimen/ofis_list_itemseparator"
                android:layout_marginStart="@dimen/margin_10"
                android:layout_marginEnd="@dimen/margin_10"
                android:layout_marginBottom="@dimen/margin_10"
                android:weightSum="10">

                <!-- Farmer List -->
                <LinearLayout
                    android:id="@+id/farmer_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/btn_white_rec"
                    android:layout_weight="9"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_width_height"
                            android:src="@drawable/attendee_icon"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/primary_farmer"
                            android:paddingStart="@dimen/margin_10"
                            android:textColor="@color/ofis_base_font_dark"
                            android:textSize="@dimen/ofis_med_text"
                            android:textStyle="bold"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="8" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_width_height"
                            android:background="@color/light_orange"
                            android:gravity="center"
                            android:padding="4dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/toggle_icon_farmer"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_arrow_down"
                                card_view:tint="@color/ic_orange" />
                        </LinearLayout>


                    </LinearLayout>

                    <ListView
                        android:id="@+id/list_farmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="0dp" />

                </LinearLayout>

                <!-- Stakeholder List -->
                <LinearLayout
                    android:id="@+id/stakeholder_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/btn_white_rec"
                    android:layout_marginTop="@dimen/ofis_bottom_section_padding_horizontal"
                    android:layout_weight="1"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_width_height"
                            android:src="@drawable/attendee_icon"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/stakeholder_attendee"
                            android:paddingStart="@dimen/margin_10"
                            android:textColor="@color/ofis_base_font_dark"
                            android:textSize="@dimen/ofis_med_text"
                            android:textStyle="bold"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="8" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_width_height"
                            android:background="@color/light_orange"
                            android:gravity="center"
                            android:padding="4dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/toggle_icon_stakeholder"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_arrow_down"
                                card_view:tint="@color/ic_orange" />
                        </LinearLayout>


                    </LinearLayout>

                    <ListView
                        android:id="@+id/list_stakeholder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="0dp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="right"
                android:layout_weight="1"
                android:paddingTop="@dimen/ofis_small_pad"
                android:paddingRight="@dimen/ofis_small_pad">
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/text_button_width_height"
                    android:text="@string/confirm_training_record"
                    android:textAllCaps="true"
                    android:background="@color/ofis_action_button_background"
                    android:textColor="@color/ofis_base_font_white"
                    android:textSize="@dimen/ofis_micro_text"
                    android:paddingLeft="@dimen/ofis_med_pad"
                    android:paddingRight="@dimen/ofis_med_pad"
                    android:id="@+id/confirmTrainingRecord"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- top section -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/topSection"
        android:baselineAligned="false"
        android:paddingBottom="0dp"
        android:layout_margin="0dp"
        android:weightSum="10">

        <!-- page title -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="8"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/activity_vertical_margin">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/TrainingRecordConfirmationTitle"
                android:id="@+id/TrainingRecordConfirmationTitle"
                android:textColor="@color/ofis_base_font_white"
                android:paddingRight="0dp"
                android:paddingLeft="5dp"
                android:textSize="@dimen/ofis_large_text"
                android:maxLines="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/TrainingRecordConfirmationSubTitle"
                android:id="@+id/TrainingRecordConfirmationSubTitle"
                android:textColor="@color/ofis_base_font_white"
                android:paddingRight="0dp"
                android:paddingLeft="5dp"
                android:textSize="@dimen/ofis_small_text"
                tools:ignore="RtlHardcoded"
                android:maxLines="1" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
