<?xml version="1.0" encoding="utf-8"?>
<!-- top section -->
<LinearLayout android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/topSectionWrapper"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/topSection"
        android:paddingTop="@dimen/home_activity_vertical_margin"
        android:paddingBottom="@dimen/ofis_small_pad"
        android:paddingLeft="@dimen/home_activity_horizontal_margin"
        android:paddingRight="@dimen/home_activity_horizontal_margin">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            card_view:cardBackgroundColor="@color/ofis_home_screen_actions_background"
            card_view:cardElevation="@dimen/ofis_elevation_height"
            card_view:cardUseCompatPadding="true">
            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/ofis_add_new_farmer"
                android:id="@+id/AddNewFarmer"
                android:textColor="@color/ofis_base_font_white"
                android:drawableTop="@drawable/ic_add_new_farmer"
                android:drawablePadding="10dp"
                android:paddingLeft="@dimen/ofis_med_pad"
                android:paddingRight="@dimen/ofis_med_pad"
                android:textSize="@dimen/ofis_micro_text"
                android:background="@android:color/transparent"
                tools:ignore="ButtonStyle"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            card_view:cardBackgroundColor="@color/ofis_home_screen_actions_background"
            card_view:cardElevation="@dimen/ofis_elevation_height"
            android:layout_marginLeft="@dimen/ofis_small_pad"
            card_view:cardUseCompatPadding="true">
            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/ofis_farmer_and_surveys"
                android:id="@+id/CompleteQuestionnaireModule"
                android:textColor="@color/ofis_base_font_white"
                android:drawableTop="@drawable/ic_complete_questionnaire_module"
                android:drawablePadding="10dp"
                android:textSize="@dimen/ofis_micro_text"
                android:paddingLeft="@dimen/ofis_med_pad"
                android:paddingRight="@dimen/ofis_med_pad"
                android:background="@android:color/transparent"
                tools:ignore="ButtonStyle"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvSupplierAndSurvey"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            card_view:cardBackgroundColor="@color/ofis_home_screen_actions_background"
            card_view:cardElevation="@dimen/ofis_elevation_height"
            android:layout_marginLeft="@dimen/ofis_small_pad"
            card_view:cardUseCompatPadding="true">
            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/supplier_and_surveys"
                android:id="@+id/SupplierAndSurveys"
                android:textColor="@color/ofis_base_font_white"
                android:drawableTop="@drawable/ic_supplier_and_survey"
                android:drawablePadding="10dp"
                android:textSize="@dimen/ofis_micro_text"
                android:paddingLeft="@dimen/ofis_med_pad"
                android:paddingRight="@dimen/ofis_med_pad"
                android:background="@android:color/transparent"
                tools:ignore="ButtonStyle"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/middleSection"
        android:paddingBottom="@dimen/ofis_small_pad"
        android:paddingLeft="@dimen/home_activity_horizontal_margin"
        android:paddingRight="@dimen/home_activity_horizontal_margin"
        android:paddingTop="0dp">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginTop="-4dp"
            card_view:cardBackgroundColor="@color/ofis_home_screen_actions_background"
            card_view:cardElevation="@dimen/ofis_elevation_height"
            card_view:cardUseCompatPadding="true">
            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/ofis_add_infrastructure"
                android:id="@+id/AddSocialInfrastructure"
                android:textColor="@color/ofis_base_font_white"
                android:drawableTop="@drawable/ic_add_poi"
                android:drawablePadding="10dp"
                android:textSize="@dimen/ofis_micro_text"
                android:background="@android:color/transparent"
                tools:ignore="ButtonStyle"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
            card_view:cardElevation="@dimen/ofis_elevation_height"
            android:layout_marginTop="-4dp"
            card_view:cardUseCompatPadding="true"
            android:id="@+id/downloadSurveyWrapper"
            android:layout_marginLeft="@dimen/ofis_small_pad">
            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/download_survey_data"
                android:id="@+id/downloadSurveyData"
                android:textColor="@color/ofis_base_font_white"
                android:drawableTop="@drawable/ic_surveylist"
                android:drawablePadding="10dp"
                android:textSize="@dimen/ofis_micro_text"
                android:paddingLeft="@dimen/ofis_med_pad"
                android:paddingRight="@dimen/ofis_med_pad"
                android:background="@android:color/transparent"
                tools:ignore="ButtonStyle"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
            card_view:cardElevation="@dimen/ofis_elevation_height"
            android:layout_marginTop="-4dp"
            card_view:cardUseCompatPadding="true"
            android:id="@+id/cvDistributionModule"
            android:layout_marginLeft="@dimen/ofis_small_pad">

            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/distribution_module"
                android:id="@+id/btnDistribution"
                android:textColor="@color/ofis_base_font_white"
                android:drawableTop="@drawable/distribution_module_icon"
                android:drawablePadding="15dp"
                android:textSize="@dimen/ofis_micro_text"
                android:background="@android:color/transparent"
                tools:ignore="ButtonStyle"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/ll_download_FarmPlanSection"
        android:paddingBottom="@dimen/ofis_small_pad"
        android:paddingLeft="@dimen/home_activity_horizontal_margin"
        android:paddingRight="@dimen/home_activity_horizontal_margin"
        android:paddingTop="0dp">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
            card_view:cardElevation="@dimen/ofis_elevation_height"
            android:layout_marginTop="-4dp"
            card_view:cardUseCompatPadding="true"
            android:id="@+id/recordTrainingWrapper">
            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/record_training_button"
                android:id="@+id/RecordFarmerTraining"
                android:textColor="@color/ofis_base_font_white"
                android:drawableTop="@drawable/ic_record_training"
                android:drawablePadding="10dp"
                android:textSize="@dimen/ofis_micro_text"
                android:background="@android:color/transparent"
                tools:ignore="ButtonStyle"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:id="@+id/captureLocationWrapper"
            card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
            card_view:cardElevation="@dimen/ofis_elevation_height"
            android:layout_marginTop="-4dp"
            card_view:cardUseCompatPadding="true"
            android:layout_marginLeft="4dp">

            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/capture_my_location_button_text"
                android:id="@+id/captureLocation"
                android:textColor="@color/ofis_base_font_white"
                android:drawableTop="@drawable/ic_captureloc"
                android:drawablePadding="10dp"
                android:textSize="@dimen/ofis_micro_text"
                android:background="@android:color/transparent"
                tools:ignore="ButtonStyle"
                android:paddingBottom="16dp"
                android:paddingTop="16dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:id="@+id/cardview_downloadFarmplan"
            android:layout_weight="1"
            card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
            card_view:cardElevation="@dimen/ofis_elevation_height"
            android:layout_marginTop="-4dp"
            card_view:cardUseCompatPadding="true"
            android:layout_marginLeft="@dimen/ofis_small_pad">
            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:id="@+id/DownloadFarmPlan"
                android:text="@string/download_farm_plan"
                android:textColor="@color/ofis_base_font_white"
                android:drawableTop="@drawable/ic_baseline_downloadnew"
                android:drawablePadding="10dp"
                android:textSize="@dimen/ofis_micro_text"
                android:background="@android:color/transparent"
                tools:ignore="ButtonStyle"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />
        </androidx.cardview.widget.CardView>


    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/home_activity_vertical_margin"
        android:layout_marginLeft="@dimen/home_activity_horizontal_margin"
        android:layout_marginRight="@dimen/home_activity_horizontal_margin"
        android:layout_marginTop="0dp"
        card_view:cardBackgroundColor="@color/sub_task_header_bg"
        card_view:cardElevation="@dimen/ofis_elevation_height"
        card_view:cardUseCompatPadding="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/itemlistBar"
            android:paddingTop="@dimen/home_activity_vertical_margin"
            android:paddingBottom="@dimen/home_activity_vertical_margin"
            android:paddingLeft="@dimen/home_activity_vertical_margin"
            android:paddingRight="@dimen/home_activity_vertical_margin">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ofis_small_pad"
                android:paddingRight="@dimen/ofis_micro_pad"
                android:text="@string/Modules_to_submit"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_med_text"
                tools:ignore="RtlHardcoded" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:background="@drawable/itemlist_total_background"
                android:id="@+id/networkQueueCount"
                android:text="0"
                android:textColor="@color/ofis_base_font_dark"
                android:textSize="@dimen/ofis_small_text"
                android:gravity="center"
                android:layout_marginTop="@dimen/ofis_micro_pad"
                android:layout_toRightOf="@+id/textView4"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:minEms="2"
                android:layout_marginLeft="@dimen/ofis_small_pad"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:id="@+id/syncAll"
                android:layout_marginTop="@dimen/ofis_micro_pad"
                android:contentDescription="@string/ofis_cd_submit_all_icon"
                card_view:srcCompat="@drawable/ic_upload_list_white"
                android:scaleType="fitXY"
                android:layout_alignParentRight="true"
                android:background="@android:color/transparent"
                tools:ignore="VectorDrawableCompat" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/nomodulestosubmittext"
        android:paddingTop="@dimen/ofis_small_pad"
        android:paddingBottom="@dimen/ofis_small_pad"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:textSize="@dimen/ofis_input_field_text"
        android:textColor="@color/ofis_text_field" />

</LinearLayout>