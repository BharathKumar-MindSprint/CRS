<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/list_item"
    android:paddingLeft="@dimen/ofis_med_pad"
    android:paddingRight="@dimen/ofis_med_pad"
    android:paddingTop="@dimen/ofis_list_itemseparator"
    android:paddingBottom="@dimen/ofis_list_itemseparator">


    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:id="@+id/rowlin"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:weightSum="8"
        tools:ignore="UselessParent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:id="@+id/itemTextContainer"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_weight="7">

            <TextView
                android:id="@+id/trainingAttendeeId"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Farmer_Name"
                android:id="@+id/attendeeName"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ofis_base_font_dark"
                android:textSize="@dimen/ofis_med_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/ofis_small_pad">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/criterion_attended"
                        android:textColor="@color/ofis_list_item_subtitle"
                        android:paddingLeft="@dimen/ofis_med_pad"
                        android:textSize="@dimen/ofis_small_text"
                        android:visibility="gone"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/criterion_passed"
                        android:textColor="@color/ofis_list_item_subtitle"
                        android:background="@drawable/left_border"
                        android:paddingLeft="@dimen/ofis_med_pad"
                        android:layout_marginLeft="@dimen/ofis_med_pad"
                        android:textSize="@dimen/ofis_small_text"
                        android:visibility="gone"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/ofis_small_pad">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/criterion_prescore"
                        android:textColor="@color/ofis_list_item_subtitle"
                        android:textSize="@dimen/ofis_small_text"
                        android:visibility="gone"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/criterion_postscore"
                        android:textColor="@color/ofis_list_item_subtitle"
                        android:background="@drawable/left_border"
                        android:paddingLeft="@dimen/ofis_med_pad"
                        android:layout_marginLeft="@dimen/ofis_med_pad"
                        android:textSize="@dimen/ofis_small_text"
                        android:visibility="gone"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/criterion_score"
                    android:textColor="@color/ofis_list_item_subtitle"
                    android:textSize="@dimen/ofis_small_text"
                    android:layout_marginBottom="@dimen/ofis_small_pad"
                    android:visibility="gone"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/criterion_percentage"
                    android:textColor="@color/ofis_list_item_subtitle"
                    android:textSize="@dimen/ofis_small_text"
                    android:layout_marginBottom="@dimen/ofis_small_pad"
                    android:visibility="gone"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/criterion_grade"
                    android:textColor="@color/ofis_list_item_subtitle"
                    android:textSize="@dimen/ofis_small_text"
                    android:layout_marginBottom="@dimen/ofis_small_pad"
                    android:visibility="gone"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/addAttndeesLayout"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/addTrainingAttendeesIv"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/margin_10"
                android:background="@android:color/transparent"
                android:contentDescription="@string/Add"
                android:padding="5dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_ofis_add" />

            <TextView
                android:id="@+id/addTrainingAttendeesTv1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/addTrainingAttendeesIv"
                android:background="@android:color/transparent"
                android:text="@string/add_edit_attendee"
                android:gravity="center"
                android:textSize="12sp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="5dp"
                android:textColor="@color/btnColorPrimary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:id="@+id/deleteItemWrapper"
            android:background="@drawable/left_border"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:gravity="center">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:id="@+id/deleteItem"
                app:srcCompat="@drawable/ic_delete_icon_stake1"
                android:contentDescription="@string/Delete_Item"
                android:layout_gravity="center_vertical|center_horizontal" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvViewAddendees"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/view_attendees_count"
        android:textColor="@color/colorPrimary"
        android:textStyle="bold"
        android:layout_marginLeft="@dimen/margin_10"
        android:textSize="@dimen/ofis_small_text" />

</LinearLayout>


