<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"> <!-- we need a top level one here so we can first linear -->

  <LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/additional_school"
    android:background="@android:color/transparent"
      tools:ignore="UselessParent">

      <LinearLayout
          android:orientation="vertical"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingLeft="@dimen/ofis_large_pad"
          android:paddingRight="@dimen/ofis_large_pad"
          android:paddingBottom="@dimen/activity_vertical_margin"
          android:paddingTop="@dimen/activity_vertical_margin"
          android:background="@drawable/border_white_background"
          android:layout_marginTop="@dimen/ofis_med_pad">

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textColor="@color/ofis_text_field"
              android:textSize="@dimen/ofis_small_text"
              android:text="@string/Capacity"
              android:textStyle="bold"
              />
          <EditText
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="number"
              android:id="@+id/editText_capacity"
              android:textColor="@color/ofis_text_field"
              android:textSize="@dimen/ofis_input_field_text"
              android:textColorHint="@color/ofis_text_field"
              android:hint="@string/ModuleAnswerHint"
              android:nextFocusDown="@+id/editText_numberOfClassRooms"/>

      </LinearLayout>

      <LinearLayout
          android:orientation="vertical"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingLeft="@dimen/ofis_large_pad"
          android:paddingRight="@dimen/ofis_large_pad"
          android:paddingBottom="@dimen/activity_vertical_margin"
          android:paddingTop="@dimen/activity_vertical_margin"
          android:background="@drawable/border_white_background"
          android:layout_marginTop="@dimen/ofis_med_pad">

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textSize="@dimen/ofis_small_text"
              android:textColor="@color/ofis_text_field"
              android:text="@string/Number_of_Classrooms"
              android:textStyle="bold"
              />
          <EditText
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="number"
              android:id="@+id/editText_numberOfClassRooms"
              android:textColor="@color/ofis_text_field"
              android:textSize="@dimen/ofis_input_field_text"
              android:textColorHint="@color/ofis_text_field"
              android:hint="@string/ModuleAnswerHint"
              android:nextFocusDown="@+id/genderspinner"/>

      </LinearLayout>

      <LinearLayout
          android:orientation="vertical"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingLeft="@dimen/ofis_large_pad"
          android:paddingRight="@dimen/ofis_large_pad"
          android:paddingBottom="@dimen/activity_vertical_margin"
          android:paddingTop="@dimen/activity_vertical_margin"
          android:background="@drawable/border_white_background"
          android:layout_marginTop="@dimen/ofis_med_pad">

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textSize="@dimen/ofis_small_text"
              android:textColor="@color/ofis_text_field"
              android:text="@string/ofis_select_gender"
              android:textStyle="bold"
              />
          <Spinner
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:id="@+id/genderspinner"
              android:textColor="@color/ofis_text_field"
              android:entries="@array/genders_2"
              android:nextFocusDown="@+id/educationlevels"/>

      </LinearLayout>

      <LinearLayout
          android:orientation="vertical"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingLeft="@dimen/ofis_large_pad"
          android:paddingRight="@dimen/ofis_large_pad"
          android:paddingBottom="@dimen/activity_vertical_margin"
          android:paddingTop="@dimen/activity_vertical_margin"
          android:background="@drawable/border_white_background"
          android:layout_marginTop="@dimen/ofis_med_pad">

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textSize="@dimen/ofis_input_field_text"
              android:textColor="@color/ofis_text_field"
              android:text="@string/ofis_select_education_level"
              android:textStyle="bold"
              />

          <Spinner
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:id="@+id/educationlevels"
              android:textColor="@color/ofis_text_field"
              android:entries="@array/educationlevels"
              android:nextFocusDown="@+id/school_yearOpened"
              />

      </LinearLayout>

      <LinearLayout
          android:orientation="vertical"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingLeft="@dimen/ofis_large_pad"
          android:paddingRight="@dimen/ofis_large_pad"
          android:paddingBottom="@dimen/activity_vertical_margin"
          android:paddingTop="@dimen/activity_vertical_margin"
          android:background="@drawable/border_white_background"
          android:layout_marginTop="@dimen/ofis_med_pad">

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textSize="@dimen/ofis_small_text"
              android:textColor="@color/ofis_text_field"
              android:text="@string/ofis_select_year_opened"
              android:textStyle="bold"
              />

            <Spinner
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:id="@+id/school_yearOpened"
              android:textColor="@color/ofis_text_field"
              android:nextFocusDown="@+id/spinner_country"
             />

      </LinearLayout>
    </LinearLayout>
</LinearLayout>