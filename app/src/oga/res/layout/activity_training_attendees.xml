<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ofis_page_background"
    tools:context="com.olam.digital.ofis.TrainingAttendees"
    android:focusableInTouchMode="true"
    tools:ignore="Overdraw">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/topSection"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin">

        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Select_Attendees"
                android:id="@+id/textview_StartA"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_large_text"
                android:layout_centerInParent="true"
                android:layout_alignParentLeft="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/selectedText"
                android:text="@string/selected"
                android:textColor="@color/ofis_base_font_white"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="@dimen/ofis_small_text"
                android:layout_toLeftOf="@+id/attendeeCount"
                android:layout_centerInParent="true"
                tools:ignore="RelativeOverlap" />

            <TextView
                android:id="@+id/attendeeCount"
                android:layout_width="@dimen/standard_button_width_height"
                android:layout_height="@dimen/standard_button_width_height"
                android:layout_alignParentRight="true"
                android:layout_centerInParent="true"
                android:layout_marginLeft="@dimen/ofis_small_pad"
                android:background="@drawable/itemlist_total_background"
                android:gravity="center"
                android:padding="0dp"
                android:text="0"
                android:textStyle="bold"
                android:textColor="@color/btnColorPrimary"
                android:textSize="@dimen/ofis_small_text"
                tools:ignore="HardcodedText" />

        </RelativeLayout>

        <!-- business groups -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="5dp"
            android:paddingLeft="0dp"
            android:layout_marginTop="5dp"
            android:paddingRight="0dp">

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/spinner_farmerGroup"
                android:layout_weight="1"
                android:layout_marginLeft="0dp"
                android:layout_marginStart="0dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/spinner_section"
                android:nextFocusForward="@+id/spinner_section"
                />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                app:srcCompat="@drawable/ic_spinner_hierarchy_arrow"
                android:scaleType="center" />

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/spinner_section"
                android:layout_marginRight="0dp"
                android:layout_marginEnd="0dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/spinner_stakeholder_role"
                android:nextFocusForward="@+id/spinner_stakeholder_role"
                />

        </LinearLayout>
        <!-- end business groups -->
        <Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/spinner_stakeholder_role"
            android:layout_marginLeft="0dp"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="5dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="12">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8"
                android:weightSum="12">

                <EditText
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:inputType="textCapWords"
                android:textColorHint="@color/icon_grey_palette_2"
                android:textSize="@dimen/ofis_input_field_text"
                android:id="@+id/findFarmerSearchBox"
                android:layout_weight="10"
                android:textColor="@color/ofis_base_font_dark"
                    android:drawableRight="@drawable/ic_searchimg"
                    android:drawablePadding="@dimen/margin_10"
                android:hint="@string/Attendee_Name"
                android:background="@drawable/edittext_bg_dark"/>

                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:id="@+id/imageButton"
                    android:layout_weight="2"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_searchimg"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/Search" />

            </LinearLayout>

            <Button
                android:layout_width="0dp"
                android:layout_height="@dimen/text_button_width_height"
                android:layout_weight="4"
                android:text="@string/save_selected_attendees"
                android:textAllCaps="true"
                android:background="@color/btnColorPrimary"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_micro_text"
                android:id="@+id/addSelectedAttendees" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/bottomSection"
        android:layout_below="@+id/topSection">

        <ListView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/list"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"/>

    </LinearLayout>

</RelativeLayout>
