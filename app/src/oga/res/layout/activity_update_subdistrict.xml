<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clmrs_bg"
    android:padding="@dimen/activity_vertical_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/ofis_large_pad"
        android:paddingRight="@dimen/ofis_large_pad"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:background="@drawable/border_white_background"
        android:layout_marginTop="@dimen/ofis_med_pad"
        android:orientation="vertical">



        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ofis_med_pad">

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/spinner_country"
                android:hint="@string/Country"
                android:layout_weight="1"
                android:nextFocusDown="@+id/spinner_region" />

            <ImageView
                android:layout_width="wrap_content"
                android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/ic_spinner_hierarchy_arrow"
                android:scaleType="center"
                android:id="@+id/haCountry"
                android:visibility="invisible"/>

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/spinner_region"
                android:layout_weight="1"
                android:nextFocusDown="@+id/spinner_district"/>

        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/spinner_district"
                android:layout_weight="1"
                android:nextFocusDown="@+id/spinner_place"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                app:srcCompat="@drawable/ic_spinner_hierarchy_arrow"
                android:scaleType="center"
                android:id="@+id/haDistrict"
                android:visibility="invisible"/>

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/spinner_subdistrict"
                android:layout_weight="1" />

        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/margin_10"
            android:layout_height="wrap_content">

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/spinner_place"
                android:layout_weight="1"
                android:nextFocusDown="@+id/spinner_place"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                app:srcCompat="@drawable/ic_spinner_hierarchy_arrow"
                android:scaleType="center"
                android:visibility="invisible"
                android:id="@+id/haSubDistrict" />

            <Spinner
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:id="@+id/newPlaceName"
                android:hint="@string/New_place_name"
                android:textColor="@color/ofis_text_field"
                android:textSize="@dimen/ofis_input_field_text"
                android:visibility="gone"
                android:layout_marginTop="@dimen/ofis_med_pad"/>
        </LinearLayout>

    </LinearLayout>


    <Button
        android:id="@+id/updateSubdistrict"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_gravity="center"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:background="@color/btn_primary_background"
        android:gravity="center"
        android:text="@string/update"
        android:textAllCaps="true"
        android:textColor="@color/ofis_base_font_white"
        android:textSize="20dp"
        android:textStyle="bold" />

</RelativeLayout>