<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/white" />
                    <stroke android:width="2px" android:color="@color/colorPrimary" />
                    <corners android:radius="5dp" />
                </shape>
            </item>

            <item android:gravity="right|center_vertical" android:drawable="@drawable/ic_icon_dropdown"
                android:right="@dimen/margin_10" android:top="10dp" android:bottom="15dp"/>

        </layer-list>
    </item>

</selector>