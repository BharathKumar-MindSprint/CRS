<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingLeft="15dp"
    android:paddingBottom="11dp"
    android:paddingRight="14dp"
    android:background="@drawable/background_rounded_corner">

    <TextView
        android:id="@+id/popup_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/flag_for_de_activation"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/header_color"
        android:visibility="visible"
        />

    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/de_activation_reason_message"
        android:layout_marginTop="@dimen/activity_horizontal_margin"
        android:textColor="@color/light_grey"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/deactivate_reason"
        android:layout_marginTop="@dimen/ofis_large_pad"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/ofis_large_pad"
        android:textColor="@color/header_color"
        android:visibility="visible"
        />

    <EditText
        android:id="@+id/etDeActivationReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:background="@drawable/background_rounded_corner"
        android:hint="@string/deactivation_reason"
        android:maxLines="5"
        android:maxLength="200"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls"
        android:scrollHorizontally="false"
        android:inputType="textMultiLine"
        android:gravity="top"
        android:singleLine="false"
        android:textColorHint="@color/icon_grey_palette_2"/>

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="20dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/button_no"
            style="?android:attr/negativeButtonText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:background="@drawable/btn_white_rounded_corner"
            android:text="@string/cancel"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/button_yes"
            style="?android:attr/positiveButtonText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary_rounded_corner"
            android:text="@string/done"
            android:textColor="@color/ofis_base_font_white"/>
    </LinearLayout>

</LinearLayout>