<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/ofis_list_itemseparator"
    android:paddingBottom="@dimen/ofis_list_itemseparator"
    android:paddingLeft="15dp"
    android:layout_marginHorizontal="15dp"
    android:background="@drawable/list_item"
    android:paddingRight="15dp"
    android:id="@+id/clSupplierList">

    <TextView
        android:id="@+id/supplierName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Farmer_Name"
        android:textColor="@color/ofis_base_font_dark"
        android:textSize="@dimen/ofis_med_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/supplierId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ofis_list_item_subtitle"
        android:textSize="@dimen/ofis_small_text"
        android:text="@string/supplier_id"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/supplierName"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>