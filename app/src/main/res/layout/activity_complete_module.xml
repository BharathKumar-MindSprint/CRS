<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/layout_complete_module"
    android:background="@color/ofis_page_background"
    tools:context="com.olam.digital.ofis.CompleteModuleActivity"
    android:focusableInTouchMode="true"
    tools:ignore="Overdraw">

<!--    <ImageView-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="70dp"-->
<!--        android:id="@+id/topSectionBackground"-->
<!--        android:background="@color/ofis_farmer_screen_actions_background"-->
<!--        android:contentDescription="@string/cd_topSectionColour" />-->

    <!-- bottom section -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topSection"
        >

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/scrollView"
            tools:ignore="UselessParent">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/bottomSection"
                android:paddingLeft="@dimen/activity_horizontal_margin"
                android:paddingRight="@dimen/activity_horizontal_margin"
                android:paddingBottom="@dimen/activity_vertical_margin"
                android:paddingTop="@dimen/activity_vertical_margin">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/view_surveyans"
                    android:paddingLeft="@dimen/ofis_large_pad"
                    android:paddingRight="@dimen/ofis_large_pad"
                    android:paddingBottom="@dimen/ofis_large_pad"
                    android:paddingTop="@dimen/ofis_large_pad"
                    android:background="@drawable/border_white_background"
                    android:layout_marginBottom="@dimen/ofis_large_pad">

                    <ImageButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/Save"
                        android:paddingLeft="@dimen/ofis_large_pad"
                        app:srcCompat="@drawable/ic_foldermax" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center|left"
                        android:textStyle="italic"
                        android:paddingLeft="30dp"
                        android:textSize="@dimen/ofis_small_text"
                        android:text="@string/view_recent_survey_data"
                        android:textColor="#A0C800" />
                </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/questionsSection"/>

                    <RelativeLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/footer"
                        android:paddingBottom="@dimen/activity_vertical_margin"
                        android:paddingTop="@dimen/activity_vertical_margin">

                        <Button
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/prevSubmodule"
                            android:background="@color/ofis_action_button_background"
                            android:text="@string/ModuleBackButton"
                            android:textColor="@color/ofis_base_font_white"
                            android:paddingLeft="15dp"
                            android:paddingRight="15dp"/>

                        <Button
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/nextSaveSubmodule"
                            android:background="@color/ofis_action_button_background"
                            android:text="@string/ModuleNextButton"
                            android:textColor="@color/ofis_base_font_white"
                            android:paddingLeft="15dp"
                            android:paddingRight="15dp"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentEnd="true"
                            tools:ignore="RelativeOverlap" />

                    </RelativeLayout>

            </LinearLayout>

        </ScrollView>
    </LinearLayout>


    <!-- top section -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/topSection"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:baselineAligned="false"
        android:paddingBottom="0dp"
        android:layout_margin="0dp"
        android:weightSum="10">

        <!-- module and submodule title -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="8"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/activity_vertical_margin">

            <TextView
                android:id="@+id/completeModuleModuleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="5dp"
                android:paddingRight="0dp"
                android:text="@string/ModuleTitle"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_large_text" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ModuleSubTitle"
                android:id="@+id/completeModuleSubModuleTitle"
                android:textColor="@color/ofis_base_font_white"
                android:layout_marginTop="@dimen/mapview_magrin"
                android:paddingRight="0dp"
                android:paddingLeft="5dp"
                android:textSize="@dimen/ofis_small_text"
                tools:ignore="RtlHardcoded" />


        </LinearLayout>
        <!-- end module and submodule title -->
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:paddingTop="25dp"
            android:paddingLeft="0dp"
            android:paddingRight="10dp">

            <ImageButton
                android:id="@+id/saveProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                android:background="@android:color/transparent"
                android:contentDescription="@string/Save"
                android:scaleType="center"
                app:srcCompat="@drawable/ic_actionbutton_save" />

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
