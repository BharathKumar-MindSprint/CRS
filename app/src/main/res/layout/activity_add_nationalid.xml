<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ofis_page_background"
    tools:context="com.olam.digital.ofis.AddFarmerActivity"
    tools:ignore="Overdraw">

    <!-- national id implementation   -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/ofis_large_pad"
        android:paddingRight="@dimen/ofis_large_pad"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:background="@drawable/border_white_background"
        android:layout_marginTop="@dimen/ofis_med_pad"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="10.8"

            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ofis_text_field"
                android:textSize="@dimen/ofis_small_text"
                android:text="@string/nationalid"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/ofis_med_pad"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="10.8"
                android:visibility="gone"
                android:orientation="horizontal">



                <LinearLayout
                    android:layout_width="105dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ofis_text_field"
                        android:textSize="@dimen/ofis_small_text"
                        android:text="@string/nationalid"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/ofis_med_pad"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/nationalidphoto"
                            android:layout_width="74dp"
                            android:tooltipText="@string/captureid"
                            android:layout_height="94dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="bottom|end">
                            <ImageButton
                                android:layout_width="@dimen/button_width_height"
                                android:layout_height="@dimen/button_width_height"
                                android:id="@+id/nidphotoActionButton"
                                android:contentDescription="@string/Camera"
                                android:src="@drawable/ic_actionbutton_camera"
                                android:layout_marginLeft="5dp"
                                android:adjustViewBounds="false"
                                android:background="@android:color/transparent"
                                android:scaleType="fitXY" />
                        </LinearLayout>
                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:paddingTop="10dp"
                    android:paddingBottom="5dp">


                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/idtypespinner"
                        android:hint="@string/idtype"
                        android:layout_weight="1"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                        android:layout_marginTop="@dimen/ofis_input_field_bottom_margin"
                        android:nextFocusDown="@+id/spinner_region" />

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:id="@+id/nidnumber"
                        android:textSize="@dimen/ofis_input_field_text"
                        android:hint="@string/nationalidno"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                        android:layout_marginTop="@dimen/ofis_input_field_bottom_margin"/>

                </LinearLayout>



            </LinearLayout>
            <LinearLayout
                android:layout_weight="10.8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:animateLayoutChanges="true"
                android:id="@+id/nationalids">

            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="@dimen/ofis_bottom_section_padding_vertical"
            android:layout_marginBottom="2dp"
            android:gravity="bottom|end">

            <ImageButton
                android:id="@+id/addnid"
                android:layout_width="@dimen/small_button_width_height"
                android:layout_height="@dimen/small_button_width_height"
                android:scaleType="fitXY"
                android:layout_gravity="right|center"
                android:background="@android:color/transparent"
                android:contentDescription="@string/Add"
                android:src="@drawable/ic_ofis_add" />

        </LinearLayout>
    </LinearLayout>

    <android.support.v7.widget.AppCompatButton
        android:id="@+id/save"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_gravity="center"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/btn_bg_add_child"
        android:gravity="center"
        android:text="@string/Save"
        android:textAllCaps="true"
        android:textColor="@color/ofis_base_font_white"
        android:textSize="20dp"
        android:textStyle="bold" />
</LinearLayout>