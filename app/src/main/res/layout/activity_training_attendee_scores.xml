<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:focusableInTouchMode="true"
    tools:context="com.olam.digital.ofis.TrainingAttendeeScores">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:id="@+id/topSectionBackground"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:contentDescription="@string/cd_topSectionColour" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_below="@+id/topSection"
        android:layout_above="@+id/buttonContainer"
        android:paddingBottom="@dimen/ofis_list_itemseparator"
        android:layout_marginStart="@dimen/margin_10"
        android:layout_marginEnd="@dimen/margin_10"
        android:layout_marginBottom="@dimen/margin_10"
        android:weightSum="10">

        <!-- Farmer List -->
        <LinearLayout
            android:id="@+id/farmer_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/btn_white_rec"
            android:layout_weight="9"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="10">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_width_height"
                    android:src="@drawable/attendee_icon"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/primary_farmer"
                    android:paddingStart="@dimen/margin_10"
                    android:textColor="@color/ofis_base_font_dark"
                    android:textSize="@dimen/ofis_med_text"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="8" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_width_height"
                    android:background="@color/light_orange"
                    android:gravity="center"
                    android:padding="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/toggle_icon_farmer"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_down"
                        card_view:tint="@color/ic_orange" />
                </LinearLayout>


            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:id="@+id/list_farmer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/attendeeListFarmer">

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

        <!-- Stakeholder List -->
        <LinearLayout
            android:id="@+id/stakeholder_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/btn_white_rec"
            android:layout_marginTop="@dimen/ofis_bottom_section_padding_horizontal"
            android:layout_weight="1"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="10">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_width_height"
                    android:src="@drawable/attendee_icon"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/stakeholder_attendee"
                    android:paddingStart="@dimen/margin_10"
                    android:textColor="@color/ofis_base_font_dark"
                    android:textSize="@dimen/ofis_med_text"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="8" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_width_height"
                    android:background="@color/light_orange"
                    android:gravity="center"
                    android:padding="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/toggle_icon_stakeholder"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_down"
                        card_view:tint="@color/ic_orange" />
                </LinearLayout>


            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:id="@+id/list_stakeholder">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/attendeeListStakeholder">

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

    </LinearLayout>

    <!-- base button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/buttonContainer"
        android:layout_alignParentBottom="true"
        android:paddingBottom="@dimen/ofis_list_itemseparator"
        android:paddingRight="@dimen/ofis_bottom_section_padding_horizontal"
        android:paddingLeft="@dimen/ofis_bottom_section_padding_horizontal"
        android:gravity="right">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="@dimen/text_button_width_height"
            android:text="@string/save_scores"
            android:textAllCaps="true"
            android:background="@color/ofis_action_button_background"
            android:textColor="@color/ofis_base_font_white"
            android:paddingLeft="@dimen/ofis_med_pad"
            android:paddingRight="@dimen/ofis_med_pad"
            android:textSize="@dimen/ofis_micro_text"
            android:id="@+id/saveScores" />

    </LinearLayout>

    <!-- top section -->
    <!-- page title -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@id/topSection"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/TrainingAttendeeScores"
            android:id="@+id/ViewTrainingRecordTitle"
            android:textColor="@color/ofis_base_font_white"
            android:paddingRight="0dp"
            android:paddingLeft="5dp"
            android:textSize="@dimen/ofis_large_text"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/TrainingAttendeeScoresSubTitle"
            android:id="@+id/ViewTrainingRecordSubTitle"
            android:textColor="@color/ofis_base_font_white"
            android:paddingRight="0dp"
            android:paddingLeft="5dp"
            android:textSize="@dimen/ofis_small_text"
            tools:ignore="RtlHardcoded"
            android:maxLines="1" />

    </LinearLayout>
    <!-- end module and submodule title -->

</RelativeLayout>
