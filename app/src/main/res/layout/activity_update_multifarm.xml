<?xml version="1.0" encoding="utf-8"?>

    <!-- Farm Information Start-->
<ScrollView
    android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/farmInformationLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/ofis_med_pad"
        android:orientation="vertical">


    <LinearLayout
        android:id="@+id/updateFarmLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
           android:layout_marginLeft="@dimen/activity_vertical_margin"
           android:layout_marginRight="@dimen/activity_vertical_margin"
           android:layout_marginTop="@dimen/activity_vertical_margin"
            android:text="@string/farm_information"
            android:textColor="@color/ofis_base_font_white"
            android:textSize="@dimen/ofis_med_text"
            android:textStyle="bold" />


        <RadioGroup
            android:id="@+id/farmRadioGroup"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_margin="@dimen/activity_vertical_margin"
            android:layout_above="@+id/newFarmLayout"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/newFarmRadioButton"
                android:layout_width="wrap_content"
                android:text="@string/create_new_farm"
                android:buttonTint="@color/white"
                android:textColor="@color/ofis_base_font_white"
                android:layout_height="wrap_content"/>
            <RadioButton
                android:id="@+id/existingFarmRadioButton"
                android:layout_width="wrap_content"
                android:text="@string/select_from_existing_farm"
                android:buttonTint="@color/white"
                android:textColor="@color/ofis_base_font_white"
                android:layout_marginLeft="@dimen/margin_10"
                android:layout_height="wrap_content"/>

        </RadioGroup>

    </LinearLayout>

        <LinearLayout
            android:id="@+id/newFarmLayout"
            android:layout_below="@+id/updateFarmLayout"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/margin_10"
            android:layout_marginLeft="@dimen/activity_vertical_margin"
            android:layout_marginRight="@dimen/activity_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="@string/farm_name"
                android:layout_width="match_parent"
                android:textColor="@color/ofis_text_field"
                android:layout_height="wrap_content"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:inputType="textCapWords"
                android:padding="@dimen/margin_10"
                android:layout_marginTop="5dp"
                android:id="@+id/farmNameEdittext"
                android:textColor="@color/ofis_text_field"
                android:textStyle="bold"
                android:textSize="@dimen/ofis_input_field_text"
                android:hint="@string/farm_name"
                android:maxLength="100"
                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890abcdefghijklmnopqrstuvwxyz.,/'-_ \\"
                android:textColorHint="@color/icon_grey_palette_2"
                android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"/>

            <TextView
                android:text="@string/farm_code"
                android:layout_width="match_parent"
                android:textColor="@color/ofis_text_field"
                android:layout_height="wrap_content"/>
            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:inputType="textCapWords"
                android:padding="@dimen/margin_10"
                android:layout_marginTop="5dp"
                android:id="@+id/farmCodeEdittext"
                android:textColor="@color/ofis_text_field"
                android:focusable="false"
                android:textSize="@dimen/ofis_input_field_text"
                android:hint="@string/farm_code"
                android:textColorHint="@color/icon_grey_palette_2"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/stakeholderPart"
            android:orientation="vertical"
            android:layout_below="@+id/newFarmLayout"
            android:layout_margin="@dimen/activity_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:animateLayoutChanges="true"
                android:layout_margin="@dimen/margin_10"
                android:id="@+id/farmStakeholderLayout"/>


            <LinearLayout
                android:id="@+id/addFarmerRoleLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/addRoleTV"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:src="@drawable/ic_ofis_add"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/Add" />

                <TextView
                    android:text="@string/add_stakeholder"
                    android:textColor="@color/btnColorThird"
                    android:layout_width="wrap_content"
                    android:layout_marginLeft="@dimen/margin_10"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>



        </LinearLayout>


    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/saveButton"
        android:layout_alignParentBottom="true"
        android:background="@color/btn_primary_background"
        android:layout_marginLeft="@dimen/activity_vertical_margin"
        android:layout_marginRight="@dimen/activity_vertical_margin"
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        android:text="Save and Update"
        android:textColor="@color/ofis_base_font_white"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"/>

    </LinearLayout>
    <!-- Farm Information End-->
</ScrollView>