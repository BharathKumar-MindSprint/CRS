<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Records"
    android:layout_margin="10dp"
    >
    <RelativeLayout
        android:id="@+id/manage_training_btn"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:background="@color/ofis_action_button_background"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:paddingLeft="10dp"
        android:layout_marginTop="10dp"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manage_training_documents"
            android:textAlignment="center"
            android:layout_margin="@dimen/margin_10"
            android:textColor="@color/white"
            android:layout_marginLeft="20dp"
            android:textSize="18sp"
            />
        <ImageView
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:src="@drawable/save"
            android:layout_alignParentRight="true"
            app:tint="@color/white" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/training_records_btn"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:background="@color/ofis_action_button_background"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:paddingLeft="10dp"
       >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_10"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="@dimen/margin_10"
            android:layout_marginEnd="@dimen/margin_10"
            android:layout_marginBottom="@dimen/margin_10"
            android:text="@string/training_records"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="18sp" />
        <ImageView
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:src="@drawable/download"
            android:layout_alignParentRight="true"
            app:tint="@color/white"
            />
    </RelativeLayout>

</LinearLayout>