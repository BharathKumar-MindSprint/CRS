<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ManagingTrainingActivity"
    android:id="@+id/parent_layout"
    android:background="@color/white"
    >
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/home_layout">
        <LinearLayout
            android:id="@+id/topLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/ofis_large_pad"
            android:paddingRight="@dimen/ofis_large_pad"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:background="@drawable/border_white_background"
            android:layout_marginTop="@dimen/ofis_med_pad"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ofis_text_field"
                android:textSize="@dimen/ofis_small_text"
                android:text="Course Selection *"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/ofis_med_pad"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ofis_med_pad">

                <Spinner
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/spinner_course"
                    android:layout_weight="1"
                    android:hint="Select Course"
                    android:nextFocusDown="@+id/spinner_module"
                    />


            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                >
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ofis_text_field"
                        android:textSize="@dimen/ofis_small_text"
                        android:text="Module Selection *"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/ofis_med_pad"/>

                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/spinner_module"
                        android:layout_weight="1"
                        android:nextFocusDown="@+id/spinner_language"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/haDistrict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp"
                    android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                    android:scaleType="center"
                    app:srcCompat="@drawable/ic_spinner_hierarchy_arrow" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ofis_text_field"
                        android:textSize="@dimen/ofis_small_text"
                        android:text="Language Selection *"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/ofis_med_pad"/>
                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/spinner_language"
                        android:layout_weight="1" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
        <!--    Tab View-->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/scrollView"
            android:layout_below="@+id/topLinearLayout">
            <LinearLayout
                android:id="@+id/TabviewLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/scrollView"
                android:layout_margin="10dp"
                android:orientation="horizontal"
                >
<!--                Buttons are created dynamically-->
            </LinearLayout>
        </HorizontalScrollView >
        <!--    List based on tabview-->

        <RelativeLayout
            android:id="@+id/ListRelativeLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/scrollView"
            >
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/media_text"
                android:text="Media"
                android:gravity="center"/>

        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/check_network">

        <LinearLayout
            android:id="@+id/network_linear_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/margin_10"
            android:layout_marginTop="@dimen/margin_10"
            android:layout_marginEnd="@dimen/margin_10"
            android:layout_marginBottom="@dimen/margin_10"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/caution_img"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/caution" />

            <LinearLayout
                android:id="@+id/text_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:background="@drawable/network_background"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_caution1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="Oops! Training data is available only online"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_caution2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="10dp"
                    android:text="Please turn on your mobile data."
                    android:textAlignment="center"
                    android:textColor="#FF0000"
                    android:textSize="16sp"
                    android:textStyle="bold" />


            </LinearLayout>

            <Button
                android:id="@+id/retry_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/ofis_action_button_background"
                android:text="Retry"
                android:textColor="@color/white" />

        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>