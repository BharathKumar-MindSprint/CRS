<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.olam.digital.ofis.AddInfrastructureActivity"
    tools:ignore="Overdraw">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ofis_page_background"
        android:focusableInTouchMode="true">

        <ImageView
            android:id="@+id/topSectionBackground"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/ofis_poi_screen_top_background_school"
            android:contentDescription="@string/cd_topSectionColour" />


        <!-- Middle Section -->
        <LinearLayout
            android:id="@+id/layout_geo_new"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/topSectionBackground"
            android:background="@color/ofis_poi_screen_top_background_school"
            android:orientation="vertical"
            android:padding="@dimen/activity_horizontal_margin"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ofis_med_pad"
                android:text="@string/location"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_small_text"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ofis_med_pad"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spinner_country1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="0dp"
                    android:layout_weight="1"
                    android:hint="@string/Country"
                    android:nextFocusDown="@+id/spinner_region1"
                    android:nextFocusForward="@+id/spinner_region1" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                    android:scaleType="center"
                    app:srcCompat="@drawable/ic_spinner_hierarchy_arrow" />

                <Spinner
                    android:id="@+id/spinner_region1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="0dp"
                    android:layout_weight="1"
                    android:nextFocusDown="@id/spinner_district1" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/ofis_med_pad">

                <Spinner
                    android:id="@+id/spinner_district1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:nextFocusDown="@+id/spinner_place1"
                    android:nextFocusForward="@+id/spinner_place1" />

                <ImageView
                    android:id="@+id/haDistrict1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                    android:scaleType="center"
                    app:srcCompat="@drawable/ic_spinner_hierarchy_arrow" />

                <Spinner
                    android:id="@+id/spinner_subdistrict1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="0dp"
                    android:layout_weight="1" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/ofis_bottom_section_padding_vertical">

                <Spinner
                    android:id="@+id/spinner_place1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:nextFocusDown="@+id/spinner_place"
                    android:nextFocusForward="@+id/spinner_place1" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                    android:scaleType="center"
                    android:visibility="invisible"
                    app:srcCompat="@drawable/ic_spinner_hierarchy_arrow" />

                <Spinner
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="0dp"
                    android:layout_weight="1"
                    android:visibility="invisible" />


            </LinearLayout>
        </LinearLayout>


        <!-- bottom section -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/layout_geo_new"
            android:padding="0dp">

            <LinearLayout
                android:id="@+id/bottomSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:background="@android:color/transparent"
                android:orientation="vertical"
                android:paddingLeft="@dimen/activity_horizontal_margin"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:paddingRight="@dimen/activity_horizontal_margin"
                android:paddingBottom="@dimen/activity_vertical_margin">

                <LinearLayout
                    android:id="@+id/questionsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />


                <LinearLayout
                    android:id="@+id/olamFundedWrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_white_background"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/ofis_large_pad"
                    android:paddingTop="@dimen/activity_vertical_margin"
                    android:paddingRight="@dimen/ofis_large_pad"
                    android:paddingBottom="@dimen/activity_vertical_margin"
                    android:visibility="gone">

                    <Switch
                        android:id="@+id/olamFunded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:switchTextAppearance="@style/SwitchText"
                        android:text="@string/ofis_olam_funded"
                        android:textOff="@string/ofis_switch_text_no"
                        android:textOn="@string/ofis_switch_text_yes"
                        android:textSize="@dimen/ofis_small_text"
                        android:textStyle="bold"
                        tools:ignore="RtlHardcoded" />

                </LinearLayout>

                <include
                    android:id="@+id/additional_components_school"
                    layout="@layout/include_additional_components_school"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <include
                    android:id="@+id/additional_components_buyingcentre"
                    layout="@layout/include_additional_components_buyingcentre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <include
                    android:id="@+id/additional_components_cleanwatersupply"
                    layout="@layout/include_additional_components_cleanwatersupply"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <include
                    android:id="@+id/additional_components_healthcentre"
                    layout="@layout/include_additional_components_healthcentre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!--This applicable for all SIP -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ofis_med_pad"
                    android:background="@drawable/border_white_background"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/ofis_large_pad"
                    android:paddingTop="@dimen/activity_vertical_margin"
                    android:paddingRight="@dimen/ofis_large_pad"
                    android:paddingBottom="@dimen/activity_vertical_margin">

                    <LinearLayout
                        android:id="@+id/layout_geo_old"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/ofis_med_pad"
                            android:text="@string/location"
                            android:textColor="@color/ofis_text_field"
                            android:textSize="@dimen/ofis_small_text"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/ofis_med_pad"
                            android:orientation="horizontal">

                            <Spinner
                                android:id="@+id/spinner_country"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="0dp"
                                android:layout_weight="1"
                                android:hint="@string/Country"
                                android:nextFocusDown="@+id/spinner_region"
                                android:nextFocusForward="@+id/spinner_region" />

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                                android:scaleType="center"
                                app:srcCompat="@drawable/ic_spinner_hierarchy_arrow" />

                            <Spinner
                                android:id="@+id/spinner_region"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="0dp"
                                android:layout_weight="1"
                                android:nextFocusDown="@id/spinner_district" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingBottom="@dimen/ofis_med_pad">

                            <Spinner
                                android:id="@+id/spinner_district"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:nextFocusDown="@+id/spinner_subdistrict"
                                android:nextFocusForward="@+id/spinner_subdistrict" />

                            <ImageView
                                android:id="@+id/haDistrict"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                                android:scaleType="center"
                                app:srcCompat="@drawable/ic_spinner_hierarchy_arrow" />

                            <Spinner
                                android:id="@+id/spinner_subdistrict"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="0dp"
                                android:layout_weight="1" />


                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingBottom="@dimen/ofis_bottom_section_padding_vertical">

                            <Spinner
                                android:id="@+id/spinner_place"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                                android:scaleType="center"
                                android:visibility="invisible"
                                app:srcCompat="@drawable/ic_spinner_hierarchy_arrow" />

                            <Spinner
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="0dp"
                                android:layout_weight="1"
                                android:visibility="invisible" />


                        </LinearLayout>
                    </LinearLayout>


                    <!-- Farmer group view incorporated -Starts-->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ofis_med_pad"
                        android:text="@string/Farmer_Group_Name"
                        android:textColor="@color/ofis_text_field"
                        android:textSize="@dimen/ofis_small_text"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/spinner_farmerGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="0dp"
                            android:layout_marginLeft="0dp"
                            android:layout_weight="1"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusDown="@+id/spinner_section"
                            android:nextFocusForward="@+id/spinner_section" />

                        <ImageView
                            android:id="@+id/haFarmerGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                            android:scaleType="center"
                            app:srcCompat="@drawable/ic_spinner_hierarchy_arrow" />

                        <Spinner
                            android:id="@+id/spinner_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="0dp"
                            android:layout_marginRight="0dp"
                            android:layout_weight="1"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:visibility="gone" />

                    </LinearLayout>


                    <!-- Farmer group view incorporated -Ends-->


                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/ofis_large_pad">

                    <Button
                        android:id="@+id/buttonSave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentBottom="true"
                        android:background="@color/ofis_action_button_background"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"
                        android:text="@string/Save"
                        android:textColor="@color/ofis_base_font_white" />
                </RelativeLayout>

            </LinearLayout>
        </ScrollView>

        <!-- page heading -->
        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingLeft="15dp"
            android:paddingTop="10dp"
            android:paddingRight="0dp"
            android:text="@string/Add_Point_of_Interest"
            android:textColor="@color/ofis_base_font_white"
            android:textSize="@dimen/ofis_large_text" />

        <!-- top section -->
        <LinearLayout
            android:id="@+id/topSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/textView2"
            android:layout_marginBottom="10dp"
            android:baselineAligned="false"
            android:minHeight="120dp"
            android:orientation="horizontal"
            android:paddingBottom="0dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:paddingLeft="@dimen/activity_horizontal_margin"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:paddingBottom="@dimen/activity_vertical_margin">

                <Spinner
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:id="@+id/spinner_modules"
                    android:visibility="invisible"
                    android:textColor="@color/ofis_base_font_white"
                    />

                <Spinner
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/spinner_submodules"
                    android:paddingRight="20dp"
                    android:textColor="@color/ofis_base_font_dark"/>

                <Spinner
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/villageSpinner"
                    android:textColor="@color/ofis_base_font_white"
                    android:textSize="@dimen/ofis_input_field_text"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/margin_10"
                    android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"

                    />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:inputType="textCapWords"
                    android:id="@+id/poiName"
                    android:textColor="@color/ofis_base_font_dark"
                    android:textSize="@dimen/ofis_input_field_text"
                    android:maxLength="50"
                    android:layout_marginTop="@dimen/margin_10"
                    android:hint="@string/Name"
                    android:textColorHint="@color/icon_grey_palette_2"
                    android:padding="@dimen/margin_10"
                    android:background="@drawable/edittext_bg_dark"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/gpsPosition"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="@dimen/margin_10"
                    android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                    android:background="@drawable/edittext_bg_dark"
                    android:hint="@string/GPS_Position"
                    android:padding="@dimen/margin_10"
                    android:textColor="@color/ofis_poi_screen_top_background_school"
                    android:textColorHint="@color/icon_grey_palette_2"
                    android:textSize="@dimen/ofis_input_field_text" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:baselineAligned="true"
                android:gravity="center|bottom"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:paddingBottom="@dimen/ofis_consent_statement_row_bottom_margin"
                android:paddingRight="@dimen/margin_10">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="@dimen/activity_vertical_margin"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/sip_polygon_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:visibility="gone"
                        android:paddingRight="@dimen/activity_vertical_margin"
                        app:srcCompat="@drawable/ic_sip_polygon" />

                    <ImageButton
                        android:id="@+id/requestLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/record_farm_location_hint"
                        app:srcCompat="@drawable/ic_actionbutton_location_searching" />


                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

