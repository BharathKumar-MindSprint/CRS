<!-- res/layout/row_submission_item.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/list_item"
    android:layout_marginStart="@dimen/margin_16"
    android:layout_marginEnd="@dimen/margin_16"
    android:paddingTop="@dimen/ofis_list_itemseparator"
    android:paddingLeft="@dimen/ofis_large_pad"
    android:weightSum="2"
    android:paddingRight="@dimen/ofis_large_pad"
    android:paddingBottom="@dimen/ofis_list_itemseparator">


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.9"
        android:padding="@dimen/padding_5"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSubmissionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Submission: UPL-20260125-0002"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubmissionSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Module: 457 • Farmer: 74996"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSubmissionDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="2026-01-25 10:30:00"
            android:textColor="#666666"
            android:textSize="12sp" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/left_border"
        android:layout_weight=".1"
        android:gravity="end">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="false"
            android:padding="@dimen/ofis_large_pad"
            android:maxHeight="@dimen/text_button_width_height"
            android:scaleType="center"
            android:id="@+id/imageView_pic"
            app:srcCompat="@drawable/ic_upload_list"
            android:contentDescription="@string/Farmer_Photo"
            android:layout_gravity="center_vertical|center_horizontal" />
    </LinearLayout>
</LinearLayout>