<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ofis_page_background"
    tools:context="com.olam.digital.ofis.FindFarmerActivity"
    tools:ignore="Overdraw">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/topSection"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/Select_Farmer"
                android:id="@+id/pageTitle"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_large_text"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- business groups -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
            android:paddingLeft="0dp"
            android:paddingRight="0dp">

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/spinner_farmerGroup"
                android:layout_weight="1"
                android:layout_marginLeft="0dp"
                android:layout_marginStart="0dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/spinner_section"
                android:nextFocusForward="@+id/spinner_section"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/ofis_cd_hierarchy_arrow"
                app:srcCompat="@drawable/ic_spinner_hierarchy_arrow"
                android:scaleType="center" />

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/spinner_section"
                android:layout_marginRight="0dp"
                android:layout_marginEnd="0dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"/>

        </LinearLayout>
        <!-- end business groups -->

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ofis_edit_text_holo_dark">

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColorHint="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_input_field_text"
                android:id="@+id/findFarmerSearchBox"
                android:layout_weight="1"
                android:textColor="@color/ofis_base_font_white"
                android:hint="@string/Farmer_Name"
                android:background="@android:color/transparent"/>
            <ImageButton
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/imageButton"
                android:layout_weight="8"
                app:srcCompat="@drawable/ic_search"
                android:background="@android:color/transparent"
                android:contentDescription="@string/Search" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/advanced_filters"
            android:id="@+id/advancedFilters"
            android:textColor="@color/ofis_base_font_white"
            android:layout_marginTop="@dimen/margin_10"
            android:clickable="true"
            android:onClick="expandOrCollapse"
            android:drawableRight="@drawable/ic_drop_down_collapse"
            android:textSize="@dimen/ofis_large_text"
            android:visibility="gone"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/advancedFilterLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_weight="1"
                android:paddingLeft="0dp"
                android:paddingRight="0dp">

                <!--<Spinner
                    android:id="@+id/spinner_region"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="-5dp"
                    android:dropDownWidth="300dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="0dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"/>-->

                <com.olam.digital.ofis.MultiSpinnerSearch
                    android:id="@+id/spinner_region"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="-5dp"
                    android:dropDownWidth="300dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="0dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:hintText="@string/spinner_region_default"/>

                <com.olam.digital.ofis.MultiSpinnerSearch
                    android:id="@+id/spinner_district"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="-5dp"
                    android:dropDownWidth="300dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="0dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:hintText="@string/spinner_district_default"/>

            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
                android:layout_marginTop="@dimen/margin_10"
                android:paddingLeft="0dp"
                android:paddingRight="0dp">

                <com.olam.digital.ofis.MultiSpinnerSearch
                    android:id="@+id/spinner_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="-5dp"
                    android:dropDownWidth="300dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="0dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:hintText="@string/spinner_place_default"/>

                <com.olam.digital.ofis.MultiSpinnerSearch
                    android:id="@+id/spinner_partner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="-5dp"
                    android:dropDownWidth="300dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="0dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:hintText="@string/spinner_partner_default"/>

            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
                android:layout_marginTop="@dimen/margin_10"
                android:paddingLeft="0dp"
                android:paddingRight="0dp">

                <com.olam.digital.ofis.MultiSpinnerSearch
                    android:id="@+id/spinner_program"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="-5dp"
                    android:dropDownWidth="300dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="0dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:hintText="@string/spinner_programme_default"/>

                <com.olam.digital.ofis.MultiSpinnerSearch
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/spinner_farmerGroup"
                    android:paddingLeft="-5dp"
                    android:dropDownWidth="300dp"
                    android:layout_marginRight="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:hintText="@string/spinner_farmergroup_default"/>

            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingBottom="@dimen/ofis_input_field_bottom_margin"
                android:layout_marginTop="@dimen/margin_10"
                android:paddingLeft="0dp"
                android:paddingRight="0dp">

                <com.olam.digital.ofis.MultiSpinnerSearch
                    android:id="@+id/spinner_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="-5dp"
                    android:dropDownWidth="300dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="0dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:hintText="@string/spinner_section_default"/>

                <com.olam.digital.ofis.MultiSpinnerSearch
                    android:id="@+id/spinner_certification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="-5dp"
                    android:dropDownWidth="300dp"
                    android:layout_marginRight="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    app:hintText="@string/certification_name"/>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/bottomSection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topSection">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
