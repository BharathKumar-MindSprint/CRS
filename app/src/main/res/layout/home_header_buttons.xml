<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/topSectionWrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/laySurveyAndOfis"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_20"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_marginTop="@dimen/margin_4"
                android:background="@drawable/bg_primary_oga_color">

                <TextView
                    android:id="@+id/txtOfisState"
                    style="@style/regular_small_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="@dimen/margin_2"
                    android:layout_marginEnd="@dimen/margin_2"
                    android:text="@string/survey_ofis"
                    android:textColor="@color/white" />

            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/layOnlySurvey"
                android:layout_width="@dimen/width_70"
                android:layout_height="@dimen/height_20"
                android:layout_marginStart="@dimen/margin_4"
                android:layout_marginTop="@dimen/margin_4"
                android:background="@drawable/bg_survy_curved">

                <TextView
                    android:id="@+id/txtActiveState"
                    style="@style/regular_small_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/survey"
                    android:textColor="@color/textBalance" />

            </RelativeLayout>

        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/width_05"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_8"
            android:layout_marginEnd="@dimen/margin_16"
            android:background="@color/gray_view_bg" />



        <LinearLayout
            android:layout_width="match_parent"
            tools:visibility="gone"
            android:orientation="vertical"
            android:visibility="gone"
            android:id="@+id/layOfis"
            android:layout_height="wrap_content">


            <LinearLayout
                android:id="@+id/topSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/home_activity_horizontal_margin"
                android:paddingTop="@dimen/home_activity_vertical_margin"
                android:paddingRight="@dimen/home_activity_horizontal_margin"
                android:paddingBottom="@dimen/ofis_small_pad">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_actions_background"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/AddNewFarmer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_add_farmers_icon"
                        android:drawablePadding="10dp"
                        android:paddingLeft="@dimen/ofis_med_pad"
                        android:paddingTop="16dp"
                        android:paddingRight="@dimen/ofis_med_pad"
                        android:paddingBottom="16dp"
                        android:text="@string/add_new_farmer_farm_holding"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/ofis_small_pad"
                    android:layout_weight="1"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_actions_background"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/CompleteQuestionnaireModule"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_farmers_survey_list"
                        android:drawablePadding="10dp"
                        android:paddingLeft="@dimen/ofis_med_pad"
                        android:paddingTop="16dp"
                        android:paddingRight="@dimen/ofis_med_pad"
                        android:paddingBottom="16dp"
                        android:text="@string/ofis_farmer_and_surveys"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvSupplierAndSurvey"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/ofis_small_pad"
                    android:layout_weight="1"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_actions_background"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/SupplierAndSurveys"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_supplier_and_survey"
                        android:drawablePadding="10dp"
                        android:paddingLeft="@dimen/ofis_med_pad"
                        android:paddingTop="16dp"
                        android:paddingRight="@dimen/ofis_med_pad"
                        android:paddingBottom="16dp"
                        android:text="@string/supplier_and_surveys"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/middleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/home_activity_horizontal_margin"
                android:paddingTop="0dp"
                android:paddingRight="@dimen/home_activity_horizontal_margin"
                android:paddingBottom="@dimen/ofis_small_pad">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="-4dp"
                    android:layout_weight="1"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_actions_background"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/AddSocialInfrastructure"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_survey_location"
                        android:drawablePadding="10dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:text="@string/ofis_add_infrastructure"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/downloadSurveyWrapper"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/ofis_small_pad"
                    android:layout_marginTop="-4dp"
                    android:layout_weight="1"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/downloadSurveyData"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_survey_download_data"
                        android:drawablePadding="10dp"
                        android:paddingLeft="@dimen/ofis_med_pad"
                        android:paddingTop="16dp"
                        android:paddingRight="@dimen/ofis_med_pad"
                        android:paddingBottom="16dp"
                        android:text="@string/download_survey_data"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvDistributionModule"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/ofis_small_pad"
                    android:layout_marginTop="-4dp"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    android:layout_weight="1"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/btnDistribution"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/distribution_module_icon"
                        android:drawablePadding="15dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:text="@string/distribution_module"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_download_FarmPlanSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/home_activity_horizontal_margin"
                android:paddingTop="0dp"
                android:paddingRight="@dimen/home_activity_horizontal_margin"
                android:paddingBottom="@dimen/ofis_small_pad">

                <androidx.cardview.widget.CardView
                    android:id="@+id/recordTrainingWrapper"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="-4dp"
                    android:layout_weight="1"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/RecordFarmerTraining"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_only_surveys"
                        android:drawablePadding="10dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:text="@string/survey"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/captureLocationWrapper"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="-4dp"
                    android:layout_weight="1"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/captureLocation"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_revoke_survey"
                        android:drawablePadding="10dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:text="REVOKE SURVEY"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardview_downloadFarmplan"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/ofis_small_pad"
                    android:layout_marginTop="-4dp"
                    android:layout_weight="1"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/DownloadFarmPlan"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_baseline_downloadnew"
                        android:drawablePadding="10dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:text="@string/download_farm_plan"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/home_activity_horizontal_margin"
                android:paddingTop="0dp"
                android:paddingRight="@dimen/home_activity_horizontal_margin"
                android:paddingBottom="@dimen/ofis_small_pad">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="-4dp"
                    android:layout_weight="1"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/btnRecordTraining"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_record_training"
                        android:drawablePadding="10dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:text="@string/record_training_button"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="-4dp"
                    android:layout_weight="1"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/btnCaptureLocation"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_captureloc"
                        android:drawablePadding="10dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:text="@string/capture_location"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/ofis_small_pad"
                    android:layout_marginTop="-4dp"
                    android:layout_weight="1"
                    tools:visibility="invisible"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_baseline_downloadnew"
                        android:drawablePadding="10dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:text="@string/download_farm_plan"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>


            </LinearLayout>


        </LinearLayout>




        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            tools:visibility="visible"
            android:visibility="gone"
            android:id="@+id/layCrs"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/topSectionCrs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/home_activity_horizontal_margin"
                android:paddingTop="@dimen/home_activity_vertical_margin"
                android:paddingRight="@dimen/home_activity_horizontal_margin"
                android:paddingBottom="@dimen/ofis_small_pad">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_actions_background"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/AddNewFarmerCrs"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_add_farmers_icon"
                        android:drawablePadding="10dp"
                        android:paddingLeft="@dimen/ofis_med_pad"
                        android:paddingTop="16dp"
                        android:paddingRight="@dimen/ofis_med_pad"
                        android:paddingBottom="16dp"
                        android:text="@string/add_new_farmer_farm_holding"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/btnAddCrsSurvey"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_only_surveys"
                        android:drawablePadding="10dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:text="@string/survey"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/ll_revoke_crs_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/home_activity_horizontal_margin"
                android:paddingTop="0dp"
                android:paddingRight="@dimen/home_activity_horizontal_margin"
                android:paddingBottom="@dimen/ofis_small_pad">


                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="-4dp"
                    android:layout_weight="1"
                    android:id="@+id/btnRevokeCrsSurvey"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/revokeCrsSurvey"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_revoke_survey"
                        android:drawablePadding="10dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:text="@string/revoke_survey"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>




                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/ofis_small_pad"
                    android:layout_marginTop="-4dp"
                    android:visibility="invisible"
                    android:id="@+id/btnSurveyBtn"
                    android:layout_weight="1"
                    card_view:cardCornerRadius="@dimen/margin_8"
                    card_view:cardBackgroundColor="@color/ofis_home_screen_midsection_background"
                    card_view:cardElevation="@dimen/ofis_elevation_height"
                    card_view:cardUseCompatPadding="true">

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableTop="@drawable/ic_baseline_downloadnew"
                        android:drawablePadding="10dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:text="@string/download_farm_plan"
                        android:textColor="@color/ofis_base_font_white"
                        android:textSize="@dimen/ofis_micro_text"
                        tools:ignore="ButtonStyle" />
                </androidx.cardview.widget.CardView>




            </LinearLayout>



        </LinearLayout>




        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/home_activity_horizontal_margin"
            android:layout_marginTop="0dp"
            android:layout_marginRight="@dimen/home_activity_horizontal_margin"
            android:layout_marginBottom="@dimen/home_activity_vertical_margin"
            card_view:cardBackgroundColor="@color/white"
            card_view:cardElevation="@dimen/ofis_elevation_height"
            card_view:cardUseCompatPadding="true">

            <RelativeLayout
                android:id="@+id/itemlistBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/home_activity_vertical_margin"
                android:paddingTop="@dimen/home_activity_vertical_margin"
                android:paddingRight="@dimen/home_activity_vertical_margin"
                android:paddingBottom="@dimen/home_activity_vertical_margin">

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ofis_small_pad"
                    android:paddingRight="@dimen/ofis_micro_pad"
                    style="@style/semibold_dark_gray_medium_tv"
                    android:text="@string/Modules_to_submit"
                    tools:ignore="RtlHardcoded" />

                <TextView
                    android:id="@+id/networkQueueCount"
                    android:layout_width="wrap_content"
                    android:layout_height="23dp"
                    android:layout_marginLeft="@dimen/ofis_small_pad"
                    android:layout_marginTop="@dimen/ofis_micro_pad"
                    android:layout_toRightOf="@+id/textView4"
                    android:background="@drawable/background_red_nice_edge"
                    android:gravity="center"
                    android:minEms="2"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    tools:text="25"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="@dimen/ofis_small_text"
                    tools:ignore="HardcodedText" />

                <ImageButton
                    android:id="@+id/syncAll"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/ofis_micro_pad"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/ofis_cd_submit_all_icon"
                    android:scaleType="fitXY"
