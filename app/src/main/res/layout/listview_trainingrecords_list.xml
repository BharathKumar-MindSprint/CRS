<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="@dimen/ofis_med_pad"
    android:paddingRight="@dimen/ofis_med_pad"
    android:paddingTop="@dimen/ofis_list_itemseparator"
    android:paddingBottom="@dimen/ofis_list_itemseparator">


    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:id="@+id/rowlin"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="@drawable/list_item"
        android:baselineAligned="false"
        android:weightSum="8"
        tools:ignore="UselessParent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:id="@+id/itemTextContainer"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_weight="7">

            <TextView
                android:id="@+id/trainingRecordId"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/readOnlyMode"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="0"
                android:visibility="gone"
                tools:ignore="HardcodedText" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Transaction_default"
                android:id="@+id/trainingCourse"
                android:textColor="@color/ofis_base_font_dark"
                android:textSize="@dimen/ofis_med_text" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/trainingModule"
                android:textColor="@color/ofis_list_item_subtitle"
                android:textSize="@dimen/ofis_small_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/ofis_micro_pad">

                <TextView
                    android:id="@+id/trainingDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ofis_list_item_subtitle"
                    android:textSize="@dimen/ofis_small_text" />

                <TextView
                    android:id="@+id/attendeeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/ofis_list_item_subtitle"
                    android:textSize="@dimen/ofis_small_text"
                    android:textStyle="bold"
                    android:background="@drawable/left_border"
                    android:paddingLeft="@dimen/ofis_med_pad"
                    android:layout_marginLeft="@dimen/ofis_med_pad"
                    android:layout_marginRight="@dimen/ofis_small_pad"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/attendeeCountSuffix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Attendees"
                    android:textColor="@color/ofis_list_item_subtitle"
                    android:textSize="@dimen/ofis_small_text" />

            </LinearLayout>

            <TextView
                android:id="@+id/inNetworkQueue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/item_in_progress"
                android:textColor="@color/ofis_list_item_subtitle"
                android:textSize="@dimen/ofis_small_text" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/left_border"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:gravity="center">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:id="@+id/deleteTrainingRecord"
                android:src="@drawable/ic_delete_item"
                android:contentDescription="@string/Delete_Item"
                android:layout_gravity="center_vertical|center_horizontal" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>


