<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/border_white_background"
    android:layout_marginVertical="5dp"
    android:layout_marginHorizontal="8dp"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvQuestionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="@dimen/ofis_smallmed_text"
        android:textColor="@color/black"/>

    <EditText
        android:id="@+id/etAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:inputType="number"
        android:textSize="@dimen/ofis_smallmed_text"
        android:background="@drawable/answer_text_survey"
        />

    <Spinner
        android:id="@+id/spinnerAnswer"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/spinner_bg_light"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvErrorMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dm_please_enter_any_value"
        android:textSize="12sp"
        android:paddingTop="10dp"
        android:layout_marginHorizontal="12dp"
        android:gravity="start"
        android:textAlignment="center"
        android:textColor="@color/red_view_survey"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvEvidenceUpload"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/evidence_upload"
        android:gravity="center"
        android:layout_marginHorizontal="20dp"
        android:textColor="@color/colorPrimary"
        android:layout_marginVertical="10dp"
        android:background="@drawable/dm_captureproof_bg"
        android:visibility="gone"/>

    <RelativeLayout
        android:id="@+id/rlEvidenceLayout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingHorizontal="4dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/dm_captureproof_bg"
        android:visibility="gone"
        android:layout_marginVertical="@dimen/margin_10">

        <ImageView
            android:id="@+id/iv_file_upload"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="10dp"
            android:backgroundTint="@color/colorPrimary"
            android:src="@drawable/ic_survey" />

        <TextView
            android:id="@+id/tv_evidence_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="2dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="40dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_toRightOf="@+id/iv_file_upload"
            android:layout_centerVertical="true"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/ofis_small_text"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_evidence_delete"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:padding="5dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/dm_circular_bg"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_dm_cross" />

    </RelativeLayout>



</LinearLayout>