<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ofis_page_background"
    tools:context="com.olam.digital.ofis.ViewFarmerActivity"
    android:id="@+id/layout_view_farmer"
    tools:ignore="Overdraw">

    <LinearLayout
        android:id="@+id/llStakeHolderDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:baselineAligned="false"
        android:paddingBottom="0dp"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:layout_margin="0dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/topSection"
            android:baselineAligned="false"
            android:paddingBottom="0dp"
            android:layout_margin="0dp">

            <!-- add farmer white input fields and heading - updated -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="10dp"
                android:paddingTop="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/view_stake_holder"
                    android:id="@+id/pageTitle"
                    android:textColor="@color/ofis_base_font_white"
                    android:textSize="@dimen/ofis_large_text"
                    android:paddingRight="0dp"
                    android:paddingEnd="0dp"
                    android:paddingLeft="5dp"
                    android:maxLines="1" />


                <TextView
                    android:id="@+id/stakeHolderName"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:textSize="@dimen/ofis_input_field_text"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ofis_base_font_dark"
                    android:background="@drawable/edittext_bg_dark"
                    android:padding="@dimen/margin_10"
                    android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                    android:maxLines="1" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:textSize="@dimen/ofis_input_field_text"
                    android:id="@+id/viewFarmerOlamFarmerID"
                    android:textColor="@color/ofis_base_font_dark"
                    android:background="@drawable/edittext_bg_dark"
                    android:padding="@dimen/margin_10"
                    android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                    android:maxLines="1" />

                <Spinner
                    android:id="@+id/farmerRoleSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:visibility="visible"
                    android:layout_marginBottom="@dimen/ofis_input_field_bottom_margin"
                    android:textColor="@color/ofis_base_font_dark"
                    android:background="@drawable/spinner_bg_edit"/>


            </LinearLayout>
            <!-- end add farmer white input fields and heading -->
            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1.8"
                android:paddingLeft="10dp"
                android:paddingRight="@dimen/activity_horizontal_margin"
                android:paddingEnd="@dimen/activity_horizontal_margin"
                android:gravity="center_vertical"
                android:id="@+id/wrapper_farmerPhoto">

                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="112dp"
                    android:contentDescription="@string/Farmer_Photo"
                    android:id="@+id/viewFarmerFarmerPhoto"
                    app:srcCompat="@drawable/empty_farmer_icon"
                    android:background="@android:color/transparent"
                    android:scaleType="fitStart"
                    android:layout_alignParentLeft="false"
                    android:layout_alignParentStart="false"
                    android:layout_alignParentBottom="true"/>

                <ImageButton
                    android:layout_width="@dimen/standard_button_width_height"
                    android:layout_height="@dimen/standard_button_width_height"
                    android:id="@+id/farmerPhotoActionButton"
                    android:contentDescription="@string/Camera"
                    app:srcCompat="@drawable/ic_actionbutton_camera"
                    android:layout_alignParentEnd="false"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentRight="true"
                    android:padding="0dp"
                    android:adjustViewBounds="false"
                    android:background="@android:color/transparent"
                    android:scaleType="fitXY"
                    tools:ignore="VectorDrawableCompat" />
            </RelativeLayout>

        </LinearLayout>

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/ofis_large_text"
                android:textStyle="bold"
                android:id="@+id/viewFarmerInfo"
                android:textColor="@color/ofis_base_font_white"
                android:text="@string/view_stake_holder_information"
                android:paddingRight="10dp"
                android:gravity="center_vertical"
                android:drawablePadding="8dp"
                app:drawableRightCompat="@drawable/ic_drop_down_collapse" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llViewInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical"
            android:paddingTop="@dimen/margin_10"
            android:paddingBottom="@dimen/margin_10"
            android:background="@color/ofis_farmer_screen_actions_background"
            android:layout_below="@+id/topSectionBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ofis_select_gender"
                        android:textStyle="bold"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/genderInfo"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/age"
                        android:textStyle="bold"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/ageInfo"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/PhoneNumberHint"
                        android:textStyle="bold"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/pNumberInfo"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spinner_partner_default"
                        android:textStyle="bold"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/partnerInfo"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spinner_programme_default"
                        android:textStyle="bold"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/programInfo"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nationalid"
                        android:textStyle="bold"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/nationalIdInfo"
                        android:text="- NA"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spinner_region_view_farmer"
                        android:textStyle="bold"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/regionInfo"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spinner_district_view_farmer"
                        android:textStyle="bold"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/districtInfo"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spinner_subdistrict_view_farmer"
                        android:textStyle="bold"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/subDistrictInfo"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spinner_place_view_farmer"
                        android:textStyle="bold"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/placeInfo"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spinner_farmergroup_view_farmer"
                        android:textStyle="bold"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/fgInfo"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spinner_section_view_farmer"
                        android:textStyle="bold"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/sectionInfo"
                        android:textColor="@color/ofis_base_font_white"
                        android:paddingLeft="@dimen/margin_10"
                        android:paddingBottom="@dimen/margin_10"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llTaskHeader"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingLeft="15dp"
        android:paddingRight="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="10dp"
        android:paddingBottom="5dp"
        android:layout_below="@+id/llStakeHolderDetails">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="27dp"
            android:scaleType="fitStart"
            android:contentDescription="@string/ofis_cd_info_icon"
            android:layout_gravity="center_vertical"
            android:id="@+id/imageView2"
            app:srcCompat="@drawable/ic_task_list_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:text="@string/Task_list_header"
            android:layout_gravity="top"
            android:id="@+id/textView4"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:textColor="@color/ofis_list_header_text"
            android:textSize="@dimen/ofis_med_text"
            android:gravity="top|center_vertical"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_below="@+id/llTaskHeader">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="fitStart"
            android:contentDescription="@string/ofis_cd_info_icon"
            android:id="@+id/imageView"
            app:srcCompat="@drawable/no_task_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:text="@string/no_task"
            android:id="@+id/tvNoTask"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:textColor="@color/btn_secondary_background"
            android:textSize="@dimen/ofis_med_text"
            android:gravity="top|center_vertical"/>

    </LinearLayout>

</RelativeLayout>