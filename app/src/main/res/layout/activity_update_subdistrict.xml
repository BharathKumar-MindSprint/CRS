<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clmrs_bg"
    android:padding="@dimen/activity_vertical_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/addNewChildButton"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/fullnameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@color/clmrs_bg"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="@string/label_country"
                android:textColor="@color/clmrs_tv_grey" />

            <TextView
                android:id="@+id/tv_country_name"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/border_grey_bg"
                android:inputType="textPersonName"
                android:paddingLeft="10dp"
                android:gravity="center|left"
                android:textColor="@android:color/black" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@color/clmrs_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="@string/label_region"
                android:textColor="@color/clmrs_tv_grey" />

            <TextView
                android:id="@+id/tv_region_name"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/border_grey_bg"
                android:inputType="textPersonName"
                android:paddingLeft="10dp"
                android:gravity="center|left"
                android:textColor="@android:color/black" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@color/clmrs_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="@string/label_district"
                android:textColor="@color/clmrs_tv_grey" />

            <TextView
                android:id="@+id/tv_district_name"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/border_grey_bg"
                android:inputType="textPersonName"
                android:paddingLeft="10dp"
                android:gravity="center|left"
                android:textColor="@android:color/black" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@color/clmrs_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="@string/label_place"
                android:textColor="@color/clmrs_tv_grey" />

            <TextView
                android:id="@+id/tv_place_name"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/border_grey_bg"
                android:inputType="textPersonName"
                android:paddingLeft="10dp"
                android:text="NA"
                android:gravity="center|left"
                android:textColor="@android:color/black" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ageLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@color/clmrs_bg"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title_age"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_subdistrict"
                android:textColor="@color/clmrs_tv_grey" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:padding="1dp"
                android:layout_height="42dp">

                <Spinner
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:id="@+id/spinner_subdistrict"
                    android:layout_weight="1" />

            </RelativeLayout>

        </LinearLayout>


    </LinearLayout>


    <Button
        android:id="@+id/updateSubdistrict"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_gravity="center"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/btn_bg_add_child"
        android:gravity="center"
        android:text="@string/update"
        android:textAllCaps="true"
        android:textColor="@color/ofis_base_font_white"
        android:textSize="20dp"
        android:textStyle="bold" />

</RelativeLayout>