<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_buying_agent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ofis_page_background"
    android:focusableInTouchMode="true"
    tools:context="com.webpoint0.ofiscompanion.BuyingAgent"
    tools:ignore="Overdraw">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:id="@+id/topSectionBackground"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:contentDescription="@string/cd_topSectionColour" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="@dimen/ofis_bottom_section_padding_horizontal"
        android:paddingRight="@dimen/ofis_bottom_section_padding_horizontal"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:layout_below="@+id/topSectionBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/mainLayout"
            android:orientation="vertical"
            android:paddingLeft="@dimen/ofis_large_pad"
            android:paddingRight="@dimen/ofis_large_pad"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:background="@drawable/border_white_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ofis_base_font_dark"
                android:text="@string/WhoTransacting"
                android:textSize="@dimen/ofis_small_text"
                android:paddingLeft="@dimen/ofis_small_pad"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:id="@+id/spinner_buyingagents"
                android:hint="@string/please_select"
                android:layout_weight="1"
                android:nextFocusDown="@+id/spinner_item_type"
                android:layout_marginBottom="@dimen/activity_vertical_margin"/>

        </LinearLayout>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="@dimen/text_button_width_height"
            android:text="@string/ModuleNextButton"
            android:textAllCaps="true"
            android:background="@color/ofis_action_button_background"
            android:textColor="@color/ofis_base_font_white"
            android:textSize="@dimen/ofis_micro_text"
            android:paddingLeft="@dimen/ofis_med_pad"
            android:paddingRight="@dimen/ofis_med_pad"
            android:layout_marginTop="@dimen/ofis_med_pad"
            android:id="@+id/buyingAgentNext"
            android:layout_gravity="right"/>

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/topSection"
        android:baselineAligned="false"
        android:paddingBottom="0dp"
        android:layout_margin="0dp"
        android:weightSum="10">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="8"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/activity_vertical_margin">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ChooseBuyingAgent"
                android:id="@+id/buyingAgentTitle"
                android:textColor="@color/ofis_base_font_white"
                android:paddingRight="0dp"
                android:paddingLeft="5dp"
                android:textSize="@dimen/ofis_large_text"
                android:maxLines="1" />


        </LinearLayout>



    </LinearLayout>

</RelativeLayout>
