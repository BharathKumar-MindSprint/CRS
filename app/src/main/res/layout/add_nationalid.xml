<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="13">



    <LinearLayout
        android:id="@+id/ll_nidview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="11.5"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="10.8"
            android:orientation="horizontal"
            android:gravity="center">



            <LinearLayout
                android:id="@+id/ll_capturephoto"
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <LinearLayout

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/nationalidphoto"
                        android:layout_width="74dp"
                        android:tooltipText="@string/captureid"
                        android:background="@drawable/ic_capture_id_defaulr"
                        android:layout_height="94dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="bottom|end">
                        <ImageButton
                            android:layout_width="@dimen/button_width_height"
                            android:layout_height="@dimen/button_width_height"
                            android:id="@+id/nidphotoActionButton"
                            android:contentDescription="@string/Camera"
                            android:src="@drawable/ic_actionbutton_camera"
                            android:layout_marginLeft="5dp"
                            android:adjustViewBounds="false"
                            android:background="@android:color/transparent"
                            android:scaleType="fitXY" />
                    </LinearLayout>
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                >


                <Spinner
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/idtypespinner"
                    android:hint="@string/idtype"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/ofis_input_field_bottom_margin"
                    android:nextFocusDown="@+id/spinner_region" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:id="@+id/nidnumber"
                    android:textSize="@dimen/ofis_input_field_text"
                    android:digits="abcdefghijklmnopqrstuvwxyz1234567890 "
                    android:hint="@string/nationalidno"
                    android:layout_margin="@dimen/ofis_input_field_bottom_margin"/>

            </LinearLayout>


        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/deleteNationalid"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:gravity="bottom|end">
    <ImageView
        android:gravity="bottom|end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:layout_marginBottom="2dp"
        android:src="@drawable/ic_delete_item"
        android:contentDescription="@string/Delete_Item" />
    </LinearLayout>
</LinearLayout>