<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.olam.digital.ofis.TrainingRecordConfirmation">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:id="@+id/topSectionBackground"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:contentDescription="@string/cd_topSectionColour" />

    <!-- bottom section -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/ofis_bottom_section_padding_horizontal"
        android:layout_below="@+id/topSectionBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/ofis_med_pad"
            android:background="@drawable/border_white_background"
            android:weightSum="8"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="3.97"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_course"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/ofis_small_pad"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/courseName"
                    android:text="@string/select_course"
                    android:layout_marginBottom="@dimen/ofis_large_pad"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_training_module"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/ofis_small_pad"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_training_module"
                    android:id="@+id/trainingModuleName" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="4.03">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="100dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:id="@+id/trainingPhoto"
                    app:srcCompat="@android:drawable/ic_menu_gallery"
                    android:background="@drawable/border"
                    android:contentDescription="@string/Training_Photo"/>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/ofis_bottom_section_padding_horizontal"
            android:background="@drawable/border_white_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/ofis_med_pad"
                android:weightSum="8"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="5"
                    android:layout_height="wrap_content"
                    android:id="@+id/transactionItemsHeader"
                    android:text="@string/TrainingAttendees"
                    android:textAllCaps="true"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="end"
                    android:id="@+id/trainingAttendeesTotal"
                    android:text="0"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <ListView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/list"
                android:divider="@color/ofis_input_field_separator"
                android:listSelector="@android:color/transparent"
                android:dividerHeight="@dimen/ofis_list_itemborder" />

        </LinearLayout>

    </LinearLayout>

    <!-- top section -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/topSection"
        android:baselineAligned="false"
        android:paddingBottom="0dp"
        android:layout_margin="0dp"
        android:weightSum="10">

        <!-- page title -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="8"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/activity_vertical_margin">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/TrainingRecordConfirmationTitle"
                android:id="@+id/TrainingRecordConfirmationTitle"
                android:textColor="@color/ofis_base_font_white"
                android:paddingRight="0dp"
                android:paddingLeft="5dp"
                android:textSize="@dimen/ofis_large_text"
                android:maxLines="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/TrainingRecordConfirmationSubTitle"
                android:id="@+id/TrainingRecordConfirmationSubTitle"
                android:textColor="@color/ofis_base_font_white"
                android:paddingRight="0dp"
                android:paddingLeft="5dp"
                android:textSize="@dimen/ofis_small_text"
                tools:ignore="RtlHardcoded"
                android:maxLines="1" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
