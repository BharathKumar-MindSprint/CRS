<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_marginStart="@dimen/margin_16"
        android:layout_marginEnd="@dimen/margin_16"
        android:paddingTop="@dimen/ofis_list_itemseparator"
        android:weightSum="2"
        android:paddingRight="@dimen/ofis_large_pad"
        android:paddingBottom="@dimen/ofis_list_itemseparator"
        android:layout_width="match_parent"
        android:background="@drawable/list_item"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAvatar"
            android:layout_width="@dimen/width_48"
            android:layout_height="@dimen/height_50"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"
            android:src="@drawable/image_circle_red"
            android:contentDescription="@string/app_name"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.9">

            <TextView
                android:id="@+id/txtName"
                tools:text="Respondent Name"
                android:textSize="16sp"
                android:textStyle="bold"
                style="@style/semibold_dark_gray_medium_tv"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtPhone"
                tools:text="+91 9876543210"
                android:layout_marginTop="@dimen/margin_6"
                style="@style/medium_black_medium_tv"
                android:textColor="#666666"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/left_border"
            android:layout_weight=".1"
            android:gravity="end">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="false"
                android:padding="@dimen/ofis_large_pad"
                android:maxHeight="@dimen/text_button_width_height"
                android:scaleType="center"
                android:id="@+id/imageView_pic"
                app:srcCompat="@drawable/ic_upload_list"
                android:contentDescription="@string/Farmer_Photo"
                android:layout_gravity="center_vertical|center_horizontal" />
        </LinearLayout>

    </LinearLayout>
</layout>