<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".downloadsurvey.polygondatadownload.PolygonFarmer"
    android:background="@color/ofis_page_background"
    android:focusableInTouchMode="true"
    tools:ignore="Overdraw">


    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/topSection"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/search_farmer"
                android:id="@+id/textview_StartA"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_large_text"
                android:layout_weight="1"
                android:layout_centerInParent="true"
                android:layout_alignParentLeft="true"/>

            <TextView
                android:id="@+id/selected_plot_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/selected_plot"
                android:layout_marginEnd="@dimen/record_status_right_magrin"
                android:textColor="@color/ofis_base_font_white"
                android:textSize="@dimen/ofis_med_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_weight="4"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/findFarmerSearchBoxPolygon"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/edittext_bg_dark"
                    android:drawableRight="@drawable/ic_searchimg"
                    android:drawablePadding="@dimen/margin_10"
                    android:hint="@string/farmer_search_hint"
                    android:inputType="textCapWords"
                    android:padding="@dimen/margin_10"
                    android:textColor="@color/ofis_base_font_dark"
                    android:textColorHint="@color/icon_grey_palette_2"
                    android:textSize="@dimen/ofis_input_field_text" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/bottomSection"
        android:layout_below="@+id/topSection"
        android:layout_above="@+id/last_section">

        <androidx.recyclerview.widget.RecyclerView

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/listFarmer"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"/>

        <TextView
            android:id="@+id/noFarmerFound"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/farmer_not_found"
            android:textStyle="bold"
            android:textColor="@color/btn_primary_disabled"
            android:textSize="@dimen/ofis_xlarge_pad"
            android:gravity="center"
            android:visibility="gone"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/last_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_alignParentBottom="true" >
        <LinearLayout
            android:id="@+id/downloadDataPolygon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rounded_corner_button"
            android:layout_margin="@dimen/margin_10"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="@dimen/margin_10"
                android:gravity="center">
                <TextView
                    android:id="@+id/downloadDataPolygonText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download_survey_data"
                    android:textSize="@dimen/ofis_micro_text"
                    android:textColor="@color/ofis_base_font_white" />
                <ImageView
                    android:id="@+id/downloadIcon"
                    android:layout_width="wrap_content"
                    android:paddingStart="@dimen/margin_10"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/download_icon"
                    android:layout_gravity="center_vertical" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


</RelativeLayout>