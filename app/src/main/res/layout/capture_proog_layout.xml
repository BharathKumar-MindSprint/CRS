<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_complaint_captureproof_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/table_width60"
    android:layout_margin="@dimen/margin_10"
    android:background="@drawable/dm_captureproof_bg"
    android:gravity="center">


    <TextView
        android:id="@+id/tv_cpature_txt"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:text="Capture Proof"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/ofis_med_text"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_centerVertical="true"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_toRightOf="@+id/tv_cpature_txt"
        android:backgroundTint="@color/colorPrimary"
        android:src="@drawable/ic_survey"
        android:visibility="gone"/>

</RelativeLayout>
