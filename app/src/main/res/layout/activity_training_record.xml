<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:background="@color/ofis_page_background"
    tools:context=".TrainingRecord">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:id="@+id/topSectionBackground"
        android:background="@color/ofis_farmer_screen_actions_background"
        android:contentDescription="@string/cd_topSectionColour" />


    <!-- bottom section -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/trainingRecordData"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingBottom="@dimen/ofis_small_pad"
        android:paddingLeft="@dimen/ofis_bottom_section_padding_horizontal"
        android:paddingRight="@dimen/ofis_bottom_section_padding_horizontal"
        android:layout_below="@+id/topSectionBackground">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/ofis_med_pad"
            android:paddingRight="@dimen/ofis_med_pad"
            android:paddingBottom="@dimen/ofis_med_pad"
            android:paddingTop="@dimen/ofis_med_pad"
            android:background="@drawable/border_white_background"
            android:weightSum="8"
            android:baselineAligned="false">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_weight="3.97">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ofis_base_font_dark"
                    android:text="@string/select_course"
                    android:textSize="@dimen/ofis_small_text"
                    android:paddingLeft="@dimen/ofis_small_pad"
                    android:textStyle="bold"
                    android:textAllCaps="true"/>

                <Spinner
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/spinner_course"
                    android:hint="@string/please_select"
                    android:nextFocusDown="@+id/spinner_training_module" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ofis_base_font_dark"
                    android:text="@string/select_training_module"
                    android:textSize="@dimen/ofis_small_text"
                    android:paddingLeft="@dimen/ofis_small_pad"
                    android:textStyle="bold"
                    android:textAllCaps="true"/>

                <Spinner
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/spinner_training_module"
                    android:hint="@string/please_select" />

            </LinearLayout>

            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/wrapper_trainingPhoto"
                android:paddingLeft="@dimen/ofis_med_pad"
                android:layout_weight="4.03">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="100dp"
                    android:id="@+id/trainingPhoto"
                    android:contentDescription="@string/Farmer_Photo"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:background="@drawable/border"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:layout_width="@dimen/standard_button_width_height"
                    android:layout_height="@dimen/standard_button_width_height"
                    android:id="@+id/trainingPhotoActionButton"
                    android:contentDescription="@string/Camera"
                    android:src="@drawable/ic_actionbutton_camera"
                    android:adjustViewBounds="false"
                    android:background="@android:color/transparent"
                    android:scaleType="fitStart"
                    android:layout_below="@+id/trainingPhoto"
                    android:layout_alignRight="@+id/trainingPhoto"
                    android:layout_marginTop="-22dp"/>
            </RelativeLayout>

        </LinearLayout>



    </LinearLayout>

    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/trainingAttendeesHeader"
        android:layout_marginBottom="@dimen/home_activity_vertical_margin"
        android:layout_marginLeft="@dimen/ofis_small_pad"
        android:layout_marginRight="@dimen/ofis_small_pad"
        android:layout_below="@+id/trainingRecordData"
        card_view:cardBackgroundColor="@color/ofis_actionbar_background"
        card_view:cardElevation="1dp"
        card_view:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/ofis_bottom_section_padding_horizontal"
            android:paddingBottom="@dimen/ofis_bottom_section_padding_horizontal"
            android:weightSum="7">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7"
                android:text="@string/TrainingAttendees"
                android:id="@+id/AddTrainingAttendeesTitle"
                android:textColor="@color/ofis_base_font_dark"
                android:paddingLeft="@dimen/ofis_med_pad"
                android:gravity="center_vertical"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="@dimen/ofis_small_text"
                android:maxLines="1" />

            <ImageButton
                android:layout_width="@dimen/standard_button_width_height"
                android:layout_height="@dimen/standard_button_width_height"
                android:id="@+id/addTrainingAttendees"
                android:src="@drawable/ic_ofis_add"
                android:scaleType="fitXY"
                android:background="@android:color/transparent"
                android:layout_marginRight="@dimen/ofis_bottom_section_padding_horizontal"
                android:contentDescription="@string/Add"
                />

        </LinearLayout>
    </android.support.v7.widget.CardView>

    <ListView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@android:id/list"
        android:divider="@android:color/transparent"
        android:layout_below="@+id/trainingAttendeesHeader"
        android:layout_above="@+id/buttonContainer"
        android:paddingBottom="@dimen/ofis_list_itemseparator"
        android:dividerHeight="0dp" />

    <!-- base button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/buttonContainer"
        android:layout_alignParentBottom="true"
        android:paddingBottom="@dimen/ofis_list_itemseparator"
        android:paddingRight="@dimen/ofis_bottom_section_padding_horizontal"
        android:paddingLeft="@dimen/ofis_bottom_section_padding_horizontal">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="@dimen/text_button_width_height"
            android:text="@string/add_attendee_scores"
            android:textAllCaps="true"
            android:background="@color/ofis_action_button_background"
            android:textColor="@color/ofis_base_font_white"
            android:paddingLeft="@dimen/ofis_med_pad"
            android:paddingRight="@dimen/ofis_med_pad"
            android:textSize="@dimen/ofis_micro_text"
            android:id="@+id/addAttendeeScores"
            android:layout_alignParentLeft="true"/>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="@dimen/text_button_width_height"
            android:text="@string/complete_record"
            android:textAllCaps="true"
            android:background="@color/ofis_action_button_background"
            android:textColor="@color/ofis_base_font_white"
            android:paddingLeft="@dimen/ofis_med_pad"
            android:paddingRight="@dimen/ofis_med_pad"
            android:textSize="@dimen/ofis_micro_text"
            android:id="@+id/completeTrainingRecord"
            android:layout_alignParentRight="true"
            tools:ignore="RelativeOverlap" />

    </RelativeLayout>

    <!-- top section -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/topSection"
        android:baselineAligned="false"
        android:paddingBottom="0dp"
        android:layout_margin="0dp"
        android:weightSum="10">

        <!-- page title -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="8"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/activity_vertical_margin">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/TrainingRecordTitle"
                android:id="@+id/ViewTrainingRecordTitle"
                android:textColor="@color/ofis_base_font_white"
                android:paddingRight="0dp"
                android:paddingLeft="5dp"
                android:textSize="@dimen/ofis_large_text"
                android:maxLines="1" />

        </LinearLayout>
        <!-- end module and submodule title -->
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:layout_weight="2"
            android:paddingTop="25dp"
            android:paddingLeft="0dp"
            android:paddingRight="10dp">

            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/saveTrainingRecord"
                android:src="@drawable/ic_actionbutton_save"
                android:scaleType="center"
                android:background="@android:color/transparent"
                android:contentDescription="@string/Save"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                />

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
