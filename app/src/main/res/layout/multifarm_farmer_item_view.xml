<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:id="@+id/itemCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/ofis_list_itemseparator"
    android:paddingBottom="@dimen/ofis_list_itemseparator">


    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:id="@+id/rowlin"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="@drawable/list_item"
        android:baselineAligned="false"
        android:weightSum="12"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:id="@+id/farmerListIcon"
                app:srcCompat="@drawable/ic_status_no_photo"
                android:contentDescription="@string/Farmer_Photo"
                android:layout_gravity="center_vertical"
                android:maxHeight="60dp" />
        </LinearLayout>


        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:id="@+id/itemTextContainer"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/right_border"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_weight="10">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/farmerNameTV"
                android:textColor="@color/ofis_text_field"
                android:textStyle="bold"
                android:textSize="@dimen/ofis_med_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/farmerIdTV"
                android:textColor="@color/ofis_list_item_subtitle"
                android:textSize="@dimen/ofis_small_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/farmerlead_phonenumber"
                android:id="@+id/phoneno"
                android:visibility="gone"
                android:textColor="@color/ofis_list_item_subtitle"
                android:textSize="@dimen/ofis_small_text" />
        </LinearLayout>


    </LinearLayout>

</androidx.cardview.widget.CardView>


