<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/ofis_page_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".farmplandownload.DownloadFarmPlanActivity"
    android:id="@+id/layout_download_farm_plan"
    tools:ignore="Overdraw">


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFarmPlanList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"/>
    <TextView
        android:id="@+id/tv_down"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@+id/rvFarmPlanList"
        android:text="Download"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:gravity="center"
        android:visibility="gone"
        />

</RelativeLayout>