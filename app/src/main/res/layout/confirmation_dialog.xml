<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/background_rounded_corner">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/edur_survey_remainder"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/ofis_large_pad"
        android:textColor="@color/header_color"
        android:visibility="gone"
        />

    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirmation_message"
        android:layout_gravity="center"
        android:textColor="@color/light_grey"
        android:textSize="16sp" />

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/button_no"
            style="?android:attr/negativeButtonText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_white_rounded_corner"
            android:text="@string/no"
            android:layout_weight="1"
            android:textColor="@color/ofis_action_button_background"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/button_yes"
            style="?android:attr/positiveButtonText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_primary_rounded_corner"
            android:text="@string/yes"
            android:textColor="@color/ofis_base_font_white"/>
    </LinearLayout>

</LinearLayout>