<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="15dp"
    android:paddingRight="15dp"
    android:paddingTop="@dimen/ofis_list_itemseparator"
    android:paddingBottom="@dimen/ofis_list_itemseparator">


    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:id="@+id/rowlinPolygon"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="@drawable/list_item"
        android:weightSum="7"
        android:baselineAligned="false"
        tools:ignore="UselessParent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/itemTextContainer"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/right_border"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_weight="1">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Farmer_Name"
                android:id="@+id/farmerName"
                android:textColor="@color/ofis_base_font_dark"
                android:textSize="@dimen/ofis_med_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Awaiting_Sync"
                android:layout_marginTop="@dimen/ofis_med_pad"
                android:id="@+id/olamFarmerId"
                android:textColor="@color/ofis_list_item_subtitle"
                android:textSize="@dimen/ofis_small_text" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_weight="6"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:id="@+id/farmerListIcon"
                app:srcCompat="@drawable/empty_farmer_icon"
                android:background="@android:color/transparent"
                android:contentDescription="@string/Farmer_Photo"
                android:layout_gravity="center"
                android:maxHeight="60dp"
                tools:ignore="VectorDrawableCompat" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>


